    "translations": {
      "ar": {
        "p154.text": "أورا",
        "p155.text": "X1",
        "p157.text": "دعوة إطلاق",
        "p158.text": "عهد جديد\nيبدأ.",
        "p159.text": "في ليلة الإطلاق التي نعرّف فيها بـ«أورا X1» على المسرح لأول مرة،\nنتمنى أن نراكم بيننا.",
        "p1512.text": "الاستقبال\nوالتسجيل",
        "p1515.text": "عرض\nالمنتج",
        "p1518.text": "منطقة التجربة\nوالكوكتيل",
        "p1520.text": "14 أكتوبر 2027، الخميس · 6:30 مساءً",
        "p1522.text": "استوديو مركز الفنون · حي الشاطئ، جدة",
        "p1523.text": "تأكيد الحضور: lansman@aura.com.tr · 0212 900 12 12"
      },
      "de": {
        "p154.text": "AURA",
        "p155.text": "X1",
        "p157.text": "LAUNCH-EINLADUNG",
        "p158.text": "Eine neue Ära\nbeginnt.",
        "p159.text": "Bei unserem Launch-Abend, an dem wir AURA X1 erstmals auf der Bühne vorstellen,\nmöchten wir Sie in unserer Mitte sehen.",
        "p1512.text": "Empfang\nund Anmeldung",
        "p1515.text": "Produkt-\npräsentation",
        "p1518.text": "Erlebnisbereich\nund Cocktail",
        "p1520.bind": "{day}. {month} {year}, {weekday} · {time}",
        "p1520.text": "14. Oktober 2027, Donnerstag · 18:30",
        "p1522.text": "Zorlu PSM Studio · Besiktas, Istanbul",
        "p1523.text": "Zusage: lansman@aura.com.tr · 0212 900 12 12"
      },
      "el": {
        "p154.text": "AURA",
        "p155.text": "X1",
        "p157.text": "ΠΡΟΣΚΛΗΣΗ ΛΑΝΣΑΡΙΣΜΑΤΟΣ",
        "p158.text": "Μια νέα εποχή\nξεκινά.",
        "p159.text": "Θα θέλαμε να σας δούμε ανάμεσά μας\nστη βραδιά της παρουσίασης του AURA X1 για πρώτη φορά στη σκηνή.",
        "p1512.text": "Υποδοχή\nκαι εγγραφή",
        "p1515.text": "Παρουσίαση\nπροϊόντος",
        "p1518.text": "Χώρος εμπειρίας\nκαι κοκτέιλ",
        "p1520.text": "14 Οκτωβρίου 2027, Πέμπτη · 18:30",
        "p1522.text": "Κέντρο Τεχνών Studio · Μαρούσι, Αθήνα",
        "p1523.text": "Επιβεβαίωση παρουσίας: lansman@aura.com.tr · 0212 900 12 12"
      },
      "en": {

    "translations": {
      "ar": {
        "p124.bind": "{first} · 8 سنوات",
        "p124.text": "لينا تبلغ 8 سنوات",
        "p125.text": "الأميرة",
        "p126.text": "حفل الشاي",
        "p1210.text": "نرتدي تيجاننا ونرفع فناجيننا\nفي هذا اليوم الخيالي،\nونريدك معنا!",
        "p1211.text": "11 يوليو 2027 · الأحد",
        "p1212.bind": "الساعة {time}",
        "p1212.text": "الساعة 3:00 عصراً",
        "p1213.text": "حديقة الملكة للشاي",
        "p1214.text": "حي الواحة، جدة",
        "p1215.text": "لا تنسوا ارتداء زيّ الأميرة؛\nوأجمل تاج سيفوز بهدية مفاجأة!",
        "p1216.text": "تأكيد الحضور · الأم بسمة · 0532 851 64 30"
      },
      "de": {
        "p124.bind": "{first} IST 8",
        "p124.text": "LINA WIRD 8",
        "p125.text": "Prinzessinnen",
        "p126.text": "Teeparty",
        "p1210.text": "An diesem märchenhaften Tag, an dem wir\nKronen aufsetzen und die Tassen erheben,\nsei bei uns!",
        "p1211.bind": "{day}. {month} {year} · {weekday}",
        "p1211.text": "11. Juli 2027 · Sonntag",
        "p1212.bind": "{time} UHR",
        "p1212.text": "15:00 UHR",
        "p1213.text": "Teegarten Königin",
        "p1214.text": "Winterhude, Hamburg",
        "p1215.text": "Vergiss nicht, dein Prinzessinnenkleid anzuziehen;\ndie schönste Krone gewinnt ein Überraschungsgeschenk!",
        "p1216.text": "RSVP · Mutter Hande · 0532 851 64 30"
      },
      "el": {
        "p124.bind": "{first} · 8 ΕΤΩΝ",
        "p124.text": "Η ΛΙΝΑ ΓΙΝΕΤΑΙ 8",
        "p125.text": "Πριγκιπικό",
        "p126.text": "Πάρτι τσαγιού",
        "p1210.text": "Βάλε το στέμμα σου και σήκωσε το φλιτζάνι σου\nσε αυτή την παραμυθένια μέρα·\nέλα να είσαι μαζί μας!",
        "p1211.text": "11 Ιουλίου 2027 · Κυριακή",
        "p1212.bind": "ΩΡΑ {time}",
        "p1212.text": "ΩΡΑ 15:00",
        "p1213.text": "Κήπος Βασίλισσας",
        "p1214.text": "Καλαμάκι, Αθήνα",
        "p1215.text": "Μην ξεχάσεις να φορέσεις τη στολή της πριγκίπισσας·\nτο πιο όμορφο στέμμα θα κερδίσει ένα δώρο έκπληξη!",
        "p1216.text": "RSVP · Μαμά Χαρά · 0532 851 64 30"
      },
      "en": {
        "p124.bind": "{first} IS 8 YEARS OLD",
        "p124.text": "LILY IS 8 YEARS OLD",
        "p125.text": "Princess",
        "p126.text": "Tea Party",
        "p1210.text": "Wearing our crowns and raising our teacups\non this fairy-tale day,\njoin us too!",
        "p1211.text": "July 11, 2027 · Sunday",
        "p1212.bind": "AT {time}",
        "p1212.text": "AT 3:00 PM",
        "p1213.text": "Queen's Tea Garden",
        "p1214.text": "Greenpoint, Brooklyn",
        "p1215.text": "Don't forget to wear your princess outfit;\nthe prettiest crown wins a surprise gift!",
        "p1216.text": "RSVP · Mother Hande · 0532 851 64 30"
      },
      "es": {
        "p124.bind": "{first} CUMPLE 8 AÑOS",
        "p124.text": "LINA CUMPLE 8 AÑOS",
        "p125.text": "Princesa",
        "p126.text": "Fiesta del té",
        "p1210.text": "Con la corona puesta y las tazas en alto,\nen este día de cuento de hadas,\n¡acompáñanos!",
        "p1211.bind": "{day} de {month} de {year} · {weekday}",
        "p1211.text": "11 de julio de 2027 · domingo",
        "p1212.bind": "A LAS {time}",
        "p1212.text": "A LAS 15:00",
        "p1213.text": "Salón de té La Reina",
        "p1214.text": "Sant Martí, Barcelona",
        "p1215.text": "No olvides ponerte tu vestido de princesa;\n¡la corona más bonita ganará un regalo sorpresa!",
        "p1216.text": "RSVP · Su madre, Hande · 0532 851 64 30"
      },
      "fr": {
        "p124.bind": "{first} A 8 ANS",
        "p124.text": "LINA A 8 ANS",
        "p125.text": "Princesse",
        "p126.text": "Tea party",
        "p1210.text": "Couronnes sur la tête, tasses levées,\nvenez vivre avec nous\ncette journée de conte de fées !",
        "p1211.text": "11 juillet 2027 · dimanche",
        "p1212.bind": "À {time}",
        "p1212.text": "À 15 H 00",
        "p1213.text": "Salon de Thé La Reine",
        "p1214.text": "Vincennes, Paris",
        "p1215.text": "N’oubliez pas votre tenue de princesse ;\nla plus belle couronne gagnera un cadeau surprise !",
        "p1216.text": "RSVP · Maman Hande · 0532 851 64 30"
      },
      "it": {
        "p124.bind": "{first} HA 8 ANNI",
        "p124.text": "GIADA HA 8 ANNI",
        "p125.text": "Principessa",
        "p126.text": "Festa del tè",
        "p1210.text": "In questo giorno da favola\nin cui indosseremo le corone e alzeremo le tazze,\nsii dei nostri!",
        "p1211.text": "11 luglio 2027 · domenica",
        "p1212.bind": "ORE {time}",
        "p1212.text": "ORE 15.00",
        "p1213.text": "Giardino del Tè La Regina",
        "p1214.text": "Città Studi, Milano",
        "p1215.text": "Non dimenticare il tuo vestito da principessa:\nla corona più bella vincerà un regalo a sorpresa!",
        "p1216.text": "RSVP · Mamma Hande · 0532 851 64 30"
      },
      "pt": {
        "p124.bind": "{first} FAZ 8 ANOS",
        "p124.text": "A LINA FAZ 8 ANOS",
        "p125.text": "Princesa",
        "p126.text": "Festa do Chá",
        "p1210.text": "Com as nossas coroas postas e as chávenas\nerguidas neste dia de conto de fadas,\nvem estar connosco!",
        "p1211.bind": "{day} de {month} de {year} · {weekday}",
        "p1211.text": "11 de julho de 2027 · domingo",
        "p1212.bind": "ÀS {time}",
        "p1212.text": "ÀS 15H00",
        "p1213.text": "Salão de Chá da Rainha",
        "p1214.text": "Estrela, Lisboa",
        "p1215.text": "Não te esqueças de vestir o teu traje de princesa;\na coroa mais bonita ganha um presente-surpresa!",
        "p1216.text": "RSVP · Mãe Helena · 0532 851 64 30"
      },
      "ru": {
        "p124.bind": "{first}: 8 ЛЕТ",
        "p124.text": "МАЙЕ 8 ЛЕТ",
        "p125.text": "Принцесса",
        "p126.text": "Чаепитие",
        "p1210.text": "В этот сказочный день, когда мы наденем короны\nи поднимем наши чашки,\nпобудьте с нами!",
        "p1211.text": "11 июля 2027 · воскресенье",
        "p1212.bind": "В {time}",
        "p1212.text": "В 15:00",
        "p1213.text": "Чайный сад «Королева»",
        "p1214.text": "Измайлово, Москва",
        "p1215.text": "Не забудьте надеть наряд принцессы;\nсамая красивая корона получит подарок-сюрприз!",
        "p1216.text": "RSVP · мама Ханде · 0532 851 64 30"
      }
    },

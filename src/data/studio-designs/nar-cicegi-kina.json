    "translations": {
      "ar": {
        "h093.text": "ليلة الحناء",
        "h094.text": "مميز",
        "h097.text": "يوليو 2027",
        "h098.text": "الخميس",
        "h0910.text": "أنتم مدعوون",
        "h0911.text": "هالة",
        "h0912.text": "في ليلة ابنتنا جنى الأخيرة\nفي بيت أبيها، لنزيّن يديها\nبالحناء معاً؛ وشاركونا\nهذه الفرحة.",
        "h0914.text": "الساعة",
        "h0916.text": "المكان",
        "h0917.text": "فيلا الحديقة",
        "h0918.text": "ناعور، عمّان",
        "h0919.text": "تأكيد الحضور",
        "h0920.text": "هالة الحدّاد · 0533 591 06 37"
      },
      "de": {
        "h093.text": "Henna",
        "h094.text": "ABEND",
        "h097.text": "JULI 2027",
        "h098.text": "DONNERSTAG",
        "h0910.text": "SIE SIND EINGELADEN",
        "h0911.text": "Julia",
        "h0912.text": "Lassen Sie uns in der letzten Nacht unserer\nTochter Ceren im Elternhaus ihr Henna\ngemeinsam feiern; teilen Sie\nunsere Freude.",
        "h0914.text": "UHRZEIT",
        "h0916.text": "ORT",
        "h0917.text": "Gartenvilla",
        "h0918.text": "Starnberg, Bayern",
        "h0919.text": "RSVP",
        "h0920.text": "Gabi Schneider · 0533 591 06 37"
      },
      "el": {
        "h093.text": "Χέννα",
        "h094.text": "ΒΡΑΔΙΑ",
        "h097.text": "ΙΟΥΛΙΟΣ 2027",
        "h098.text": "ΠΕΜΠΤΗ",
        "h0910.text": "ΣΑΣ ΠΡΟΣΚΑΛΟΥΜΕ",
        "h0911.text": "Χριστίνα",
        "h0912.text": "Ας βάψουμε μαζί τη χέννα της κόρης μας Χλόης\nτην τελευταία της βραδιά\nστο πατρικό της· μοιραστείτε\nκαι εσείς τη χαρά μας.",
        "h0914.text": "ΩΡΑ",
        "h0916.text": "ΧΩΡΟΣ",
        "h0917.text": "Βίλα με Κήπο",
        "h0918.text": "Τύρναβος, Λάρισα",
        "h0919.text": "RSVP",
        "h0920.text": "Γιάννα Νίκου · 0533 591 06 37"
      },
      "en": {
        "h093.text": "Henna",
        "h094.text": "NIGHT",
        "h097.text": "JULY 2027",
        "h098.text": "THURSDAY",
        "h0910.text": "YOU'RE INVITED",
        "h0911.text": "Claire",
        "h0912.text": "On our daughter Ceren's last night\nin her father's house, let's apply\nher henna together; share\nin this joy with us.",
        "h0914.text": "TIME",
        "h0916.text": "VENUE",
        "h0917.text": "Garden Pavilion",
        "h0918.text": "Reston, Virginia",
        "h0919.text": "RSVP",
        "h0920.text": "Gwen Smith · 0533 591 06 37"
      },
      "es": {
        "h093.text": "Noche de henna",
        "h094.text": "VELADA",
        "h097.bind": "{month} de {year}",
        "h097.text": "JULIO DE 2027",
        "h098.text": "JUEVES",
        "h0910.text": "TE INVITAMOS",
        "h0911.text": "Carmen",
        "h0912.text": "En la última noche de nuestra hija Ceren\nen casa de su padre, pongamos juntos\nsu henna; comparte\ntambién esta alegría.",
        "h0914.text": "HORA",
        "h0916.text": "LUGAR",
        "h0917.text": "Pabellón del Jardín",
        "h0918.text": "Pozuelo de Alarcón, Madrid",
        "h0919.text": "RSVP",
        "h0920.text": "Gloria Herrero · 0533 591 06 37"
      },
      "fr": {
        "h093.text": "Henné",
        "h094.text": "SOIRÉE",
        "h097.text": "JUILLET 2027",
        "h098.text": "JEUDI",
        "h0910.text": "VOUS ÊTES INVITÉS",
        "h0911.text": "Chloé",
        "h0912.text": "Pour la dernière nuit de notre fille Ceren\nsous le toit paternel, posons ensemble\nson henné ; partagez, vous aussi,\ncette joie.",
        "h0914.text": "HEURE",
        "h0916.text": "LIEU",
        "h0917.text": "Kiosque du Jardin",
        "h0918.text": "Écully, Lyon",
        "h0919.text": "RSVP",
        "h0920.text": "Gisèle Durand · 0533 591 06 37"
      },
      "it": {
        "h093.text": "Henné",
        "h094.text": "SERATA",
        "h097.text": "LUGLIO 2027",
        "h098.text": "GIOVEDÌ",
        "h0910.text": "TI INVITIAMO",
        "h0911.text": "Martina",
        "h0912.text": "Nell'ultima notte di nostra figlia Ceren\nnella casa paterna, applichiamo insieme\nl'henné: unisciti\nanche tu a questa gioia.",
        "h0914.text": "ORA",
        "h0916.text": "LUOGO",
        "h0917.text": "Villino Verde",
        "h0918.text": "Castel Gandolfo, Roma",
        "h0919.text": "RSVP",
        "h0920.text": "Gloria Ferrari · 0533 591 06 37"
      },
      "pt": {
        "h093.text": "Hena",
        "h094.text": "NOITE",
        "h097.bind": "{month} de {year}",
        "h097.text": "JULHO DE 2027",
        "h098.text": "QUINTA-FEIRA",
        "h0910.text": "ESTÃO CONVIDADOS",
        "h0911.text": "Catarina",
        "h0912.text": "Na última noite da nossa filha Catarina\nna casa paterna, celebremos juntos\na sua hena; partilhem\nconnosco esta alegria.",

    "translations": {
      "ar": {
        "h021.bind": "ابنتنا {first}",
        "h021.text": "ابنتنا دلال",
        "h022.text": "ليلة الحناء",
        "h023.text": "مميز",
        "h025.text": "في هذه الليلة المميزة قبل أن تغادر\nبيت أبيها، لنزيّن يديها بالحناء\nمعاً؛ ونتمنى أن نراكم\nبيننا.",
        "h027.text": "التاريخ",
        "h028.text": "23 يوليو 2027",
        "h029.text": "الساعة",
        "h0211.bind": "مساء {weekday}",
        "h0211.text": "مساء الجمعة",
        "h0212.text": "المكان",
        "h0213.text": "قاعة الفناء المعرّش",
        "h0214.text": "حي الأشرفية، بيروت",
        "h0215.text": "تأكيد الحضور · وداد النجمي · 0533 418 27 90",
        "h0217.text": "الحناء منّا،\nوالبهجة منكم."
      },
      "de": {
        "h021.bind": "UNSERE TOCHTER {first}",
        "h021.text": "UNSERE TOCHTER NORA",
        "h022.text": "Henna",
        "h023.text": "Abend",
        "h025.text": "In dieser bedeutungsvollen Nacht, bevor sie das\nElternhaus verlässt, feiern wir ihr Henna\ngemeinsam; wir möchten\nSie in unserer Mitte sehen.",
        "h027.text": "DATUM",
        "h028.bind": "{day}. {month} {year}",
        "h028.text": "23. Juli 2027",
        "h029.text": "UHRZEIT",
        "h0211.bind": "{weekday}abend",
        "h0211.text": "Freitagabend",
        "h0212.text": "ORT",
        "h0213.text": "Eventhaus Laubenhof",
        "h0214.text": "Altstadt, Celle",
        "h0215.text": "RSVP · Sevgül Yildiz · 0533 418 27 90",
        "h0217.text": "Das Henna von uns,\ndie gute Laune von Ihnen."
      },
      "el": {
        "h021.bind": "Η ΚΟΡΗ ΜΑΣ {first}",
        "h021.text": "Η ΚΟΡΗ ΜΑΣ ΝΙΚΗ",
        "h022.text": "Χέννα",
        "h023.text": "βραδιά",
        "h025.text": "Ας βάψουμε μαζί τη χέννα της\nαυτή τη σημαντική βραδιά πριν φύγει από το πατρικό της·\nθα θέλαμε να σας δούμε\nανάμεσά μας.",
        "h027.text": "ΗΜΕΡΟΜΗΝΙΑ",
        "h028.text": "23 Ιουλίου 2027",
        "h029.text": "ΩΡΑ",
        "h0211.bind": "{weekday} βράδυ",
        "h0211.text": "Παρασκευή βράδυ",
        "h0212.text": "ΧΩΡΟΣ",
        "h0213.text": "Αίθουσα Αυλή Κληματαριάς",
        "h0214.text": "Κέντρο, Σέρρες",
        "h0215.text": "RSVP · Σεβαστή Στάμου · 0533 418 27 90",
        "h0217.text": "Η χέννα από εμάς,\nη χαρά από εσάς."
      },
      "en": {
        "h021.bind": "OUR DAUGHTER {first}",
        "h021.text": "OUR DAUGHTER NORA",
        "h022.text": "Henna",
        "h023.text": "night",
        "h025.text": "On this meaningful night before\nshe leaves her father's house, let's\napply her henna together; we'd love\nto have you with us.",
        "h027.text": "DATE",
        "h028.text": "July 23, 2027",
        "h029.text": "TIME",
        "h0211.bind": "{weekday} evening",
        "h0211.text": "Friday evening",
        "h0212.text": "VENUE",
        "h0213.text": "Vine Courtyard Reception Hall",
        "h0214.text": "Southtown, San Antonio",
        "h0215.text": "RSVP · Susan Young · 0533 418 27 90",
        "h0217.text": "The henna's from us,\nthe joy's from you."
      },
      "es": {
        "h021.bind": "NUESTRA HIJA {first}",
        "h021.text": "NUESTRA HIJA NURIA",
        "h022.text": "Noche de henna",
        "h023.text": "noche",
        "h025.text": "En esta noche tan especial, antes de\ndespedirse de la casa de su padre,\ntiñamos juntos su henna;\nqueremos contar contigo.",
        "h027.text": "FECHA",
        "h028.bind": "{day} de {month} de {year}",
        "h028.text": "23 de julio de 2027",
        "h029.text": "HORA",
        "h0211.bind": "{weekday} por la noche",
        "h0211.text": "Viernes por la noche",
        "h0212.text": "LUGAR",
        "h0213.text": "Casa de eventos Patio de la Parra",
        "h0214.text": "Centro, Córdoba",
        "h0215.text": "RSVP · Sevgül Yildiz · 0533 418 27 90",
        "h0217.text": "La henna, de nuestra parte;\nla alegría, de la tuya."
      },
      "fr": {
        "h021.bind": "NOTRE FILLE {first}",
        "h021.text": "NOTRE FILLE NINON",
        "h022.text": "Henné",
        "h023.text": "soirée",
        "h025.text": "En cette soirée si symbolique avant son départ\nde la maison paternelle, posons ensemble\nson henné ; nous aimerions\nvous compter parmi nous.",
        "h027.text": "DATE",
        "h028.text": "23 juillet 2027",
        "h029.text": "HEURE",
        "h0211.bind": "{weekday} soir",
        "h0211.text": "Vendredi soir",
        "h0212.text": "LIEU",
        "h0213.text": "Maison de la Treille",
        "h0214.text": "Intra-muros, Avignon",
        "h0215.text": "RSVP · Sevgül Yildiz · 0533 418 27 90",
        "h0217.text": "Le henné de notre part,\nla joie de la vôtre."
      },
      "it": {
        "h021.bind": "NOSTRA FIGLIA {first}",
        "h021.text": "NOSTRA FIGLIA ELISA",
        "h022.text": "Henné",
        "h023.text": "serata",
        "h025.text": "In questa serata speciale prima di lasciare\nla casa paterna, applichiamo insieme\nl'henné: vorremmo averti\ncon noi.",
        "h027.text": "DATA",
        "h028.text": "23 luglio 2027",
        "h029.text": "ORA",
        "h0211.bind": "{weekday} sera",
        "h0211.text": "Venerdì sera",
        "h0212.text": "LUOGO",
        "h0213.text": "Corte della Pergola",
        "h0214.text": "La Kalsa, Palermo",
        "h0215.text": "RSVP · Sevgül Yildiz · 0533 418 27 90",
        "h0217.text": "L'henné lo offriamo noi,\nl'allegria la porti tu."
      },
      "pt": {
        "h021.bind": "A NOSSA FILHA {first}",
        "h021.text": "A NOSSA FILHA NATÁLIA",
        "h022.text": "Hena",
        "h023.text": "noite",
        "h025.text": "Nesta noite tão significativa, antes de ela\ndeixar a casa do pai, celebremos juntos\na sua hena; gostaríamos\nde vos ter connosco.",
        "h027.text": "DATA",
        "h028.bind": "{day} de {month} de {year}",
        "h028.text": "23 de julho de 2027",
        "h029.text": "HORA",
        "h0211.bind": "{weekday} à noite",
        "h0211.text": "Sexta-feira à noite",
        "h0212.text": "LOCAL",
        "h0213.text": "Casa de Eventos Pátio da Videira",
        "h0214.text": "Boavista, Porto",
        "h0215.text": "RSVP · Sofia Estrela · 0533 418 27 90",
        "h0217.text": "A hena é por nossa conta,\na alegria por vossa conta."
      },
      "ru": {
        "h021.bind": "НАША ДОЧЬ {first}",
        "h021.text": "НАША ДОЧЬ ДАРЬЯ",
        "h022.text": "Хна",
        "h023.text": "вечер",
        "h025.text": "В этот значимый вечер перед проводами\nиз родительского дома давайте вместе\nукрасим её хной; мы хотим видеть\nвас среди нас.",
        "h027.text": "ДАТА",
        "h028.text": "23 июля 2027",
        "h029.text": "ВРЕМЯ",
        "h0211.bind": "{weekday}, вечер",
        "h0211.text": "Вечер пятницы",
        "h0212.text": "МЕСТО",
        "h0213.text": "Зал «Виноградный дворик»",
        "h0214.text": "Центр, Воронеж",
        "h0215.text": "RSVP · Севгюль Йылдыз · 0533 418 27 90",
        "h0217.text": "Хна — от нас,\nвеселье — от вас."
      }
    },

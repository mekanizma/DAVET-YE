    "translations": {
      "ar": {
        "h044.text": "أنتم مدعوون\nإلى ليلة حنائنا",
        "h045.text": "بشرى",
        "h049.text": "في ليلة عروسنا السعيدة\nالتي ستُزيَّن فيها بالحناء،\nنتمنى أن نراكم بيننا.",
        "h0410.text": "4 يونيو 2027",
        "h0411.bind": "{weekday} · الساعة {time}",
        "h0411.text": "الجمعة · الساعة 8:00 مساءً",
        "h0412.text": "قاعة حدائق الليلك",
        "h0413.text": "حي الخليج التجاري، دبي",
        "h0415.text": "الأسرة: فريال & أحمد الخطيب",
        "h0416.text": "تأكيد الحضور · 0542 316 70 25"
      },
      "de": {
        "h044.text": "SIE SIND ZU UNSEREM\nHENNA-ABEND EINGELADEN",
        "h045.text": "Bente",
        "h049.text": "An diesem glücklichen Abend unserer Braut,\ndie das Henna bekommt, würden wir\nSie gern in unserer Mitte sehen.",
        "h0410.bind": "{day}. {month} {year}",
        "h0410.text": "4. Juni 2027",
        "h0411.bind": "{weekday} · {time} UHR",
        "h0411.text": "FREITAG · 20:00 UHR",
        "h0412.text": "Fliedergarten Empfang",
        "h0413.text": "Bahnhofsviertel, Frankfurt",
        "h0415.text": "Familie: Filiz & Ahmet Koç",
        "h0416.text": "RSVP · 0542 316 70 25"
      },
      "el": {
        "h044.text": "ΣΑΣ ΠΡΟΣΚΑΛΟΥΜΕ\nΣΤΗ ΒΡΑΔΙΑ ΧΕΝΝΑΣ ΜΑΣ",
        "h045.text": "Βάνια",
        "h049.text": "Θα θέλαμε να σας δούμε ανάμεσά μας\nαυτή την ευτυχισμένη βραδιά\nτης νύφης μας, όπου θα βαφτεί η χέννα της.",
        "h0410.text": "4 Ιουνίου 2027",
        "h0411.bind": "{weekday} · ΩΡΑ {time}",
        "h0411.text": "ΠΑΡΑΣΚΕΥΗ · 20:00",
        "h0412.text": "Κήπος Πασχαλιάς",
        "h0413.text": "Ιαλυσός, Ρόδος",
        "h0415.text": "Οικογένεια: Φιλιώ & Άλκης Κόκκα",
        "h0416.text": "RSVP · 0542 316 70 25"
      },
      "en": {
        "h044.text": "YOU'RE INVITED\nTO OUR HENNA NIGHT",
        "h045.text": "Bailey",
        "h049.text": "On this happy night of our bride,\nwhose henna will be applied, we'd\nlove to have you with us.",
        "h0410.text": "June 4, 2027",
        "h0411.bind": "{weekday} · {time}",
        "h0411.text": "FRIDAY · 8:00 PM",
        "h0412.text": "Lilac Garden Reception",
        "h0413.text": "South Beach, Miami",
        "h0415.text": "Family: Filiz & Ahmet Koç",
        "h0416.text": "RSVP · 0542 316 70 25"
      },
      "es": {
        "h044.text": "TE INVITAMOS A\nNUESTRA NOCHE DE HENNA",
        "h045.text": "Bárbara",
        "h049.text": "En la feliz noche de nuestra novia,\ncuando se le aplicará la henna,\nqueremos contar contigo.",
        "h0410.bind": "{day} de {month} de {year}",
        "h0410.text": "4 de junio de 2027",
        "h0411.bind": "{weekday} · A LAS {time}",
        "h0411.text": "VIERNES · A LAS 20:00",
        "h0412.text": "Jardín de las Lilas",
        "h0413.text": "Centro, Málaga",
        "h0415.text": "Su familia: Filiz & Ahmet Koç",
        "h0416.text": "RSVP · 0542 316 70 25"
      },
      "fr": {
        "h044.text": "VOUS ÊTES INVITÉS\nÀ NOTRE SOIRÉE DU HENNÉ",
        "h045.text": "Clara",
        "h049.text": "En cette heureuse soirée où le henné de notre mariée\nsera posé, nous aimerions\nvous compter parmi nous.",
        "h0410.text": "4 juin 2027",
        "h0411.bind": "{weekday} · À {time}",
        "h0411.text": "VENDREDI · À 20 H 00",
        "h0412.text": "Jardin des Lilas",
        "h0413.text": "Centre, Antibes",
        "h0415.text": "Sa famille : Filiz & Ahmet Koç",
        "h0416.text": "RSVP · 0542 316 70 25"
      },
      "it": {
        "h044.text": "TI INVITIAMO ALLA\nNOSTRA NOTTE DELL'HENNÉ",
        "h045.text": "Bruna",
        "h049.text": "Nella felice serata della nostra sposa,\nche riceverà l'henné,\nvorremmo averti con noi.",
        "h0410.text": "4 giugno 2027",
        "h0411.bind": "{weekday} · ORE {time}",
        "h0411.text": "VENERDÌ · ORE 20.00",
        "h0412.text": "Giardino dei Lillà",
        "h0413.text": "Chiaia, Napoli",
        "h0415.text": "Famiglia: Filiz & Ahmet Koç",
        "h0416.text": "RSVP · 0542 316 70 25"
      },
      "pt": {
        "h044.text": "ESTÃO CONVIDADOS PARA\nA NOSSA NOITE DA HENA",
        "h045.text": "Beatriz",
        "h049.text": "Nesta noite feliz em que a nossa\nnoiva recebe a hena,\nqueremos ter-vos connosco.",
        "h0410.bind": "{day} de {month} de {year}",
        "h0410.text": "4 de junho de 2027",
        "h0411.bind": "{weekday} · ÀS {time}",
        "h0411.text": "SEXTA-FEIRA · ÀS 20H00",
        "h0412.text": "Eventos Jardim dos Lilases",
        "h0413.text": "Baixa, Faro",
        "h0415.text": "Família: Filipa & André Costa",
        "h0416.text": "RSVP · 0542 316 70 25"
      },
      "ru": {
        "h044.text": "ПРИГЛАШАЕМ ВАС НА\nНАШ ВЕЧЕР ХНЫ",
        "h045.text": "Ольга",
        "h049.text": "В этот счастливый вечер нашей невесты,\nкогда ей будут наносить хну,\nмы хотим видеть и вас среди нас.",
        "h0410.text": "4 июня 2027",
        "h0411.bind": "{weekday} · В {time}",
        "h0411.text": "ПЯТНИЦА · 20:00",
        "h0412.text": "Сад «Сирень»",
        "h0413.text": "Центр, Анапа",
        "h0415.text": "Семья: Филиз & Ахмет Коч",
        "h0416.text": "RSVP · 0542 316 70 25"
      }

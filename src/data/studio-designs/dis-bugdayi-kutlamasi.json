    "translations": {
      "ar": {
        "f138.text": "ظهرت سنّنا الأولى!",
        "f139.text": "أنس",
        "f1311.text": "احتفال أول سنّ",
        "f1313.text": "في احتفال أول سنّ لصغيرنا\nالذي أعددناه بهذه المناسبة،\nنتمنى أن نراكم بيننا.",
        "f1315.text": "18 أبريل 2027 · الأحد",
        "f1316.bind": "الساعة {time}",
        "f1316.text": "الساعة 3:00 عصراً",
        "f1317.text": "بيتنا · شارع النخيل رقم 12",
        "f1318.text": "الكرنك، الأقصر",
        "f1319.text": "تأكيد الحضور · 0535 408 27 61",
        "f1320.text": "الوالدان: جنى & غازي الحجري"
      },
      "de": {
        "f138.text": "UNSER ERSTER ZAHN IST DA!",
        "f139.text": "Aaron",
        "f1311.text": "Zahnfest",
        "f1313.text": "Zum Zahnfest, das wir für den ersten Zahn\nunseres kleinen Sohnes ausrichten, möchten wir\nSie in unserer Mitte sehen.",
        "f1315.bind": "{day}. {month} {year} · {weekday}",
        "f1315.text": "18. April 2027 · Sonntag",
        "f1316.bind": "{time} UHR",
        "f1316.text": "15:00 UHR",
        "f1317.text": "Unser Zuhause · Birkenweg 12",
        "f1318.text": "Altstadt, Göttingen",
        "f1319.text": "RSVP · 0535 408 27 61",
        "f1320.text": "Eltern: Ceren & Oguz Tas"
      },
      "el": {
        "f138.text": "ΒΓΗΚΕ ΤΟ ΠΡΩΤΟ ΜΑΣ ΔΟΝΤΑΚΙ!",
        "f139.text": "Άγις",
        "f1311.text": "πρώτο δοντάκι",
        "f1313.text": "Θα θέλαμε να σας δούμε ανάμεσά μας\nστη γιορτή που ετοιμάσαμε\nγια το πρώτο δοντάκι του μικρού μας γιου.",
        "f1315.text": "18 Απριλίου 2027 · Κυριακή",
        "f1316.bind": "ΩΡΑ {time}",
        "f1316.text": "ΩΡΑ 15:00",
        "f1317.text": "Το σπίτι μας · Ελαιών 12",
        "f1318.text": "Κέντρο, Καλαμάτα",
        "f1319.text": "RSVP · 0535 408 27 61",
        "f1320.text": "Γονείς: Χλόη & Όσκαρ Ρούση"
      },
      "en": {
        "f138.text": "OUR FIRST TOOTH IS IN!",
        "f139.text": "Austin",
        "f1311.text": "first tooth party",
        "f1313.text": "We'd love to have you with us at the\nfirst-tooth celebration we've prepared\nfor our little son.",
        "f1315.text": "April 18, 2027 · Sunday",
        "f1316.bind": "AT {time}",
        "f1316.text": "AT 3:00 PM",
        "f1317.text": "Our Home · 12 Cotton Street",
        "f1318.text": "Asheville, North Carolina",
        "f1319.text": "RSVP · 0535 408 27 61",
        "f1320.text": "Parents: Claire & Oscar Tate"
      },
      "es": {
        "f138.text": "¡NOS HA SALIDO EL PRIMER DIENTE!",
        "f139.text": "Álvaro",
        "f1311.text": "fiesta del primer diente",
        "f1313.text": "En la fiesta del primer diente que hemos preparado\npara nuestro pequeño,\nqueremos contar contigo.",
        "f1315.bind": "{day} de {month} de {year} · {weekday}",
        "f1315.text": "18 de abril de 2027 · domingo",
        "f1316.bind": "A LAS {time}",
        "f1316.text": "A LAS 15:00",
        "f1317.text": "Nuestra casa · Calle de los Olivos, 12",
        "f1318.text": "Centro, Jaén",
        "f1319.text": "RSVP · 0535 408 27 61",
        "f1320.text": "Sus padres: Ceren & Oguz Tas"
      },
      "fr": {
        "f138.text": "NOTRE PREMIÈRE DENT EST SORTIE !",
        "f139.text": "Arno",
        "f1311.text": "première dent",
        "f1313.text": "Nous aimerions vous compter parmi nous\nà la fête de la première dent\nque nous organisons pour notre petit garçon.",
        "f1315.text": "18 avril 2027 · dimanche",
        "f1316.bind": "À {time}",
        "f1316.text": "À 15 H 00",
        "f1317.text": "Chez nous · 12 rue des Lilas",
        "f1318.text": "Vieille ville, Nancy",
        "f1319.text": "RSVP · 0535 408 27 61",
        "f1320.text": "Ses parents : Ceren & Oguz Tas"
      },
      "it": {
        "f138.text": "È SPUNTATO IL PRIMO DENTINO!",
        "f139.text": "Angelo",
        "f1311.text": "festa del dentino",
        "f1313.text": "Per il primo dentino del nostro piccolino\nabbiamo preparato una festa:\nvorremmo averti con noi.",
        "f1315.text": "18 aprile 2027 · domenica",
        "f1316.bind": "ORE {time}",
        "f1316.text": "ORE 15.00",
        "f1317.text": "A casa nostra · Via delle Terme 12",
        "f1318.text": "Monteriggioni, Siena",
        "f1319.text": "RSVP · 0535 408 27 61",
        "f1320.text": "Genitori: Ceren & Oguz Tas"
      },
      "pt": {
        "f138.text": "JÁ TEMOS O PRIMEIRO DENTINHO!",
        "f139.text": "Álvaro",
        "f1311.text": "festa do primeiro dente",
        "f1313.text": "Gostaríamos de vos ter connosco na\ncelebração do primeiro dente\ndo nosso filhinho.",
        "f1315.bind": "{day} de {month} de {year} · {weekday}",
        "f1315.text": "18 de abril de 2027 · domingo",
        "f1316.bind": "ÀS {time}",
        "f1316.text": "ÀS 15H00",
        "f1317.text": "A nossa casa · Rua das Oliveiras, 12",
        "f1318.text": "Baixa, Coimbra",
        "f1319.text": "RSVP · 0535 408 27 61",
        "f1320.text": "Pais: Catarina & Orlando Pedroso"
      },
      "ru": {
        "f138.text": "ПРОРЕЗАЛСЯ ПЕРВЫЙ ЗУБ!",
        "f139.text": "Арсен",
        "f1311.text": "на зубок",
        "f1313.text": "На празднике «на зубок», который мы устраиваем\nв честь первого зубика нашего сына,\nмы хотим видеть вас среди нас.",
        "f1315.text": "18 апреля 2027 · воскресенье",
        "f1316.bind": "В {time}",
        "f1316.text": "В 15:00",
        "f1317.text": "Наш дом · ул. Липовая, д. 12",
        "f1318.text": "Советский р-н, Липецк",
        "f1319.text": "RSVP · 0535 408 27 61",
        "f1320.text": "Родители: Джерен & Огуз Таш"

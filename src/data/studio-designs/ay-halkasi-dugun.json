    "translations": {
      "ar": {
        "m173.text": "ص&ب",
        "m179.text": "أنتم مدعوون إلى زفافنا",
        "m1710.text": "صفاء",
        "m1711.text": "& بسام",
        "m1712.text": "نودّ أن نحتفل معكم بحكايتنا\nالتي بدأت تحت النجوم.",
        "m1714.text": "23 أكتوبر 2027 · السبت · 8:00 مساءً",
        "m1715.text": "حديقة الحرفيين · حي الزهراء، جدة",
        "m1716.text": "تأكيد الحضور · 0532 487 19 56"
      },
      "de": {
        "m173.text": "D&B",
        "m179.text": "SIE SIND ZU UNSERER HOCHZEIT EINGELADEN",
        "m1710.text": "Daria",
        "m1711.text": "& Björn",
        "m1712.text": "Wir möchten unsere Geschichte, die unter den Sternen begann,\nmit Ihnen feiern.",
        "m1714.bind": "{day}. {month} {year} · {weekday} · {time}",
        "m1714.text": "23. Oktober 2027 · Samstag · 20:00",
        "m1715.text": "Brauereigarten · Eimsbüttel, Hamburg",
        "m1716.text": "RSVP · 0532 487 19 56"
      },
      "el": {
        "m173.text": "Δ&Β",
        "m179.text": "ΣΑΣ ΠΡΟΣΚΑΛΟΥΜΕ ΣΤΟΝ ΓΑΜΟ ΜΑΣ",
        "m1710.text": "Δώρα",
        "m1711.text": "& Βάιος",
        "m1712.text": "Θα θέλαμε να γιορτάσουμε μαζί σας\nτην ιστορία μας που ξεκίνησε κάτω από τα αστέρια.",
        "m1714.text": "23 Οκτωβρίου 2027 · Σάββατο · 20:00",
        "m1715.text": "Κήπος Ζυθοποιίας · Χαλάνδρι, Αθήνα",
        "m1716.text": "RSVP · 0532 487 19 56"
      },
      "en": {
        "m173.text": "D&B",
        "m179.text": "YOU'RE INVITED TO OUR WEDDING",
        "m1710.text": "Dana",
        "m1711.text": "& Brandon",
        "m1712.text": "We'd love to celebrate with you the story\nthat began under the stars.",
        "m1714.text": "October 23, 2027 · Saturday · 8:00 PM",
        "m1715.text": "Foundry Garden · Chelsea, New York",
        "m1716.text": "RSVP · 0532 487 19 56"
      },
      "es": {
        "m173.text": "D&P",
        "m179.text": "TE INVITAMOS A NUESTRA BODA",
        "m1710.text": "Dulce",
        "m1711.text": "& Pablo",
        "m1712.text": "Queremos celebrar contigo nuestra historia,\nnacida bajo las estrellas.",
        "m1714.bind": "{day} de {month} de {year} · {weekday} · {time}",
        "m1714.text": "23 de octubre de 2027 · sábado · 20:00",
        "m1715.text": "Jardín de la Fábrica · Poblenou, Barcelona",
        "m1716.text": "RSVP · 0532 487 19 56"
      },
      "fr": {
        "m173.text": "D&P",
        "m179.text": "VOUS ÊTES INVITÉS À NOTRE MARIAGE",
        "m1710.text": "Dora",
        "m1711.text": "& Paul",
        "m1712.text": "Nous aimerions fêter avec vous\nnotre histoire née sous les étoiles.",
        "m1714.text": "23 octobre 2027 · samedi · 20 h 00",
        "m1715.text": "Jardin de la Brasserie · Bastille, Paris",
        "m1716.text": "RSVP · 0532 487 19 56"
      },
      "it": {
        "m173.text": "D&B",
        "m179.text": "TI INVITIAMO AL NOSTRO MATRIMONIO",
        "m1710.text": "Diana",
        "m1711.text": "& Biagio",
        "m1712.text": "Vorremmo festeggiare con te la nostra storia\nnata sotto le stelle.",
        "m1714.text": "23 ottobre 2027 · sabato · 20.00",
        "m1715.text": "Giardino Ex Fabbrica · Lambrate, Milano",
        "m1716.text": "RSVP · 0532 487 19 56"
      },
      "pt": {
        "m173.text": "D&B",
        "m179.text": "ESTÃO CONVIDADOS PARA O NOSSO CASAMENTO",
        "m1710.text": "Dulce",
        "m1711.text": "& Bruno",
        "m1712.text": "Queremos celebrar convosco a nossa história,\nnascida sob as estrelas.",
        "m1714.bind": "{day} de {month} de {year} · {weekday} · {time}",
        "m1714.text": "23 de outubro de 2027 · sábado · 20h00",

    "translations": {
      "ar": {
        "k183.text": "أنتم مدعوون إلى حفل خطوبتنا",
        "k184.text": "غادة",
        "k186.text": "سامر",
        "k189.text": "9 أكتوبر 2027 · السبت",
        "k1810.bind": "الساعة {time}",
        "k1810.text": "الساعة 19.30",
        "k1811.text": "بحضور عائلتينا نتبادل الخواتم\nفي هذه الأمسية الجميلة،\nويسعدنا أن نراكم بيننا.",
        "k1815.text": "خان التجار",
        "k1816.text": "وسط المدينة، فاس",
        "k1817.text": "تأكيد الحضور · 0533 726 95 18"
      },
      "de": {
        "k183.text": "SIE SIND ZU UNSERER VERLOBUNG EINGELADEN",
        "k184.text": "Greta",
        "k186.text": "Stefan",
        "k189.bind": "{day}. {month} {year} · {weekday}",
        "k189.text": "9. OKTOBER 2027 · SAMSTAG",
        "k1810.bind": "{time} UHR",
        "k1810.text": "19:30 UHR",
        "k1811.text": "An diesem schönen Abend, an dem wir im Beisein\nunserer Familien unsere Ringe anstecken, würden\nwir uns freuen, Sie in unserer Mitte zu begrüßen.",
        "k1815.text": "Alter Handelshof",
        "k1816.text": "ALTSTADT, ERFURT",
        "k1817.text": "RSVP · 0533 726 95 18"
      },
      "el": {
        "k183.text": "ΣΑΣ ΠΡΟΣΚΑΛΟΥΜΕ ΣΤΟΝ ΑΡΡΑΒΩΝΑ ΜΑΣ",
        "k184.text": "Γωγώ",
        "k186.text": "Σπύρος",
        "k189.text": "9 ΟΚΤΩΒΡΙΟΥ 2027 · ΣΑΒΒΑΤΟ",
        "k1810.bind": "ΩΡΑ {time}",
        "k1810.text": "ΩΡΑ 19:30",
        "k1811.text": "Θα χαρούμε πολύ να σας δούμε ανάμεσά μας\nαυτό το όμορφο βράδυ που θα φορέσουμε\nτα δαχτυλίδια μας μπροστά στις οικογένειές μας.",
        "k1815.text": "Ιστορικό Χάνι",
        "k1816.text": "ΚΕΝΤΡΟ, ΞΑΝΘΗ",
        "k1817.text": "RSVP · 0533 726 95 18"
      },
      "en": {
        "k183.text": "YOU'RE INVITED TO OUR ENGAGEMENT",
        "k184.text": "Grace",
        "k186.text": "Sean",
        "k189.text": "OCTOBER 9, 2027 · SATURDAY",
        "k1810.bind": "AT {time}",
        "k1810.text": "AT 7:30 PM",
        "k1811.text": "In the presence of our families, on this beautiful evening\nwhen we exchange our rings, we would be\ndelighted to have you with us.",
        "k1815.text": "Old Stagecoach Inn",
        "k1816.text": "DOWNTOWN, BURLINGTON",
        "k1817.text": "RSVP · 0533 726 95 18"
      },
      "es": {
        "k183.text": "TE INVITAMOS A NUESTRO COMPROMISO",
        "k184.text": "Gema",
        "k186.text": "Sergio",
        "k189.bind": "{day} de {month} de {year} · {weekday}",
        "k189.text": "9 DE OCTUBRE DE 2027 · SÁBADO",
        "k1810.bind": "A LAS {time}",
        "k1810.text": "A LAS 19:30",
        "k1811.text": "En esta hermosa velada en la que nos pondremos\nlos anillos ante nuestras familias,\nnos hará muy felices contar contigo.",
        "k1815.text": "Antigua Posada del Camino",
        "k1816.text": "BARRI VELL, GIRONA",
        "k1817.text": "RSVP · 0533 726 95 18"
      },
      "fr": {
        "k183.text": "VOUS ÊTES INVITÉS À NOS FIANÇAILLES",
        "k184.text": "Carla",
        "k186.text": "Samuel",
        "k189.text": "9 OCTOBRE 2027 · SAMEDI",
        "k1810.bind": "À {time}",
        "k1810.text": "À 19 H 30",
        "k1811.text": "En présence de nos familles, nous échangerons\nnos bagues en cette belle soirée ; nous serions\nheureux de vous compter parmi nous.",
        "k1815.text": "Le Relais des Marchands",
        "k1816.text": "CENTRE, ROUEN",
        "k1817.text": "RSVP · 0533 726 95 18"
      },
      "it": {
        "k183.text": "TI INVITIAMO AL NOSTRO FIDANZAMENTO",
        "k184.text": "Giulia",
        "k186.text": "Sergio",
        "k189.text": "9 OTTOBRE 2027 · SABATO",
        "k1810.bind": "ORE {time}",
        "k1810.text": "ORE 19.30",
        "k1811.text": "Davanti alle nostre famiglie, in questa bella serata\nin cui ci scambieremo gli anelli,\nsaremo felici di averti con noi.",
        "k1815.text": "Antica Locanda del Borgo",
        "k1816.text": "CENTRO, PADOVA",
        "k1817.text": "RSVP · 0533 726 95 18"
      },
      "pt": {
        "k183.text": "ESTÃO CONVIDADOS PARA O NOSSO NOIVADO",
        "k184.text": "Graça",
        "k186.text": "Sérgio",
        "k189.bind": "{day} de {month} de {year} · {weekday}",
        "k189.text": "9 DE OUTUBRO DE 2027 · SÁBADO",
        "k1810.bind": "ÀS {time}",
        "k1810.text": "ÀS 19H30",
        "k1811.text": "Na presença das nossas famílias, nesta bela noite\nem que trocaremos os anéis, será uma alegria\ncontar convosco.",
        "k1815.text": "Antiga Estalagem do Caminho",
        "k1816.text": "CENTRO, ÉVORA",
        "k1817.text": "RSVP · 0533 726 95 18"
      },
      "ru": {
        "k183.text": "ПРИГЛАШАЕМ ВАС НА НАШУ ПОМОЛВКУ",
        "k184.text": "Галина",
        "k186.text": "Сергей",
        "k189.text": "9 ОКТЯБРЯ 2027 · СУББОТА",
        "k1810.bind": "В {time}",
        "k1810.text": "В 19:30",
        "k1811.text": "В присутствии наших семей, в этот прекрасный вечер,\nкогда мы обменяемся кольцами, мы будем\nсчастливы видеть вас среди нас.",
        "k1815.text": "Старый торговый двор",
        "k1816.text": "ЦЕНТР, ПСКОВ",
        "k1817.text": "RSVP · 0533 726 95 18"
      }
    },

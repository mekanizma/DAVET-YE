    "translations": {
      "ar": {
        "f015.text": "ابننا",
        "f016.text": "عمر آصف",
        "f017.text": "حفل الختان",
        "f0111.text": "نودّ أن نتشارك معكم فرحة خطوته الأولى نحو الرجولة،\nونتمنى أن نراكم\nبيننا في هذا اليوم السعيد.",
        "f0112.text": "26 يونيو 2027",
        "f0113.bind": "{weekday} · الساعة {time}",
        "f0113.text": "السبت · الساعة 7:30 مساءً",
        "f0114.text": "سويس أوتيل جدة",
        "f0115.text": "حي الشاطئ، جدة",
        "f0116.text": "الأسرة: زهراء & مراد الغزالي",
        "f0117.text": "تأكيد الحضور · 0533 412 76 90"
      },
      "de": {
        "f015.text": "UNSER SOHN",
        "f016.text": "Olaf Arvid",
        "f017.text": "Beschneidungsfeier",
        "f0111.text": "Die Freude über seinen ersten Schritt ins Mannesalter\nmöchten wir mit Ihnen teilen und Sie an diesem\nglücklichen Tag in unserer Mitte sehen.",
        "f0112.bind": "{day}. {month} {year}",
        "f0112.text": "26. JUNI 2027",
        "f0113.bind": "{weekday} · {time} UHR",
        "f0113.text": "SAMSTAG · 19:30 UHR",
        "f0114.text": "Swissôtel The Bosphorus",
        "f0115.text": "HAFENCITY, HAMBURG",
        "f0116.text": "Familie: Zehra & Murat Karaca",
        "f0117.text": "RSVP · 0533 412 76 90"
      },
      "el": {
        "f015.text": "Ο ΓΙΟΣ ΜΑΣ",
        "f016.text": "Ορφέας Άσων",
        "f017.text": "Γιορτή περιτομής",
        "f0111.text": "Θα θέλαμε να μοιραστούμε μαζί σας τη χαρά\nτου πρώτου του βήματος προς την ανδρική ηλικία\nκαι να σας δούμε ανάμεσά μας.",
        "f0112.text": "26 ΙΟΥΝΙΟΥ 2027",
        "f0113.bind": "{weekday} · ΩΡΑ {time}",
        "f0113.text": "ΣΑΒΒΑΤΟ · ΩΡΑ 19:30",
        "f0114.text": "Σουισοτέλ Αθήνα",
        "f0115.text": "ΜΑΡΟΥΣΙ, ΑΘΗΝΑ",
        "f0116.text": "Οικογένεια: Ζέτα & Μάκης Μαύρου",
        "f0117.text": "RSVP · 0533 412 76 90"
      },
      "en": {
        "f015.text": "OUR SON",
        "f016.text": "Omar Asher",
        "f017.text": "Circumcision Celebration",
        "f0111.text": "We'd love to share the joy of his first step\ninto manhood with you and have you\nwith us on this happy day.",
        "f0112.text": "JUNE 26, 2027",
        "f0113.bind": "{weekday} · {time}",
        "f0113.text": "SATURDAY · 7:30 PM",
        "f0114.text": "Swissôtel The Bosphorus",
        "f0115.text": "MANHATTAN, NEW YORK",
        "f0116.text": "Family: Zehra & Murat Karaca",
        "f0117.text": "RSVP · 0533 412 76 90"
      },
      "es": {
        "f015.text": "NUESTRO HIJO",
        "f016.text": "Omar Aitor",
        "f017.text": "Fiesta de circuncisión",
        "f0111.text": "Queremos compartir contigo la alegría de su primer paso\nhacia la hombría\ny tenerte con nosotros en este feliz día.",
        "f0112.bind": "{day} de {month} de {year}",
        "f0112.text": "26 DE JUNIO DE 2027",
        "f0113.bind": "{weekday} · A LAS {time}",
        "f0113.text": "SÁBADO · A LAS 19:30",
        "f0114.text": "Swissôtel The Bosphorus",
        "f0115.text": "SARRIÀ, BARCELONA",
        "f0116.text": "Su familia: Zehra & Murat Karaca",
        "f0117.text": "RSVP · 0533 412 76 90"
      },
      "fr": {
        "f015.text": "NOTRE FILS",
        "f016.text": "Oscar Alan",
        "f017.text": "Fête de circoncision",
        "f0111.text": "Nous aimerions partager avec vous la joie de son premier pas\nvers l’âge d’homme\net vous compter parmi nous en ce jour heureux.",
        "f0112.text": "26 JUIN 2027",
        "f0113.bind": "{weekday} · À {time}",
        "f0113.text": "SAMEDI · À 19 H 30",
        "f0114.text": "Swissôtel The Bosphorus",
        "f0115.text": "PASSY, PARIS",
        "f0116.text": "Sa famille : Zehra & Murat Karaca",
        "f0117.text": "RSVP · 0533 412 76 90"
      },
      "it": {
        "f015.text": "NOSTRO FIGLIO",
        "f016.text": "Giampiero",
        "f017.text": "Festa della circoncisione",
        "f0111.text": "Vorremmo condividere con te la gioia del suo primo passo\nverso l'età adulta e averti con noi\nin questo giorno felice.",
        "f0112.text": "26 GIUGNO 2027",

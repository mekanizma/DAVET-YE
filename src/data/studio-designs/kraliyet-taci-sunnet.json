        "f0114.text": "Swissôtel The Bosphorus",
        "f0115.text": "PORTA NUOVA, MILANO",
        "f0116.text": "Famiglia: Zehra & Murat Karaca",
        "f0117.text": "RSVP · 0533 412 76 90"
      },
      "pt": {
        "f015.text": "O NOSSO FILHO",
        "f016.text": "Óscar Afonso",
        "f017.text": "Festa da Circuncisão",
        "f0111.text": "Queremos partilhar convosco a alegria do seu primeiro passo\npara a idade adulta e ter-vos\nconnosco neste dia feliz.",
        "f0112.bind": "{day} de {month} de {year}",
        "f0112.text": "26 DE JUNHO DE 2027",
        "f0113.bind": "{weekday} · ÀS {time}",
        "f0113.text": "SÁBADO · ÀS 19H30",
        "f0114.text": "Swissôtel Lisboa",

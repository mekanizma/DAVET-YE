    "translations": {
      "ar": {
        "h066.text": "أنتم مدعوون إلى ليلة حنائنا",
        "h069.text": "ابنتنا",
        "h0610.text": "رميساء",
        "h0614.text": "10 سبتمبر 2027",
        "h0615.bind": "{weekday} · الساعة {time}",
        "h0615.text": "الجمعة · الساعة 8:00 مساءً",
        "h0616.text": "قاعة المجلس للمناسبات",
        "h0617.text": "حي الشفا، الطائف",
        "h0618.text": "لتُزيَّن الأيادي بالحناء ولتُغنَّ الأغاني الشعبية؛ شاركونا بهجة هذه الليلة.",
        "h0619.text": "تأكيد الحضور · حبيبة الليثي · 0505 362 18 44"
      },
      "de": {
        "h066.text": "SIE SIND ZU UNSEREM HENNA-ABEND EINGELADEN",
        "h069.text": "Unsere Tochter",
        "h0610.text": "Rebekka",
        "h0614.bind": "{day}. {month} {year}",
        "h0614.text": "10. SEPTEMBER 2027",
        "h0615.bind": "{weekday} · {time} UHR",
        "h0615.text": "FREITAG · 20:00 UHR",
        "h0616.text": "Festsaal Alter Salon",
        "h0617.text": "ALTSTADT, ERFURT",
        "h0618.text": "Das Henna wird aufgetragen, Volkslieder erklingen; teilen Sie heute Abend unsere Freude.",
        "h0619.text": "RSVP · SEVIM ARSLAN · 0505 362 18 44"
      },
      "el": {
        "h066.text": "ΣΑΣ ΠΡΟΣΚΑΛΟΥΜΕ ΣΤΗ ΒΡΑΔΙΑ ΧΕΝΝΑΣ ΜΑΣ",
        "h069.text": "Η κόρη μας",
        "h0610.text": "Ρεβέκκα",
        "h0614.text": "10 ΣΕΠΤΕΜΒΡΙΟΥ 2027",
        "h0615.bind": "{weekday} · ΩΡΑ {time}",
        "h0615.text": "ΠΑΡΑΣΚΕΥΗ · 20:00",
        "h0616.text": "Αίθουσα Υποδοχής",
        "h0617.text": "ΚΕΝΤΡΟ, ΚΟΜΟΤΗΝΗ",
        "h0618.text": "Ας βαφτεί η χέννα, ας ακουστούν τα τραγούδια· μοιραστείτε τη χαρά μας απόψε.",
        "h0619.text": "RSVP · ΣΤΕΛΛΑ ΛΕΟΝΤΑ · 0505 362 18 44"
      },
      "en": {
        "h066.text": "YOU'RE INVITED TO OUR HENNA NIGHT",
        "h069.text": "Our daughter",
        "h0610.text": "Ruth",
        "h0614.text": "SEPTEMBER 10, 2027",
        "h0615.bind": "{weekday} · {time}",
        "h0615.text": "FRIDAY · 8:00 PM",
        "h0616.text": "Grand Parlor Event Hall",
        "h0617.text": "GERMAN VILLAGE, OH",
        "h0618.text": "Let the henna be applied and the folk songs sung; share in our joy tonight.",
        "h0619.text": "RSVP · SARAH ALLEN · 0505 362 18 44"
      },
      "es": {
        "h066.text": "TE INVITAMOS A NUESTRA NOCHE DE HENNA",
        "h069.text": "Nuestra hija",
        "h0610.text": "Rebeca",
        "h0614.bind": "{day} de {month} de {year}",
        "h0614.text": "10 DE SEPTIEMBRE DE 2027",
        "h0615.bind": "{weekday} · A LAS {time}",
        "h0615.text": "VIERNES · A LAS 20:00",
        "h0616.text": "Salón de eventos Señorial",
        "h0617.text": "DELICIAS, ZARAGOZA",
        "h0618.text": "Que se tiña la henna y suenen las canciones populares; comparte nuestra alegría esta noche.",
        "h0619.text": "RSVP · SEVIM ARSLAN · 0505 362 18 44"
      },
      "fr": {
        "h066.text": "VOUS ÊTES INVITÉS À NOTRE SOIRÉE DU HENNÉ",
        "h069.text": "Notre fille",
        "h0610.text": "Roxane",
        "h0614.text": "10 SEPTEMBRE 2027",
        "h0615.bind": "{weekday} · À {time}",
        "h0615.text": "VENDREDI · À 20 H 00",
        "h0616.text": "Salon d’Honneur",
        "h0617.text": "SAINT-RÉMI, REIMS",
        "h0618.text": "Que le henné soit posé, que les chants résonnent ; partagez notre joie ce soir.",
        "h0619.text": "RSVP · SEVIM ARSLAN · 0505 362 18 44"
      },
      "it": {
        "h066.text": "TI INVITIAMO ALLA NOSTRA NOTTE DELL'HENNÉ",
        "h069.text": "Nostra figlia",
        "h0610.text": "Rebecca",
        "h0614.text": "10 SETTEMBRE 2027",
        "h0615.bind": "{weekday} · ORE {time}",
        "h0615.text": "VENERDÌ · ORE 20.00",
        "h0616.text": "Sala ricevimenti Il Cortile",
        "h0617.text": "SAN SISTO, PERUGIA",
        "h0618.text": "Si applichi l'henné e si intonino i canti: stasera unisciti alla nostra allegria.",
        "h0619.text": "RSVP · SEVIM ARSLAN · 0505 362 18 44"
      },
      "pt": {
        "h066.text": "ESTÃO CONVIDADOS PARA A NOSSA NOITE DA HENA",
        "h069.text": "A nossa filha",
        "h0610.text": "Rebeca",
        "h0614.bind": "{day} de {month} de {year}",
        "h0614.text": "10 DE SETEMBRO DE 2027",
        "h0615.bind": "{weekday} · ÀS {time}",
        "h0615.text": "SEXTA-FEIRA · ÀS 20H00",
        "h0616.text": "Salão de Eventos Sala Nobre",
        "h0617.text": "CENTRO HISTÓRICO, LEIRIA",
        "h0618.text": "Que se aplique a hena e se cantem as canções populares; partilhem esta noite a nossa alegria.",
        "h0619.text": "RSVP · SUSANA LEÃO · 0505 362 18 44"
      },
      "ru": {
        "h066.text": "ПРИГЛАШАЕМ ВАС НА НАШ ВЕЧЕР ХНЫ",
        "h069.text": "Наша дочь",
        "h0610.text": "Руслана",
        "h0614.text": "10 СЕНТЯБРЯ 2027",
        "h0615.bind": "{weekday} · В {time}",
        "h0615.text": "ПЯТНИЦА · 20:00",
        "h0616.text": "Парадный банкетный зал",
        "h0617.text": "СЕЛЬЧУКЛУ, КОНЬЯ",
        "h0618.text": "Пусть наносят хну, пусть звучат народные песни — разделите с нами веселье этого вечера.",
        "h0619.text": "RSVP · СЕВИМ АРСЛАН · 0505 362 18 44"
      }
    },

    "translations": {
      "ar": {
        "f106.text": "دعوة إلى المولد والوليمة",
        "f107.text": "ابننا",
        "f108.text": "حمزة",
        "f109.text": "فرحاً بختان ابننا نقيم مجلس\nالمولد الشريف تليه وليمة،\nونرجو أن تشرّفونا بحضوركم.",
        "f1010.text": "المولد",
        "f1011.text": "بعد صلاة الظهر\nجامع الهدى",
        "f1013.text": "الوليمة",
        "f1014.text": "الساعة 2:00 ظهراً\nفندق الشفا",
        "f1015.text": "12 سبتمبر 2027 · الأحد",
        "f1016.text": "حي الشفا، الطائف",
        "f1020.text": "الأسرة: ربى & ياسين الحديدي",
        "f1021.text": "تأكيد الحضور · 0532 245 90 37"
      },
      "de": {
        "f106.text": "EINLADUNG ZU MEVLID UND ESSEN",
        "f107.text": "Unser Sohn",
        "f108.text": "Hannes",
        "f109.text": "Zum Mevlid, das wir aus Freude über seine Beschneidung\nrezitieren lassen, und zum anschließenden\nEssen bitten wir um Ihr Kommen.",
        "f1010.text": "MEVLID",
        "f1011.text": "Nach dem Mittagsgebet\nAziziye-Moschee",
        "f1013.text": "ESSEN",
        "f1014.text": "14:00 Uhr\nDedeman Konya",
        "f1015.bind": "{day}. {month} {year} · {weekday}",
        "f1015.text": "12. September 2027 · Sonntag",
        "f1016.text": "ALTSTADT, ERFURT",
        "f1020.text": "Familie: Rabia & Yasin Çelik",
        "f1021.text": "RSVP · 0532 245 90 37"
      },
      "el": {
        "f106.text": "ΠΡΟΣΚΛΗΣΗ ΣΕ ΜΕΒΛΙΤ ΚΑΙ ΓΕΥΜΑ",
        "f107.text": "Ο γιος μας",
        "f108.text": "Θωμάς",
        "f109.text": "Σας παρακαλούμε να τιμήσετε με την παρουσία σας\nτο Μεβλίτ που θα διαβαστεί για τη χαρά της περιτομής του\nκαι το γεύμα που θα ακολουθήσει.",
        "f1010.text": "ΜΕΒΛΙΤ",
        "f1011.text": "Μετά τη μεσημεριανή προσευχή\nΤζαμί Αζιζιέ",
        "f1013.text": "ΓΕΥΜΑ",
        "f1014.text": "Ώρα 14:00\nΞενοδοχείο Ροδόπη",
        "f1015.text": "12 Σεπτεμβρίου 2027 · Κυριακή",
        "f1016.text": "ΚΕΝΤΡΟ, ΚΟΜΟΤΗΝΗ",
        "f1020.text": "Οικογένεια: Ρούλα & Γιάννης Σιδέρη",
        "f1021.text": "RSVP · 0532 245 90 37"
      },
      "en": {
        "f106.text": "MAWLID AND MEAL INVITATION",
        "f107.text": "Our son",
        "f108.text": "Hugo",
        "f109.text": "We kindly request your presence at the\nMawlid recitation we are holding in celebration of his\ncircumcision and at the meal that follows.",
        "f1010.text": "MAWLID",
        "f1011.text": "After the midday prayer\nAziziye Camii",
        "f1013.text": "MEAL",
        "f1014.text": "At 2:00 PM\nDedeman Konya",
        "f1015.text": "September 12, 2027 · Sunday",
        "f1016.text": "GERMAN VILLAGE, OH",
        "f1020.text": "Family: Rabia & Yasin Çelik",
        "f1021.text": "RSVP · 0532 245 90 37"
      },
      "es": {
        "f106.text": "INVITACIÓN AL MEVLID Y A LA COMIDA",
        "f107.text": "Nuestro hijo",
        "f108.text": "Marcos",
        "f109.text": "Con la alegría de su circuncisión,\nte rogamos que nos honres con tu presencia\nen el mevlid y en la comida posterior.",
        "f1010.text": "MEVLID",
        "f1011.text": "Tras la oración del mediodía\nMezquita de Aziziye",
        "f1013.text": "COMIDA",
        "f1014.text": "A las 14:00\nDedeman Konya",
        "f1015.bind": "{day} de {month} de {year} · {weekday}",
        "f1015.text": "12 de septiembre de 2027 · domingo",
        "f1016.text": "DELICIAS, ZARAGOZA",
        "f1020.text": "Su familia: Rabia & Yasin Çelik",
        "f1021.text": "RSVP · 0532 245 90 37"
      },
      "fr": {
        "f106.text": "INVITATION AU MEVLID ET AU REPAS",
        "f107.text": "Notre fils",
        "f108.text": "Henri",
        "f109.text": "Pour la lecture du Mevlid dans la joie de sa circoncision\net le repas qui suivra,\nnous vous prions de nous faire l’honneur de votre présence.",
        "f1010.text": "MEVLID",
        "f1011.text": "Après la prière du midi\nMosquée Aziziye",
        "f1013.text": "REPAS",
        "f1014.text": "14 h 00\nDedeman Konya",
        "f1015.text": "12 septembre 2027 · dimanche",
        "f1016.text": "SAINT-RÉMI, REIMS",
        "f1020.text": "Sa famille : Rabia & Yasin Çelik",
        "f1021.text": "RSVP · 0532 245 90 37"
      },
      "it": {
        "f106.text": "INVITO AL MAWLID E AL PRANZO",
        "f107.text": "Nostro figlio",
        "f108.text": "Giacomo",
        "f109.text": "Per la gioia della sua circoncisione ti invitiamo\nal Mawlid che faremo recitare\ne al pranzo che seguirà.",
        "f1010.text": "MAWLID",
        "f1011.text": "Dopo la preghiera di mezzogiorno\nMoschea Aziziye",
        "f1013.text": "PRANZO",
        "f1014.text": "Ore 14.00\nDedeman Konya",
        "f1015.text": "12 settembre 2027 · domenica",
        "f1016.text": "SAN SISTO, PERUGIA",
        "f1020.text": "Famiglia: Rabia & Yasin Çelik",
        "f1021.text": "RSVP · 0532 245 90 37"
      },
      "pt": {
        "f106.text": "CONVITE PARA O MEVLID E REFEIÇÃO",
        "f107.text": "O nosso filho",
        "f108.text": "Henrique",
        "f109.text": "Pela alegria da sua circuncisão,\npedimos a vossa presença no mevlid\nque mandaremos recitar e na refeição que se segue.",
        "f1010.text": "MEVLID",
        "f1011.text": "Depois da oração do meio-dia\nMesquita de Aziziye",
        "f1013.text": "REFEIÇÃO",
        "f1014.text": "Às 14h00\nHotel Paço Velho",
        "f1015.bind": "{day} de {month} de {year} · {weekday}",
        "f1015.text": "12 de setembro de 2027 · domingo",
        "f1016.text": "CENTRO HISTÓRICO, LEIRIA",
        "f1020.text": "Família: Rita & Tiago Correia",
        "f1021.text": "RSVP · 0532 245 90 37"
      },
      "ru": {
        "f106.text": "ПРИГЛАШЕНИЕ НА МЕВЛИД И ОБЕД",
        "f107.text": "Наш сын",
        "f108.text": "Захар",
        "f109.text": "Просим вас почтить своим присутствием мевлид-и шериф,\nкоторый мы прочтём в радости по случаю обрезания,\nи последующий обед.",
        "f1010.text": "МЕВЛИД",
        "f1011.text": "После полуденной молитвы\nмечеть Азизие",
        "f1013.text": "УГОЩЕНИЕ",
        "f1014.text": "В 14:00\nОтель «Волга»",
        "f1015.text": "12 сентября 2027 · воскресенье",
        "f1016.text": "СЕЛЬЧУКЛУ, КОНЬЯ",
        "f1020.text": "Семья: Рабия & Ясин Челик",
        "f1021.text": "RSVP · 0532 245 90 37"
      }
    },

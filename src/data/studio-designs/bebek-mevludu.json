    "translations": {
      "ar": {
        "bm8.text": "أنتم مدعوون إلى مجلس مولدنا",
        "bm9.text": "ابنتنا",
        "bm10.text": "إيمان ندى",
        "bm11.text": "شكراً لله على قدوم مولودنا إلى الدنيا،\nننتظركم في مجلس المولد الشريف.",
        "bm15.text": "10 أكتوبر 2027 · الأحد",
        "bm16.text": "بعد صلاة العصر",
        "bm17.text": "جامع الرحمن",
        "bm18.text": "حي الحمراء، جدة",
        "bm19.text": "بأطيب الأمنيات بعمر مبارك طويل وصحة وعافية",
        "bm20.text": "الوالدان: مروة & أنور النوري"
      },
      "de": {
        "bm8.text": "SIE SIND ZU UNSEREM MEVLID EINGELADEN",
        "bm9.text": "Unsere Tochter",
        "bm10.text": "Elisa Nele",
        "bm11.text": "Aus Dankbarkeit für seine Geburt\nlassen wir das Mevlid rezitieren; wir erwarten Sie.",
        "bm15.bind": "{day}. {month} {year} · {weekday}",
        "bm15.text": "10. Oktober 2027 · Sonntag",
        "bm16.text": "NACH DEM NACHMITTAGSGEBET",
        "bm17.text": "Fatih-Moschee",
        "bm18.text": "ALTONA, HAMBURG",
        "bm19.text": "Mit den besten Wünschen für ein langes, gesundes und gesegnetes Leben",
        "bm20.text": "Eltern: Merve & Onur Aydin"
      },
      "el": {
        "bm8.text": "ΣΑΣ ΠΡΟΣΚΑΛΟΥΜΕ ΣΤΟ ΜΕΒΛΙΤ ΜΑΣ",
        "bm9.text": "Η κόρη μας",
        "bm10.text": "Έλλη Νίνα",
        "bm11.text": "Σας περιμένουμε στο Μεβλίτ\nπου θα διαβαστεί ως ευχαριστία για τον ερχομό του στον κόσμο.",
        "bm15.text": "10 Οκτωβρίου 2027 · Κυριακή",
        "bm16.text": "ΜΕΤΑ ΤΗΝ ΑΠΟΓΕΥΜΑΤΙΝΗ ΠΡΟΣΕΥΧΗ",
        "bm17.text": "Τζαμί Γαλίπ Πασά",
        "bm18.text": "ΞΑΝΘΗ",
        "bm19.text": "Με ευχή για μια ευλογημένη, μακρά και υγιή ζωή",
        "bm20.text": "Γονείς: Μαρία & Όμηρος Ηλία"
      },
      "en": {
        "bm8.text": "YOU'RE INVITED TO OUR MAWLID",
        "bm9.text": "Our daughter",
        "bm10.text": "Ella Rose",
        "bm11.text": "We look forward to seeing you at the Mawlid\nrecitation we are holding in thanks for our baby's arrival.",
        "bm15.text": "October 10, 2027 · Sunday",
        "bm16.text": "AFTER THE AFTERNOON PRAYER",
        "bm17.text": "Cedar Grove Islamic Center",
        "bm18.text": "BROOKLYN, NEW YORK",
        "bm19.text": "With wishes for a blessed, long and healthy life",
        "bm20.text": "Parents: Megan & Owen Adams"
      },
      "es": {
        "bm8.text": "TE INVITAMOS A NUESTRO MEVLID",
        "bm9.text": "Nuestra hija",
        "bm10.text": "Elena Nora",
        "bm11.text": "Recitaremos el mevlid en acción de gracias\npor su llegada al mundo; te esperamos.",
        "bm15.bind": "{day} de {month} de {year} · {weekday}",
        "bm15.text": "10 de octubre de 2027 · domingo",
        "bm16.text": "DESPUÉS DE LA ORACIÓN DE LA TARDE",
        "bm17.text": "Mezquita de la Paz",
        "bm18.text": "GRÀCIA, BARCELONA",
        "bm19.text": "Con el deseo de una vida próspera, larga y saludable",
        "bm20.text": "Sus padres: Merve & Onur Aydin"
      },
      "fr": {
        "bm8.text": "VOUS ÊTES INVITÉS À NOTRE MEVLID",
        "bm9.text": "Notre fille",
        "bm10.text": "Elsa Lou",
        "bm11.text": "En gratitude pour sa venue au monde,\nnous vous attendons à la lecture du Mevlid.",
        "bm15.text": "10 octobre 2027 · dimanche",
        "bm16.text": "APRÈS LA PRIÈRE DE L’APRÈS-MIDI",
        "bm17.text": "Mosquée Al-Fath",
        "bm18.text": "LE MARAIS, PARIS",
        "bm19.text": "Pour une vie bénie, longue et en bonne santé",
        "bm20.text": "Ses parents : Merve & Onur Aydin"
      },
      "it": {
        "bm8.text": "TI INVITIAMO AL NOSTRO MAWLID",
        "bm9.text": "Nostra figlia",
        "bm10.text": "Annalisa",
        "bm11.text": "Ti aspettiamo al Mawlid che faremo recitare\nin ringraziamento per la sua nascita.",
        "bm15.text": "10 ottobre 2027 · domenica",
        "bm16.text": "DOPO LA PREGHIERA DEL POMERIGGIO",
        "bm17.text": "Moschea della Pace",
        "bm18.text": "NAVIGLI, MILANO",
        "bm19.text": "Con l'augurio di una vita lunga, serena e in salute",
        "bm20.text": "Genitori: Merve & Onur Aydin"
      },
      "pt": {
        "bm8.text": "ESTÃO CONVIDADOS PARA O NOSSO MEVLID",
        "bm9.text": "A nossa filha",
        "bm10.text": "Inês Maria",
        "bm11.text": "Em agradecimento pelo seu nascimento,\nmandaremos recitar o mevlid; contamos convosco.",
        "bm15.bind": "{day} de {month} de {year} · {weekday}",
        "bm15.text": "10 de outubro de 2027 · domingo",
        "bm16.text": "DEPOIS DA ORAÇÃO DA TARDE",
        "bm17.text": "Mesquita da Paz",
        "bm18.text": "CHIADO, LISBOA",
        "bm19.text": "Com votos de uma vida feliz, longa e saudável",
        "bm20.text": "Pais: Marisa & Otávio Lopes"
      },
      "ru": {
        "bm8.text": "ПРИГЛАШАЕМ ВАС НА НАШ МЕВЛИД",
        "bm9.text": "Наша дочь",
        "bm10.text": "Алиса",
        "bm11.text": "В благодарность за её появление на свет мы прочтём\nмевлид-и шериф — ждём и вас.",
        "bm15.text": "10 октября 2027 · воскресенье",
        "bm16.text": "ПОСЛЕ МОЛИТВЫ АСР",
        "bm17.text": "Мечеть «Ихлас»",
        "bm18.text": "АРБАТ, МОСКВА",
        "bm19.text": "С пожеланием счастливой, долгой и здоровой жизни",
        "bm20.text": "Родители: Мерве & Онур Айдын"
      }
    },

        "f2012.text": "Parents: Ella & Max Dawson",
        "f2013.text": "RSVP · 0532 715 08 46"
      },
      "es": {
        "f202.text": "¡LO TRAJO LA CIGÜEÑA!",
        "f203.text": "nuestro pequeño",
        "f204.text": "NICO",
        "f205.text": "12 DE AGOSTO DE 2027 · 3.250 G · 50 CM",

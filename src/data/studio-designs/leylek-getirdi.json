    "translations": {
      "ar": {
        "f202.text": "جاء اللقلق!",
        "f203.text": "ابننا الصغير",
        "f204.text": "كنان",
        "f205.text": "12 أغسطس 2027 · 3.250 غ · 50 سم",
        "f207.text": "نقيم في بيتنا حفل شاي صغيراً\nلتتعرّفوا إلى كنان؛\nونتمنى أن نراكم بيننا.",
        "f208.text": "25 سبتمبر 2027 · السبت",
        "f209.bind": "الساعة {time}",
        "f209.text": "الساعة 3:00 عصراً",
        "f2010.text": "مجمّع الدلب السكني، المبنى ب، الشقة 4",
        "f2011.text": "حي الشاطئ، الدمام",
        "f2012.text": "الوالدان: نغم & مازن الباز",
        "f2013.text": "تأكيد الحضور · 0532 715 08 46"
      },
      "de": {
        "f202.text": "DER STORCH WAR DA!",
        "f203.text": "unser kleiner Sohn",
        "f204.text": "KARL",
        "f205.text": "12. AUGUST 2027 · 3.250 G · 50 CM",
        "f207.text": "Damit Sie unseren Kuzey kennenlernen, laden wir\nzu einem kleinen Kennenlern-Tee zu uns nach Hause;\nwir würden uns freuen, Sie bei uns zu sehen.",
        "f208.bind": "{day}. {month} {year} · {weekday}",
        "f208.text": "25. September 2027 · Samstag",
        "f209.bind": "{time} UHR",
        "f209.text": "15:00 UHR",
        "f2010.text": "Platanenhof, Haus B, Wohnung 4",
        "f2011.text": "WIK, KIEL",
        "f2012.text": "Eltern: Ezgi & Mert Dogan",
        "f2013.text": "RSVP · 0532 715 08 46"
      },
      "el": {
        "f202.text": "ΕΦΤΑΣΕ Ο ΠΕΛΑΡΓΟΣ!",
        "f203.text": "ο μικρός μας γιος",
        "f204.text": "ΚΛΕΩΝ",
        "f205.text": "12 ΑΥΓΟΥΣΤΟΥ 2027 · 3.250 ΓΡ · 50 ΕΚ",
        "f207.text": "Δίνουμε ένα μικρό τσάι γνωριμίας στο σπίτι μας\nγια να γνωρίσετε τον Κλέωνα μας·\nθα θέλαμε να σας δούμε ανάμεσά μας.",
        "f208.text": "25 Σεπτεμβρίου 2027 · Σάββατο",
        "f209.bind": "ΩΡΑ {time}",
        "f209.text": "ΩΡΑ 15:00",
        "f2010.text": "Πλατάνου 10, Διαμ. 4",
        "f2011.text": "ΚΑΝΟΝΙ, ΚΕΡΚΥΡΑ",
        "f2012.text": "Γονείς: Έφη & Μάνος Δούκα",
        "f2013.text": "RSVP · 0532 715 08 46"
      },
      "en": {
        "f202.text": "THE STORK HAS DELIVERED!",
        "f203.text": "our little boy",
        "f204.text": "NOLAN",
        "f205.text": "AUGUST 12, 2027 · 3,250 G · 50 CM",
        "f207.text": "We're hosting a small get-to-know-you tea\nat home so you can meet our Kuzey;\nwe'd love to have you with us.",
        "f208.text": "September 25, 2027 · Saturday",
        "f209.bind": "AT {time}",

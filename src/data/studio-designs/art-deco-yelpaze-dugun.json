    "translations": {
      "ar": {
        "m011.text": "أنتم مدعوون إلى زفافنا",
        "m015.text": "جنى",
        "m017.text": "خالد",
        "m018.text": "في هذه الليلة التي نخطو فيها معاً نحو حياة جديدة،\nنتمنى أن نراكم بيننا.",
        "m0112.text": "سبتمبر",
        "m0114.bind": "{weekday} · الساعة {time}",
        "m0114.text": "السبت · الساعة 8:00 مساءً",
        "m0115.text": "سويس أوتيل الكورنيش",
        "m0116.text": "حي سموحة، الإسكندرية",
        "m0118.text": "تأكيد الحضور · 0533 412 87 90"
      },
      "de": {
        "m011.text": "SIE SIND ZU UNSERER HOCHZEIT EINGELADEN",
        "m015.text": "CLARA",
        "m017.text": "KAI",
        "m018.text": "An diesem Abend, an dem wir gemeinsam in ein neues Leben treten,\nmöchten wir Sie in unserer Mitte sehen.",
        "m0112.text": "SEPTEMBER",
        "m0114.bind": "{weekday} · {time} UHR",
        "m0114.text": "SAMSTAG · 20:00 UHR",
        "m0115.text": "Swissôtel Düsseldorf",
        "m0116.text": "MEDIENHAFEN · DÜSSELDORF",
        "m0118.text": "RSVP · 0533 412 87 90"
      },
      "el": {
        "m011.text": "ΣΑΣ ΠΡΟΣΚΑΛΟΥΜΕ ΣΤΟΝ ΓΑΜΟ ΜΑΣ",
        "m015.text": "ΧΛΟΗ",
        "m017.text": "ΚΩΣΤΑΣ",
        "m018.text": "Θα θέλαμε να σας δούμε ανάμεσά μας\nαυτή τη βραδιά που μπαίνουμε μαζί σε μια νέα ζωή.",
        "m0112.text": "ΕΛΙΝΑ",
        "m0114.bind": "{weekday} · ΩΡΑ {time}",
        "m0114.text": "ΣΑΒΒΑΤΟ · ΩΡΑ 20:00",
        "m0115.text": "Σουισοτέλ Πάτρα",
        "m0116.text": "ΑΓΥΙΑ · ΠΑΤΡΑ",
        "m0118.text": "RSVP · 0533 412 87 90"
      },
      "en": {
        "m011.text": "YOU'RE INVITED TO OUR WEDDING",
        "m015.text": "CLAIRE",
        "m017.text": "KEVIN",
        "m018.text": "On this night as we step into a new life together,\nwe'd love to have you with us.",
        "m0112.text": "SEPTEMBER",
        "m0114.bind": "{weekday} · {time}",
        "m0114.text": "SATURDAY · 8:00 PM",
        "m0115.text": "Harbor Grand Hotel",
        "m0116.text": "LITTLE ITALY · SAN DIEGO",
        "m0118.text": "RSVP · 0533 412 87 90"
      },
      "es": {
        "m011.text": "TE INVITAMOS A NUESTRA BODA",
        "m015.text": "CARMEN",
        "m017.text": "MATEO",
        "m018.text": "En esta noche en que damos juntos el primer paso\nhacia una nueva vida, queremos contar contigo.",
        "m0112.text": "SEPTIEMBRE",
        "m0114.bind": "{weekday} · A LAS {time}",
        "m0114.text": "SÁBADO · A LAS 20:00",
        "m0115.text": "Swissôtel Valencia",
        "m0116.text": "RUZAFA · VALENCIA",
        "m0118.text": "RSVP · 0533 412 87 90"
      },
      "fr": {
        "m011.text": "VOUS ÊTES INVITÉS À NOTRE MARIAGE",
        "m015.text": "CHLOÉ",
        "m017.text": "YANN",
        "m018.text": "Ce soir, nous entrons ensemble dans une nouvelle vie ;\nnous aimerions vous compter parmi nous.",
        "m0112.text": "AMBRE",
        "m0114.bind": "{weekday} · À {time}",
        "m0114.text": "SAMEDI · À 20 H 00",
        "m0115.text": "Swissôtel Nice",
        "m0116.text": "LE PORT · NICE",
        "m0118.text": "RSVP · 0533 412 87 90"
      },
      "it": {
        "m011.text": "TI INVITIAMO AL NOSTRO MATRIMONIO",
        "m015.text": "CHIARA",
        "m017.text": "LUCA",
        "m018.text": "In questa serata in cui iniziamo insieme una nuova vita,\nvorremmo averti con noi.",
        "m0112.text": "SETTEMBRE",
        "m0114.bind": "{weekday} · ORE {time}",
        "m0114.text": "SABATO · ORE 20.00",
        "m0115.text": "Swissôtel Genova",
        "m0116.text": "NERVI · GENOVA",
        "m0118.text": "RSVP · 0533 412 87 90"
      },
      "pt": {
        "m011.text": "ESTÃO CONVIDADOS PARA O NOSSO CASAMENTO",
        "m015.text": "CATARINA",
        "m017.text": "CARLOS",
        "m018.text": "Nesta noite em que damos juntos o passo para uma nova vida,\nqueremos ter-vos connosco.",
        "m0112.text": "SETEMBRO",
        "m0114.bind": "{weekday} · ÀS {time}",
        "m0114.text": "SÁBADO · ÀS 20H00",
        "m0115.text": "Swissôtel Lisboa",
        "m0116.text": "RIBEIRA · PORTO",
        "m0118.text": "RSVP · 0533 412 87 90"
      },
      "ru": {
        "m011.text": "ПРИГЛАШАЕМ ВАС НА НАШУ СВАДЬБУ",
        "m015.text": "ВЕРА",
        "m017.text": "ЕГОР",
        "m018.text": "Мы хотим видеть вас среди нас в этот вечер,\nкогда мы вместе делаем шаг в новую жизнь.",
        "m0112.text": "ЛИДИЯ",

    "translations": {
      "ar": {
        "m033.text": "إ&س",
        "m036.text": "إلى حفل عقد قراننا",
        "m037.text": "أنتم مدعوون",
        "m039.text": "إلهام",
        "m0310.text": "& سالم",
        "m0311.text": "نتمنى من القلب أن تكونوا\nشهوداً في هذا اليوم السعيد\nالذي نوقّع فيه عقدنا.",
        "m0312.text": "14 مايو 2027",
        "m0313.bind": "{weekday} · الساعة {time}",
        "m0313.text": "الجمعة · الساعة 5:00 عصراً",
        "m0314.text": "بيت البحيرة",
        "m0315.text": "الحمامات، تونس",
        "m0316.text": "تأكيد الحضور · 0544 271 39 06"
      },
      "de": {
        "m033.text": "I&B",
        "m036.text": "ZU UNSERER TRAUUNG",
        "m037.text": "Sie sind eingeladen",
        "m039.text": "Ilka",
        "m0310.text": "& Bastian",
        "m0311.text": "Wir wünschen uns von Herzen, dass Sie an diesem\nglücklichen Tag, an dem wir unterschreiben,\nunsere Zeugen sind.",
        "m0312.bind": "{day}. {month} {year}",
        "m0312.text": "14. Mai 2027",
        "m0313.bind": "{weekday} · {time} UHR",
        "m0313.text": "FREITAG · 17:00 UHR",
        "m0314.text": "Haus am See",
        "m0315.text": "Tegernsee, Bayern",
        "m0316.text": "RSVP · 0544 271 39 06"
      },
      "el": {
        "m033.text": "Ι&Β",
        "m036.text": "ΣΤΗΝ ΤΕΛΕΤΗ ΤΟΥ ΠΟΛΙΤΙΚΟΥ ΓΑΜΟΥ ΜΑΣ",
        "m037.text": "σας προσκαλούμε",
        "m039.text": "Ιλιάνα",
        "m0310.text": "& Βλάσης",
        "m0311.text": "Ευχόμαστε από καρδιάς να είστε μάρτυρές μας\nαυτή την ευτυχισμένη μέρα\nπου θα βάλουμε τις υπογραφές μας.",
        "m0312.text": "14 Μαΐου 2027",
        "m0313.bind": "{weekday} · ΩΡΑ {time}",
        "m0313.text": "ΠΑΡΑΣΚΕΥΗ · 17:00",
        "m0314.text": "Σπίτι στη Λίμνη",
        "m0315.text": "Νησί, Ιωάννινα",
        "m0316.text": "RSVP · 0544 271 39 06"
      },
      "en": {
        "m033.text": "I&B",
        "m036.text": "OUR CIVIL CEREMONY",
        "m037.text": "you're invited",
        "m039.text": "Irene",
        "m0310.text": "& Ben",
        "m0311.text": "On this happy day when we\nsign our names, we sincerely\nhope you will be our witnesses.",
        "m0312.text": "May 14, 2027",
        "m0313.bind": "{weekday} · {time}",
        "m0313.text": "FRIDAY · 5:00 PM",
        "m0314.text": "Lakeview Cottage",
        "m0315.text": "Lake Geneva, Wisconsin",
        "m0316.text": "RSVP · 0544 271 39 06"
      },
      "es": {
        "m033.text": "I&R",
        "m036.text": "A NUESTRA CEREMONIA CIVIL",
        "m037.text": "te invitamos",
        "m039.text": "Irene",
        "m0310.text": "& Rodrigo",
        "m0311.text": "De corazón, deseamos que seas\ntestigo de este feliz día\nen que firmaremos.",
        "m0312.bind": "{day} de {month} de {year}",
        "m0312.text": "14 de mayo de 2027",
        "m0313.bind": "{weekday} · A LAS {time}",
        "m0313.text": "VIERNES · A LAS 17:00",
        "m0314.text": "Casa del Lago",
        "m0315.text": "La Granja, Segovia",
        "m0316.text": "RSVP · 0544 271 39 06"
      },
      "fr": {
        "m033.text": "I&R",
        "m036.text": "À NOTRE CÉRÉMONIE CIVILE",
        "m037.text": "vous êtes invités",
        "m039.text": "Irène",
        "m0310.text": "& Rémi",
        "m0311.text": "Nous espérons de tout cœur\nque vous serez nos témoins\nen ce jour heureux de notre signature.",
        "m0312.text": "14 mai 2027",
        "m0313.bind": "{weekday} · À {time}",
        "m0313.text": "VENDREDI · À 17 H 00",
        "m0314.text": "Maison du Lac",
        "m0315.text": "Talloires, Annecy",
        "m0316.text": "RSVP · 0544 271 39 06"
      },
      "it": {
        "m033.text": "I&B",
        "m036.text": "AL NOSTRO RITO CIVILE",
        "m037.text": "ti invitiamo",
        "m039.text": "Ilaria",
        "m0310.text": "& Bruno",
        "m0311.text": "In questo giorno felice,\nin cui apporremo le nostre firme,\nvorremmo davvero averti come testimone.",
        "m0312.text": "14 maggio 2027",
        "m0313.bind": "{weekday} · ORE {time}",
        "m0313.text": "VENERDÌ · ORE 17.00",
        "m0314.text": "Casa sul Lago",
        "m0315.text": "Stresa, Piemonte",
        "m0316.text": "RSVP · 0544 271 39 06"
      },
      "pt": {
        "m033.text": "I&B",
        "m036.text": "À NOSSA CERIMÓNIA CIVIL",
        "m037.text": "estão convidados",
        "m039.text": "Ilda",
        "m0310.text": "& Rodrigo",
        "m0311.text": "Desejamos de coração que sejam\ntestemunhas do dia feliz em\nque assinaremos o nosso «sim».",
        "m0312.bind": "{day} de {month} de {year}",
        "m0312.text": "14 de maio de 2027",
        "m0313.bind": "{weekday} · ÀS {time}",
        "m0313.text": "SEXTA-FEIRA · ÀS 17H00",
        "m0314.text": "Casa do Lago",
        "m0315.text": "Alqueva, Beja",
        "m0316.text": "RSVP · 0544 271 39 06"
      },
      "ru": {
        "m033.text": "И&Б",
        "m036.text": "НА НАШУ ЦЕРЕМОНИЮ БРАКОСОЧЕТАНИЯ",
        "m037.text": "приглашаем вас",
        "m039.text": "Илона",
        "m0310.text": "& Богдан",
        "m0311.text": "Мы от всего сердца хотим, чтобы\nв этот счастливый день, когда мы\nпоставим подписи, вы были нашими свидетелями.",
        "m0312.text": "14 мая 2027",
        "m0313.bind": "{weekday} · В {time}",
        "m0313.text": "ПЯТНИЦА · 17:00",
        "m0314.text": "Дом у озера",
        "m0315.text": "Валдай",
        "m0316.text": "RSVP · 0544 271 39 06"
      }

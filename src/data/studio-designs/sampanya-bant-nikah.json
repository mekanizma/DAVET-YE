    "translations": {
      "ar": {
        "m194.text": "بسمة & سليم",
        "m195.text": "أنتم مدعوون إلى حفل عقد قراننا",
        "m196.text": "بحضور عائلتينا وبشهادتكم\nنجمع حياتنا.",
        "m197.text": "التاريخ",
        "m198.text": "18 يونيو 2027، الجمعة",
        "m199.text": "الساعة",
        "m1911.text": "المكان",
        "m1912.text": "قاعة عقد القران في البلدية",
        "m1913.text": "حي الحمرا، بيروت",
        "m1917.text": "بعد عقد القران سنقيم\nاحتفالاً صغيراً مع أحبّائنا.",
        "m1919.text": "تأكيد الحضور · 0542 663 08 47"
      },
      "de": {
        "m194.text": "Helena & Simon",
        "m195.text": "SIE SIND ZU UNSERER TRAUUNG EINGELADEN",
        "m196.text": "Im Beisein unserer Familien und mit Ihnen als Zeugen\nvereinen wir unsere Leben.",
        "m197.text": "DATUM",
        "m198.bind": "{day}. {month} {year}, {weekday}",
        "m198.text": "18. Juni 2027, Freitag",
        "m199.text": "UHRZEIT",
        "m1911.text": "ORT",
        "m1912.text": "Standesamt",
        "m1913.text": "Neustadt, Celle",
        "m1917.text": "Nach der Trauung feiern wir\nim kleinen Kreis mit unseren Liebsten.",
        "m1919.text": "RSVP · 0542 663 08 47"
      },
      "el": {
        "m194.text": "Χαρά & Σάββας",
        "m195.text": "ΣΑΣ ΠΡΟΣΚΑΛΟΥΜΕ ΣΤΗΝ ΤΕΛΕΤΗ ΤΟΥ ΠΟΛΙΤΙΚΟΥ ΓΑΜΟΥ ΜΑΣ",
        "m196.text": "Ενώνουμε τις ζωές μας μπροστά στις οικογένειές μας\nκαι με εσάς ως μάρτυρες.",
        "m197.text": "ΗΜΕΡΟΜΗΝΙΑ",
        "m198.text": "18 Ιουνίου 2027, Παρασκευή",
        "m199.text": "ΩΡΑ",
        "m1911.text": "ΧΩΡΟΣ",
        "m1912.text": "Δημαρχείο",
        "m1913.text": "Ηράκλεια, Σέρρες",
        "m1917.text": "Μετά τον πολιτικό γάμο θα κάνουμε\nμια μικρή γιορτή με τους αγαπημένους μας.",
        "m1919.text": "RSVP · 0542 663 08 47"
      },
      "en": {
        "m194.text": "Hannah & Sam",
        "m195.text": "YOU'RE INVITED TO OUR CIVIL CEREMONY",
        "m196.text": "In the presence of our families and with you as our witnesses,\nwe are joining our lives.",
        "m197.text": "DATE",
        "m198.text": "June 18, 2027, Friday",
        "m199.text": "TIME",
        "m1911.text": "VENUE",
        "m1912.text": "City Hall",
        "m1913.text": "Alamo Heights, San Antonio",
        "m1917.text": "After the civil ceremony, we'll have a small\ncelebration with our loved ones.",
        "m1919.text": "RSVP · 0542 663 08 47"
      },
      "es": {
        "m194.text": "Helena & Samuel",
        "m195.text": "TE INVITAMOS A NUESTRA CEREMONIA CIVIL",
        "m196.text": "Ante nuestras familias y contigo como testigo,\nunimos nuestras vidas.",
        "m197.text": "FECHA",
        "m198.bind": "{day} de {month} de {year}, {weekday}",
        "m198.text": "18 de junio de 2027, viernes",
        "m199.text": "HORA",
        "m1911.text": "LUGAR",
        "m1912.text": "Registro Civil",
        "m1913.text": "Ciudad Jardín, Córdoba",
        "m1917.text": "Tras la ceremonia civil haremos una pequeña\ncelebración con nuestros seres queridos.",
        "m1919.text": "RSVP · 0542 663 08 47"
      },
      "fr": {
        "m194.text": "Hanna & Simon",
        "m195.text": "VOUS ÊTES INVITÉS À NOTRE CÉRÉMONIE CIVILE",
        "m196.text": "En présence de nos familles et devant vous tous,\nnous unissons nos vies.",
        "m197.text": "DATE",
        "m198.text": "18 juin 2027, vendredi",
        "m199.text": "HEURE",
        "m1911.text": "LIEU",
        "m1912.text": "Salle des mariages",
        "m1913.text": "Montfavet, Avignon",
        "m1917.text": "Après la cérémonie civile, nous fêterons\navec nos proches en petit comité.",
        "m1919.text": "RSVP · 0542 663 08 47"
      },
      "it": {
        "m194.text": "Gaia & Simone",
        "m195.text": "TI INVITIAMO AL NOSTRO RITO CIVILE",
        "m196.text": "Davanti alle nostre famiglie e con te come testimone,\nuniamo le nostre vite.",
        "m197.text": "DATA",
        "m198.text": "18 giugno 2027, venerdì",
        "m199.text": "ORA",
        "m1911.text": "LUOGO",
        "m1912.text": "Sala nozze del Comune",
        "m1913.text": "Mondello, Palermo",
        "m1917.text": "Dopo il rito civile faremo\nuna piccola festa con i nostri cari.",
        "m1919.text": "RSVP · 0542 663 08 47"
      },
      "pt": {
        "m194.text": "Helena & Sebastião",
        "m195.text": "ESTÃO CONVIDADOS PARA A NOSSA CERIMÓNIA CIVIL",
        "m196.text": "Na presença das nossas famílias e tendo-vos como testemunhas,\nunimos as nossas vidas.",
        "m197.text": "DATA",
        "m198.bind": "{day} de {month} de {year}, {weekday}",
        "m198.text": "18 de junho de 2027, sexta-feira",
        "m199.text": "HORA",
        "m1911.text": "LOCAL",
        "m1912.text": "Salão Nobre dos Paços do Concelho",
        "m1913.text": "Foz do Douro, Porto",
        "m1917.text": "Depois da cerimónia civil faremos uma pequena\ncelebração com os nossos entes queridos.",
        "m1919.text": "RSVP · 0542 663 08 47"
      },
      "ru": {
        "m194.text": "Агния & Семён",
        "m195.text": "ПРИГЛАШАЕМ ВАС НА НАШУ ЦЕРЕМОНИЮ БРАКОСОЧЕТАНИЯ",
        "m196.text": "В присутствии наших семей и при вашем свидетельстве\nмы соединяем наши жизни.",
        "m197.text": "ДАТА",
        "m198.text": "18 июня 2027, пятница",
        "m199.text": "ВРЕМЯ",
        "m1911.text": "МЕСТО",
        "m1912.text": "Зал бракосочетаний мэрии",
        "m1913.text": "Левобережный р-н, Воронеж",
        "m1917.text": "После церемонии бракосочетания мы устроим\nнебольшое торжество с близкими.",
        "m1919.text": "RSVP · 0542 663 08 47"
      }
    },

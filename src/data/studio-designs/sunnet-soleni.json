    "translations": {
      "ar": {
        "sn9.text": "أنتم مدعوون إلى حفل ختاننا",
        "sn10.text": "ابننا",
        "sn12.text": "علي كريم",
        "sn13.text": "نودّ أن نتشارك معكم فرحتنا بخطوته الأولى\nنحو الرجولة في هذا اليوم السعيد.",
        "sn14.text": "4 يوليو 2027 · الأحد",
        "sn15.bind": "الساعة {time}",
        "sn15.text": "الساعة 19.00",
        "sn17.text": "هيلتون جدة · قاعة الاحتفالات",
        "sn18.text": "حي الزهراء، جدة",
        "sn19.text": "الأسرة: عائشة & محمد الأحمد",
        "sn20.text": "تأكيد الحضور · 0532 123 45 67"
      },
      "de": {
        "sn9.text": "SIE SIND ZU UNSERER BESCHNEIDUNGSFEIER EINGELADEN",
        "sn10.text": "Unser Sohn",
        "sn12.text": "Adam Kilian",
        "sn13.text": "Am glücklichen Tag, an dem er den ersten Schritt zum Mann tut,\nmöchten wir unsere Freude mit Ihnen teilen.",
        "sn14.bind": "{day}. {month} {year} · {weekday}",
        "sn14.text": "4. Juli 2027 · Sonntag",
        "sn15.bind": "{time} UHR",
        "sn15.text": "19:00 UHR",
        "sn17.text": "Hilton Frankfurt Ballsaal",
        "sn18.text": "SISLI, ISTANBUL",
        "sn19.text": "Familie: Ayse & Mehmet Yilmaz",
        "sn20.text": "RSVP · 0532 123 45 67"
      },
      "el": {
        "sn9.text": "ΣΑΣ ΠΡΟΣΚΑΛΟΥΜΕ ΣΤΗ ΓΙΟΡΤΗ ΠΕΡΙΤΟΜΗΣ ΜΑΣ",
        "sn10.text": "Ο γιος μας",
        "sn12.text": "Άρης Κίμων",
        "sn13.text": "Θα θέλαμε να μοιραστούμε μαζί σας τη χαρά μας\nγια αυτή την ευτυχισμένη μέρα που κάνει το πρώτο του βήμα προς την ανδρική ηλικία.",
        "sn14.text": "4 Ιουλίου 2027 · Κυριακή",
        "sn15.bind": "ΩΡΑ {time}",
        "sn15.text": "ΩΡΑ 19:00",
        "sn17.text": "Χίλτον Αθήνα · Αίθουσα χορού",
        "sn18.text": "ΧΑΛΑΝΔΡΙ, ΑΘΗΝΑ",
        "sn19.text": "Οικογένεια: Άννα & Μάρκος Παύλου",
        "sn20.text": "RSVP · 0532 123 45 67"
      },
      "en": {
        "sn9.text": "YOU'RE INVITED TO OUR CIRCUMCISION CELEBRATION",
        "sn10.text": "Our son",
        "sn12.text": "Adrian Kyle",
        "sn13.text": "On this happy day of his first step into manhood,\nwe'd like to share our joy with you.",
        "sn14.text": "July 4, 2027 · Sunday",
        "sn15.bind": "AT {time}",
        "sn15.text": "AT 7:00 PM",
        "sn17.text": "Hilton Grand Ballroom",
        "sn18.text": "MIDTOWN, NEW YORK",
        "sn19.text": "Family: Emma & James Young",
        "sn20.text": "RSVP · 0532 123 45 67"
      },
      "es": {
        "sn9.text": "TE INVITAMOS A NUESTRA FIESTA DE CIRCUNCISIÓN",
        "sn10.text": "Nuestro hijo",
        "sn12.text": "Luis Carlos",
        "sn13.text": "Queremos compartir contigo la alegría de este feliz día\nen que da su primer paso hacia la hombría.",
        "sn14.bind": "{day} de {month} de {year} · {weekday}",
        "sn14.text": "4 de julio de 2027 · domingo",
        "sn15.bind": "A LAS {time}",
        "sn15.text": "A LAS 19:00",
        "sn17.text": "Hilton Barcelona · Salón de baile",
        "sn18.text": "SISLI, ISTANBUL",
        "sn19.text": "Su familia: Ayse & Mehmet Yilmaz",
        "sn20.text": "RSVP · 0532 123 45 67"
      },
      "fr": {
        "sn9.text": "VOUS ÊTES INVITÉS À NOTRE FÊTE DE CIRCONCISION",
        "sn10.text": "Notre fils",
        "sn12.text": "Élie Kévin",
        "sn13.text": "En ce jour heureux où il fait son premier pas vers l’âge d’homme,\nnous aimerions partager notre joie avec vous.",
        "sn14.text": "4 juillet 2027 · dimanche",
        "sn15.bind": "À {time}",
        "sn15.text": "À 19 H 00",
        "sn17.text": "Hilton Paris · Salle de bal",
        "sn18.text": "SISLI, ISTANBUL",
        "sn19.text": "Sa famille : Ayse & Mehmet Yilmaz",
        "sn20.text": "RSVP · 0532 123 45 67"
      },
      "it": {
        "sn9.text": "TI INVITIAMO ALLA NOSTRA FESTA DELLA CIRCONCISIONE",
        "sn10.text": "Nostro figlio",
        "sn12.text": "Gianluca",
        "sn13.text": "Nel giorno felice in cui compie il suo primo passo verso l'età adulta,\nvorremmo condividere con te la nostra gioia.",
        "sn14.text": "4 luglio 2027 · domenica",
        "sn15.bind": "ORE {time}",
        "sn15.text": "ORE 19.00",
        "sn17.text": "Hilton Milano · Sala da ballo",
        "sn18.text": "SISLI, ISTANBUL",
        "sn19.text": "Famiglia: Ayse & Mehmet Yilmaz",
        "sn20.text": "RSVP · 0532 123 45 67"
      },
      "pt": {
        "sn9.text": "ESTÃO CONVIDADOS PARA A NOSSA FESTA DA CIRCUNCISÃO",
        "sn10.text": "O nosso filho",
        "sn12.text": "Rui Duarte",
        "sn13.text": "Neste dia feliz do seu primeiro passo para a idade adulta,\nqueremos partilhar convosco a nossa alegria.",
        "sn14.bind": "{day} de {month} de {year} · {weekday}",
        "sn14.text": "4 de julho de 2027 · domingo",
        "sn15.bind": "ÀS {time}",
        "sn15.text": "ÀS 19H00",
        "sn17.text": "Hilton Lisboa · Salão de Baile",
        "sn18.text": "AVENIDAS NOVAS, LISBOA",
        "sn19.text": "Família: Ana & Manuel Almeida",
        "sn20.text": "RSVP · 0532 123 45 67"
      },
      "ru": {
        "sn9.text": "ПРИГЛАШАЕМ ВАС НА НАШ ПРАЗДНИК ОБРЕЗАНИЯ",
        "sn10.text": "Наш сын",
        "sn12.text": "Алексей",
        "sn13.text": "В этот счастливый день, когда он делает первый шаг к мужественности,\nмы хотим разделить с вами нашу радость.",
        "sn14.text": "4 июля 2027 · воскресенье",
        "sn15.bind": "В {time}",
        "sn15.text": "В 19:00",
        "sn17.text": "Хилтон Москва · Бальный зал",
        "sn18.text": "ШИШЛИ, СТАМБУЛ",
        "sn19.text": "Семья: Айше & Мехмет Йылмаз",
        "sn20.text": "RSVP · 0532 123 45 67"

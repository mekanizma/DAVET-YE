    "translations": {
      "ar": {
        "p061.text": "أصدقائي الأعزاء",
        "p062.text": "حفل الحديقة",
        "p063.text": "عيد ميلاد ميساء الـ35",
        "p067.text": "عصر يوم في ظلال أزهار البوغنفيليا،\nمع الليموناضة والموسيقى؛\nوأتمنى أن أراكم بيننا.",
        "p068.text": "3 يوليو 2027",
        "p069.bind": "{weekday} · الساعة {time}",
        "p069.text": "السبت · الساعة 5:00 عصراً",
        "p0611.text": "حديقة شجرة الليمون",
        "p0612.text": "برج العرب، الإسكندرية",
        "p0613.text": "لا تنسوا قبعتكم القشية\nوروحكم المرحة.",
        "p0614.text": "تأكيد الحضور · 0532 386 40 52"
      },
      "de": {
        "p061.text": "LIEBE FREUNDE",
        "p062.text": "Gartenparty",
        "p063.text": "Melis' 35. Geburtstag",
        "p067.text": "Ein Nachmittag im Schatten der Bougainvilleen, bei Limonade\nund Musik; ich würde mich freuen,\nSie in unserer Mitte zu sehen.",
        "p068.bind": "{day}. {month} {year}",
        "p068.text": "3. JULI 2027",
        "p069.bind": "{weekday} · {time} UHR",
        "p069.text": "SAMSTAG · 17:00 UHR",
        "p0611.text": "Orangerie Garten",
        "p0612.text": "RHEINGAU, HESSEN",
        "p0613.text": "Vergessen Sie Ihren Strohhut und\nIhre beste Laune nicht.",
        "p0614.text": "RSVP · 0532 386 40 52"
      },
      "el": {
        "p061.text": "ΑΓΑΠΗΜΕΝΟΙ ΜΟΥ ΦΙΛΟΙ",
        "p062.text": "Πάρτι στον κήπο",
        "p063.text": "Τα 35α γενέθλια της Μάρθας",
        "p067.text": "Ένα απόγευμα με λεμονάδα και μουσική\nστη σκιά των βουκαμβιλιών·\nθα ήθελα πολύ να σας δω ανάμεσά μας.",
        "p068.text": "3 ΙΟΥΛΙΟΥ 2027",
        "p069.bind": "{weekday} · ΩΡΑ {time}",
        "p069.text": "ΣΑΒΒΑΤΟ · ΩΡΑ 17:00",
        "p0611.text": "Κήπος Λεμονιάς",
        "p0612.text": "ΡΙΟ, ΠΑΤΡΑ",
        "p0613.text": "Μην ξεχάσετε το ψάθινο καπέλο σας\nκαι την πιο χαρούμενη διάθεσή σας.",
        "p0614.text": "RSVP · 0532 386 40 52"
      },
      "en": {
        "p061.text": "DEAR FRIENDS",
        "p062.text": "Garden Party",
        "p063.text": "Melis's 35th birthday",
        "p067.text": "An afternoon in the shade of bougainvillea,\nwith lemonade and music;\nI'd love to have you with us.",
        "p068.text": "JULY 3, 2027",
        "p069.bind": "{weekday} · {time}",
        "p069.text": "SATURDAY · 5:00 PM",
        "p0611.text": "Lemon Tree Garden",
        "p0612.text": "NAPA, CALIFORNIA",
        "p0613.text": "Don't forget to bring your straw hat\nand your cheeriest self.",
        "p0614.text": "RSVP · 0532 386 40 52"
      },
      "es": {
        "p061.text": "QUERIDOS AMIGOS",
        "p062.text": "Fiesta en el jardín",
        "p063.text": "35.º cumpleaños de Melis",
        "p067.text": "Una tarde a la sombra de las buganvillas,\ncon limonada y música;\nme encantaría contar contigo.",
        "p068.bind": "{day} de {month} de {year}",
        "p068.text": "3 DE JULIO DE 2027",
        "p069.bind": "{weekday} · A LAS {time}",
        "p069.text": "SÁBADO · A LAS 17:00",
        "p0611.text": "Jardín del Limonero",
        "p0612.text": "REQUENA, VALENCIA",
        "p0613.text": "No olvides tu sombrero de paja\ny tu versión más alegre.",
        "p0614.text": "RSVP · 0532 386 40 52"
      },
      "fr": {
        "p061.text": "MES CHERS AMIS",
        "p062.text": "Garden-party",
        "p063.text": "Les 35 ans de Melis",
        "p067.text": "Un après-midi à l’ombre des bougainvilliers,\nau son de la musique, avec de la limonade ;\nje souhaite vous compter parmi nous.",
        "p068.text": "3 JUILLET 2027",
        "p069.bind": "{weekday} · À {time}",
        "p069.text": "SAMEDI · À 17 H 00",
        "p0611.text": "Jardin du Citronnier",
        "p0612.text": "BELLET, NICE",
        "p0613.text": "N’oubliez pas votre chapeau de paille\net votre plus belle humeur.",
        "p0614.text": "RSVP · 0532 386 40 52"
      },
      "it": {
        "p061.text": "CARI AMICI",
        "p062.text": "Festa in giardino",
        "p063.text": "35º compleanno di Melis",
        "p067.text": "Un pomeriggio all'ombra delle buganvillee,\ntra limonata e musica:\nvorrei averti con noi.",
        "p068.text": "3 LUGLIO 2027",
        "p069.bind": "{weekday} · ORE {time}",
        "p069.text": "SABATO · ORE 17.00",
        "p0611.text": "Giardino della Limonaia",
        "p0612.text": "SORI, GENOVA",
        "p0613.text": "Non dimenticare il cappello di paglia\ne il tuo lato più allegro.",
        "p0614.text": "RSVP · 0532 386 40 52"
      },
      "pt": {
        "p061.text": "QUERIDOS AMIGOS",
        "p062.text": "Festa no Jardim",
        "p063.text": "35.º aniversário da Mariana",
        "p067.text": "Uma tarde à sombra das buganvílias, com limonada\ne música; gostaria\nde contar com a vossa presença.",
        "p068.bind": "{day} de {month} de {year}",
        "p068.text": "3 DE JULHO DE 2027",
        "p069.bind": "{weekday} · ÀS {time}",
        "p069.text": "SÁBADO · ÀS 17H00",
        "p0611.text": "Jardim do Limoeiro",
        "p0612.text": "DOURO VINHATEIRO, PESO DA RÉGUA",
        "p0613.text": "Não se esqueçam do chapéu de palha\ne do vosso melhor humor.",
        "p0614.text": "RSVP · 0532 386 40 52"
      },
      "ru": {
        "p061.text": "ДОРОГИЕ ДРУЗЬЯ",
        "p062.text": "Вечеринка в саду",
        "p063.text": "35-летие Мелис",
        "p067.text": "После полудня в тени бугенвиллей\nпод лимонад и музыку;\nя хочу видеть вас среди нас.",
        "p068.text": "3 ИЮЛЯ 2027",
        "p069.bind": "{weekday} · В {time}",
        "p069.text": "СУББОТА · 17:00",
        "p0611.text": "Лимонный сад",
        "p0612.text": "ТАМАНЬ, КУБАНЬ",
        "p0613.text": "Не забудьте соломенную шляпу\nи самое весёлое настроение.",
        "p0614.text": "RSVP · 0532 386 40 52"
      }

    "translations": {
      "ar": {
        "h073.text": "أنتم مدعوون إلى ليلة حنائنا",
        "h075.text": "هلا",
        "h076.text": "ليلة الحناء",
        "h077.text": "لنزيّن يدي ابنتنا بالحناء معاً،\nولنعزف ونغنّي معاً.",
        "h0711.text": "13 مايو 2027 · الخميس",
        "h0712.bind": "الساعة {time}",
        "h0712.text": "الساعة 20.00",
        "h0713.text": "قصر السكينة",
        "h0714.text": "حي الحصن، إربد",
        "h0715.text": "تأكيد الحضور · 0555 207 34 91"
      },
      "de": {
        "h073.text": "SIE SIND ZU UNSEREM HENNA-ABEND EINGELADEN",
        "h075.text": "Hannah",
        "h076.text": "HENNA-ABEND",
        "h077.text": "Lassen Sie uns das Henna unserer Tochter gemeinsam feiern,\nlassen Sie uns gemeinsam zur Saz singen.",
        "h0711.bind": "{day}. {month} {year} · {weekday}",
        "h0711.text": "13. Mai 2027 · Donnerstag",
        "h0712.bind": "{time} UHR",
        "h0712.text": "20:00 UHR",
        "h0713.text": "Gutshaus Ruhe",
        "h0714.text": "Altstadt, Bamberg",
        "h0715.text": "RSVP · 0555 207 34 91"
      },
      "el": {
        "h073.text": "ΣΑΣ ΠΡΟΣΚΑΛΟΥΜΕ ΣΤΗ ΒΡΑΔΙΑ ΧΕΝΝΑΣ ΜΑΣ",
        "h075.text": "Ηρώ",
        "h076.text": "ΒΡΑΔΙΑ ΧΕΝΝΑΣ",
        "h077.text": "Ας βάψουμε μαζί τη χέννα της κόρης μας,\nας τραγουδήσουμε μαζί τα τραγούδια μας.",
        "h0711.text": "13 Μαΐου 2027 · Πέμπτη",
        "h0712.bind": "ΩΡΑ {time}",
        "h0712.text": "ΩΡΑ 20:00",
        "h0713.text": "Αρχοντικό Ηρεμία",
        "h0714.text": "Βαρούσι, Τρίκαλα",
        "h0715.text": "RSVP · 0555 207 34 91"
      },
      "en": {
        "h073.text": "YOU'RE INVITED TO OUR HENNA NIGHT",
        "h075.text": "Luna",
        "h076.text": "HENNA NIGHT",
        "h077.text": "Let's apply our daughter's henna together,\nand sing our songs and verses together.",
        "h0711.text": "May 13, 2027 · Thursday",
        "h0712.bind": "AT {time}",
        "h0712.text": "AT 8:00 PM",
        "h0713.text": "Serene Manor",
        "h0714.text": "Ann Arbor, Michigan",
        "h0715.text": "RSVP · 0555 207 34 91"
      },
      "es": {
        "h073.text": "TE INVITAMOS A NUESTRA NOCHE DE HENNA",
        "h075.text": "Julia",
        "h076.text": "NOCHE DE HENNA",
        "h077.text": "Pongamos juntos la henna a nuestra hija,\ny cantemos y toquemos juntos.",
        "h0711.bind": "{day} de {month} de {year} · {weekday}",
        "h0711.text": "13 de mayo de 2027 · jueves",
        "h0712.bind": "A LAS {time}",
        "h0712.text": "A LAS 20:00",
        "h0713.text": "Casona Sosiego",
        "h0714.text": "Casco Antiguo, Salamanca",
        "h0715.text": "RSVP · 0555 207 34 91"
      },
      "fr": {
        "h073.text": "VOUS ÊTES INVITÉS À NOTRE SOIRÉE DU HENNÉ",
        "h075.text": "Lucie",
        "h076.text": "SOIRÉE DU HENNÉ",
        "h077.text": "Posons ensemble le henné de notre fille,\net partageons ensemble la musique et les chants.",
        "h0711.text": "13 mai 2027 · jeudi",
        "h0712.bind": "À {time}",
        "h0712.text": "À 20 H 00",
        "h0713.text": "Manoir Alice",
        "h0714.text": "Vieille ville, Dijon",
        "h0715.text": "RSVP · 0555 207 34 91"
      },
      "it": {
        "h073.text": "TI INVITIAMO ALLA NOSTRA NOTTE DELL'HENNÉ",
        "h075.text": "Livia",
        "h076.text": "NOTTE DELL'HENNÉ",
        "h077.text": "Applichiamo insieme l'henné a nostra figlia,\nsuoniamo e cantiamo tutti insieme.",
        "h0711.text": "13 maggio 2027 · giovedì",
        "h0712.bind": "ORE {time}",
        "h0712.text": "ORE 20.00",
        "h0713.text": "Villa Serena",
        "h0714.text": "Oltretorrente, Parma",
        "h0715.text": "RSVP · 0555 207 34 91"
      },
      "pt": {
        "h073.text": "ESTÃO CONVIDADOS PARA A NOSSA NOITE DA HENA",
        "h075.text": "Hélia",
        "h076.text": "NOITE DA HENA",
        "h077.text": "Celebremos juntos a hena da nossa filha,\ncantemos juntos as nossas canções ao som do saz.",
        "h0711.bind": "{day} de {month} de {year} · {weekday}",
        "h0711.text": "13 de maio de 2027 · quinta-feira",
        "h0712.bind": "ÀS {time}",
        "h0712.text": "ÀS 20H00",
        "h0713.text": "Solar do Sossego",
        "h0714.text": "Casco Antigo, Guimarães",
        "h0715.text": "RSVP · 0555 207 34 91"
      },
      "ru": {
        "h073.text": "ПРИГЛАШАЕМ ВАС НА НАШ ВЕЧЕР ХНЫ",
        "h075.text": "Тамара",
        "h076.text": "ВЕЧЕР ХНЫ",
        "h077.text": "Давайте вместе нанесём хну нашей дочери,\nвместе споём наши песни под саз.",
        "h0711.text": "13 мая 2027 · четверг",
        "h0712.bind": "В {time}",
        "h0712.text": "В 20:00",
        "h0713.text": "Усадьба «Тишина»",
        "h0714.text": "Советский р-н, Томск",
        "h0715.text": "RSVP · 0555 207 34 91"
      }

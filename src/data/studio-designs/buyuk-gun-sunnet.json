    "translations": {
      "ar": {
        "f075.text": "ابننا",
        "f076.text": "علي",
        "f077.text": "حفل",
        "f078.text": "الختان",
        "f0710.text": "أغسطس 2027",
        "f0711.text": "السبت",
        "f0714.text": "نودّ أن نتشارك معكم فرحتنا بهذا اليوم الكبير في حياة ابننا، وأن نحتفل معاً بهذه الأمسية السعيدة.",
        "f0715.text": "الساعة",
        "f0717.text": "المكان",
        "f0718.text": "هيلتون الشارقة، قاعة الاحتفالات\nحي المجاز، الشارقة",
        "f0720.text": "الأسرة: روضة & أحمد الفولاذي",
        "f0721.text": "تأكيد الحضور · 0532 318 72 05"
      },
      "de": {
        "f075.text": "UNSER SOHN",
        "f076.text": "ALIS",
        "f077.text": "BESCHNEIDUNGS-",
        "f078.text": "FEIER",
        "f0710.text": "AUGUST 2027",
        "f0711.text": "SAMSTAG",
        "f0714.text": "Wir möchten unsere Freude über diesen großen Tag im Leben unseres Sohnes mit Ihnen teilen und den glücklichen Abend gemeinsam feiern.",
        "f0715.text": "UHRZEIT",
        "f0717.text": "ORT",
        "f0718.text": "Hilton München Ballsaal\nSchwabing, München",
        "f0720.text": "Familie: Gülsen & Ahmet Polat",
        "f0721.text": "RSVP · 0532 318 72 05"
      },
      "el": {
        "f075.text": "Ο ΓΙΟΣ ΜΑΣ",
        "f076.text": "ΤΟΥ ΑΛΗ",
        "f077.text": "ΓΙΟΡΤΗ",
        "f078.text": "ΠΕΡΙΤΟΜΗΣ",
        "f0710.text": "ΑΥΓΟΥΣΤΟΣ 2027",
        "f0711.text": "ΣΑΒΒΑΤΟ",
        "f0714.text": "Θα θέλαμε να μοιραστούμε τη χαρά μας μαζί σας για τη μεγάλη αυτή μέρα στη ζωή του γιου μας και να γιορτάσουμε μαζί το ευτυχισμένο βράδυ.",
        "f0715.text": "ΩΡΑ",
        "f0717.text": "ΧΩΡΟΣ",
        "f0718.text": "Χίλτον Κοζάνη, Αίθουσα Χορού\nΚέντρο, Κοζάνη",
        "f0720.text": "Οικογένεια: Γεωργία & Άλκης Ράλλη",
        "f0721.text": "RSVP · 0532 318 72 05"
      },
      "en": {
        "f075.text": "OUR SON",
        "f076.text": "ALI'S",
        "f077.text": "CIRCUMCISION",
        "f078.text": "CELEBRATION",
        "f0710.text": "AUGUST 2027",
        "f0711.text": "SATURDAY",
        "f0714.text": "On this big day in our son's life, we'd like to share our joy with you and celebrate this happy evening together.",
        "f0715.text": "TIME",
        "f0717.text": "VENUE",
        "f0718.text": "Hilton Summit Ballroom\nDowntown, Denver",
        "f0720.text": "Family: Grace & Andrew Porter",
        "f0721.text": "RSVP · 0532 318 72 05"
      },
      "es": {
        "f075.text": "NUESTRO HIJO",
        "f076.text": "DE ALI",
        "f077.text": "FIESTA DE",
        "f078.text": "CIRCUNCISIÓN",
        "f0710.bind": "{month} de {year}",
        "f0710.text": "AGOSTO DE 2027",
        "f0711.text": "SÁBADO",
        "f0714.text": "Queremos compartir contigo nuestra alegría en este gran día de la vida de nuestro hijo y celebrar juntos esta feliz velada.",
        "f0715.text": "HORA",
        "f0717.text": "LUGAR",
        "f0718.text": "Hilton Burgos · Salón de baile\nCapiscol, Burgos",
        "f0720.text": "Su familia: Gülsen & Ahmet Polat",
        "f0721.text": "RSVP · 0532 318 72 05"
      },
      "fr": {
        "f075.text": "NOTRE FILS",
        "f076.text": "ALI",
        "f077.text": "FÊTE DE",
        "f078.text": "CIRCONCISION",
        "f0710.text": "AOÛT 2027",
        "f0711.text": "SAMEDI",
        "f0714.text": "En ce grand jour de la vie de notre fils, nous aimerions partager notre joie avec vous et fêter ensemble cette heureuse soirée.",
        "f0715.text": "HEURE",
        "f0717.text": "LIEU",
        "f0718.text": "Hilton Toulouse · Salle de bal\nCompans, Toulouse",
        "f0720.text": "Sa famille : Gülsen & Ahmet Polat",
        "f0721.text": "RSVP · 0532 318 72 05"
      },
      "it": {
        "f075.text": "NOSTRO FIGLIO",
        "f076.text": "ALI",
        "f077.text": "FESTA DELLA",
        "f078.text": "CIRCONCISIONE",
        "f0710.text": "AGOSTO 2027",
        "f0711.text": "SABATO",
        "f0714.text": "In questo grande giorno della vita di nostro figlio vorremmo condividere con te la nostra gioia e festeggiare insieme la serata.",
        "f0715.text": "ORA",
        "f0717.text": "LUOGO",
        "f0718.text": "Hilton Firenze · Sala da ballo\nCampo di Marte, Firenze",
        "f0720.text": "Famiglia: Gülsen & Ahmet Polat",
        "f0721.text": "RSVP · 0532 318 72 05"
      },
      "pt": {
        "f075.text": "O NOSSO FILHO",
        "f076.text": "RUI",
        "f077.text": "FESTA DA",
        "f078.text": "CIRCUNCISÃO",
        "f0710.bind": "{month} de {year}",
        "f0710.text": "AGOSTO DE 2027",
        "f0711.text": "SÁBADO",
        "f0714.text": "Neste grande dia na vida do nosso filho, queremos partilhar convosco a nossa alegria e celebrar juntos esta noite feliz.",
        "f0715.text": "HORA",
        "f0717.text": "LOCAL",
        "f0718.text": "Hilton Porto · Salão de Baile\nBoavista, Porto",
        "f0720.text": "Família: Graça & André Pinto",
        "f0721.text": "RSVP · 0532 318 72 05"
      },
      "ru": {
        "f075.text": "НАШ СЫН",
        "f076.text": "АЛИ",
        "f077.text": "ПРАЗДНИК",
        "f078.text": "ОБРЕЗАНИЯ",
        "f0710.text": "АВГУСТ 2027",
        "f0711.text": "СУББОТА",
        "f0714.text": "Мы хотим разделить с вами радость этого большого дня в жизни нашего сына и вместе отпраздновать счастливый вечер.",
        "f0715.text": "ВРЕМЯ",

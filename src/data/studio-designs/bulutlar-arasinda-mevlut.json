        "f1717.text": "MITTE, KASSEL",
        "f1718.text": "Eltern: Melis & Baris Sahin",
        "f1722.text": "RSVP · 0532 488 15 70"
      },
      "el": {
        "f1710.text": "ΠΡΟΣΚΛΗΣΗ ΜΕΒΛΙΤ",

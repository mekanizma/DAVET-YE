        "f1714.text": "17 Οκτωβρίου 2027 · Κυριακή",
        "f1715.text": "ΜΕΤΑ ΤΗ ΜΕΣΗΜΕΡΙΑΝΗ ΠΡΟΣΕΥΧΗ",
        "f1716.text": "Τζαμί Ορχάν",
        "f1717.text": "ΔΙΔΥΜΟΤΕΙΧΟ, ΕΒΡΟΣ",
        "f1718.text": "Γονείς: Μάρθα & Βλάσης Γεράκη",
        "f1722.text": "RSVP · 0532 488 15 70"
      },

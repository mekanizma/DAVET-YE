        "f1722.text": "تأكيد الحضور · 0532 488 15 70"
      },
      "de": {
        "f1710.text": "MEVLID-EINLADUNG",
        "f1711.text": "Unser Sohn",
        "f1712.text": "Philipp",
        "f1713.text": "Aus Dankbarkeit für seine Geburt lassen wir das Mevlid\nrezitieren; wir laden Sie herzlich dazu ein.",
        "f1714.bind": "{day}. {month} {year} · {weekday}",
        "f1714.text": "17. Oktober 2027 · Sonntag",
        "f1715.text": "NACH DEM MITTAGSGEBET",

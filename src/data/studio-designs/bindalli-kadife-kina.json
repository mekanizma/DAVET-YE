    "translations": {
      "ar": {
        "h089.text": "ابنتنا",
        "h0810.text": "غادة",
        "h0811.text": "ليلة الحناء",
        "h0815.text": "في هذه الليلة الخاصة لعروسنا،\nحيث ترتدي ثوبها المخملي المطرّز ونزيّن يديها بالحناء،\nنتمنى أن نراكم بيننا.",
        "h0817.text": "12 نوفمبر 2027",
        "h0818.bind": "{weekday} · الساعة {time}",
        "h0818.text": "الجمعة · الساعة 7:30 مساءً",
        "h0820.text": "قاعة الخان للمناسبات",
        "h0821.text": "حي الممزر، الشارقة",
        "h0822.text": "الأسرة: نوران & حسن الفاروقي",
        "h0823.text": "تأكيد الحضور · 0532 745 12 60"
      },
      "de": {
        "h089.text": "UNSERE TOCHTER",
        "h0810.text": "Greta",
        "h0811.text": "HENNA-ABEND",
        "h0815.text": "An diesem besonderen Abend unserer Braut,\ndie ihr traditionelles Samtkleid trägt und deren\nHenna wir auftragen, möchten wir Sie in unserer Mitte sehen.",
        "h0817.bind": "{day}. {month} {year}",
        "h0817.text": "12. NOVEMBER 2027",
        "h0818.bind": "{weekday} · {time} UHR",
        "h0818.text": "FREITAG · 19:30 UHR",
        "h0820.text": "Festsaal Alter Handelshof",
        "h0821.text": "ANDREASVIERTEL, ERFURT",
        "h0822.text": "Familie: Nuran & Hasan Öztürk",
        "h0823.text": "RSVP · 0532 745 12 60"
      },
      "el": {
        "h089.text": "Η ΚΟΡΗ ΜΑΣ",
        "h0810.text": "Γωγώ",
        "h0811.text": "ΒΡΑΔΙΑ ΧΕΝΝΑΣ",
        "h0815.text": "Θα θέλαμε να σας δούμε ανάμεσά μας\nστη σημαντική βραδιά της νύφης μας,\nόπου θα φορέσει το κεντητό νυφικό της και θα βαφτεί η χέννα της.",
        "h0817.text": "12 ΝΟΕΜΒΡΙΟΥ 2027",
        "h0818.bind": "{weekday} · ΩΡΑ {time}",
        "h0818.text": "ΠΑΡΑΣΚΕΥΗ · 19:30",
        "h0820.text": "Αίθουσα Το Χάνι",
        "h0821.text": "ΚΕΝΤΡΟ, ΚΟΖΑΝΗ",
        "h0822.text": "Οικογένεια: Νάσια & Θάνος Ιωάννου",
        "h0823.text": "RSVP · 0532 745 12 60"
      },
      "en": {
        "h089.text": "OUR DAUGHTER",
        "h0810.text": "Grace",
        "h0811.text": "HENNA NIGHT",
        "h0815.text": "On this special night of our bride, who will don\nher traditional embroidered gown and have her henna applied,\nwe'd love to have you with us.",
        "h0817.text": "NOVEMBER 12, 2027",
        "h0818.bind": "{weekday} · {time}",
        "h0818.text": "FRIDAY · 7:30 PM",
        "h0820.text": "Caravan Event Hall",
        "h0821.text": "CHERRY CREEK, DENVER",
        "h0822.text": "Family: Nuran & Hasan Öztürk",
        "h0823.text": "RSVP · 0532 745 12 60"
      },
      "es": {
        "h089.text": "NUESTRA HIJA",
        "h0810.text": "Gema",
        "h0811.text": "NOCHE DE HENNA",
        "h0815.text": "En esta noche especial de nuestra novia, que vestirá\nsu tradicional vestido de terciopelo bordado en oro\ny recibirá la henna, queremos contar contigo.",
        "h0817.bind": "{day} de {month} de {year}",
        "h0817.text": "12 DE NOVIEMBRE DE 2027",
        "h0818.bind": "{weekday} · A LAS {time}",
        "h0818.text": "VIERNES · A LAS 19:30",
        "h0820.text": "Salón de eventos Antigua Posada",
        "h0821.text": "GAMONAL, BURGOS",
        "h0822.text": "Su familia: Nuran & Hasan Öztürk",
        "h0823.text": "RSVP · 0532 745 12 60"
      },
      "fr": {
        "h089.text": "NOTRE FILLE",
        "h0810.text": "Carla",
        "h0811.text": "SOIRÉE DU HENNÉ",
        "h0815.text": "En cette soirée spéciale de notre mariée,\nvêtue de sa robe traditionnelle brodée d’or\npour la pose du henné, nous aimerions vous compter parmi nous.",
        "h0817.text": "12 NOVEMBRE 2027",
        "h0818.bind": "{weekday} · À {time}",
        "h0818.text": "VENDREDI · À 19 H 30",
        "h0820.text": "Salle du Relais",
        "h0821.text": "CAPITOLE, TOULOUSE",
        "h0822.text": "Sa famille : Nuran & Hasan Öztürk",
        "h0823.text": "RSVP · 0532 745 12 60"
      },
      "it": {
        "h089.text": "NOSTRA FIGLIA",
        "h0810.text": "Giulia",
        "h0811.text": "NOTTE DELL'HENNÉ",
        "h0815.text": "Nella serata speciale della nostra sposa,\nche indosserà l'abito ricamato tradizionale e riceverà l'henné,\nvorremmo averti con noi.",
        "h0817.text": "12 NOVEMBRE 2027",
        "h0818.bind": "{weekday} · ORE {time}",
        "h0818.text": "VENERDÌ · ORE 19.30",
        "h0820.text": "Sala ricevimenti Antica Posta",
        "h0821.text": "VALPANTENA, VERONA",
        "h0822.text": "Famiglia: Nuran & Hasan Öztürk",
        "h0823.text": "RSVP · 0532 745 12 60"
      },
      "pt": {
        "h089.text": "A NOSSA FILHA",
        "h0810.text": "Graça",
        "h0811.text": "NOITE DA HENA",
        "h0815.text": "Na noite especial da nossa noiva, que vestirá o\ntraje tradicional bordado e receberá a hena,\ngostaríamos de vos ter connosco.",
        "h0817.bind": "{day} de {month} de {year}",
        "h0817.text": "12 DE NOVEMBRO DE 2027",
        "h0818.bind": "{weekday} · ÀS {time}",
        "h0818.text": "SEXTA-FEIRA · ÀS 19H30",
        "h0820.text": "Salão de Festas Estalagem Antiga",
        "h0821.text": "FOZ, PORTO",
        "h0822.text": "Família: Núria & Gaspar Ferreira",
        "h0823.text": "RSVP · 0532 745 12 60"
      },
      "ru": {
        "h089.text": "НАША ДОЧЬ",
        "h0810.text": "Галина",
        "h0811.text": "ВЕЧЕР ХНЫ",
        "h0815.text": "В этот особенный вечер нашей невесты, которая,\nнадев бинделли, примет хну,\nмы хотим видеть вас среди нас.",
        "h0817.text": "12 НОЯБРЯ 2027",
        "h0818.bind": "{weekday} · В {time}",
        "h0818.text": "ПЯТНИЦА · 19:30",

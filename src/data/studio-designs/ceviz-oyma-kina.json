    "translations": {
      "ar": {
        "h012.text": "ليلة الحناء",
        "h013.text": "ابنتنا",
        "h014.text": "زهراء",
        "h018.text": "في ليلتها الأخيرة في بيت أبيها،\nلنزيّن يديها بالحناء معاً،\nوشاركونا البهجة.",
        "h0110.text": "16 سبتمبر 2027 · الخميس",
        "h0111.bind": "الساعة {time}",
        "h0111.text": "الساعة 20.00",
        "h0112.text": "قصر الورد للمناسبات",
        "h0113.text": "حي الدفنة، الدوحة",
        "h0114.text": "الأسرة: خديجة & مصطفى الجبوري",
        "h0116.text": "تأكيد الحضور · 0532 214 56 78"
      },
      "de": {
        "h012.text": "Henna-Abend",
        "h013.text": "UNSERE TOCHTER",
        "h014.text": "ZOE",
        "h018.text": "In ihrer letzten Nacht im Elternhaus\nfeiern wir gemeinsam ihr Henna,\nteilen Sie unsere Freude.",
        "h0110.bind": "{day}. {month} {year} · {weekday}",
        "h0110.text": "16. September 2027 · Donnerstag",
        "h0111.bind": "{time} UHR",
        "h0111.text": "20:00 UHR",
        "h0112.text": "Eventhaus Rosenhof",
        "h0113.text": "DEGERLOCH, STUTTGART",
        "h0114.text": "Familie: Hatice & Mustafa Kaya",
        "h0116.text": "RSVP · 0532 214 56 78"
      },
      "el": {
        "h012.text": "Βραδιά χέννας",
        "h013.text": "Η ΚΟΡΗ ΜΑΣ",
        "h014.text": "ΖΕΤΑ",
        "h018.text": "Ας βάψουμε μαζί τη χέννα της\nτην τελευταία της βραδιά στο πατρικό,\nμοιραστείτε τη χαρά μας.",
        "h0110.text": "16 Σεπτεμβρίου 2027 · Πέμπτη",
        "h0111.bind": "ΩΡΑ {time}",
        "h0111.text": "ΩΡΑ 20:00",
        "h0112.text": "Αρχοντικό Τριαντάφυλλο",
        "h0113.text": "ΑΛΥΚΕΣ, ΒΟΛΟΣ",
        "h0114.text": "Οικογένεια: Χρύσα & Μιχάλης Πέτρου",
        "h0116.text": "RSVP · 0532 214 56 78"
      },
      "en": {
        "h012.text": "Henna Night",
        "h013.text": "OUR DAUGHTER",
        "h014.text": "ZOE",
        "h018.text": "On her last night in her father's house,\nlet's apply her henna together;\njoin in our joy.",
        "h0110.text": "September 16, 2027 · Thursday",
        "h0111.bind": "AT {time}",
        "h0111.text": "AT 8:00 PM",
        "h0112.text": "Rose Manor Reception Hall",
        "h0113.text": "SAVANNAH, GEORGIA",
        "h0114.text": "Family: Hatice & Mustafa Kaya",
        "h0116.text": "RSVP · 0532 214 56 78"
      },
      "es": {
        "h012.text": "Noche de henna",
        "h013.text": "NUESTRA HIJA",
        "h014.text": "ZOE",
        "h018.text": "En su última noche en casa de su padre,\ntiñamos juntos su henna,\ncomparte nuestra alegría.",
        "h0110.bind": "{day} de {month} de {year} · {weekday}",
        "h0110.text": "16 de septiembre de 2027 · jueves",
        "h0111.bind": "A LAS {time}",
        "h0111.text": "A LAS 20:00",
        "h0112.text": "Salón La Rosaleda",
        "h0113.text": "PARQUESOL, VALLADOLID",
        "h0114.text": "Su familia: Hatice & Mustafa Kaya",
        "h0116.text": "RSVP · 0532 214 56 78"
      },
      "fr": {
        "h012.text": "Soirée du henné",
        "h013.text": "NOTRE FILLE",
        "h014.text": "JULIE",
        "h018.text": "Pour sa dernière nuit sous le toit de son père,\nposons ensemble son henné :\npartagez notre joie.",
        "h0110.text": "16 septembre 2027 · jeudi",
        "h0111.bind": "À {time}",

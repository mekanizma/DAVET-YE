        "h0112.text": "Manoir des Roses",
        "h0113.text": "SAINT-CYR, TOURS",
        "h0114.text": "Sa famille : Hatice & Mustafa Kaya",
        "h0116.text": "RSVP · 0532 214 56 78"
      },
      "it": {

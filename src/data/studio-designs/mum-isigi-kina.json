    "translations": {
      "ar": {
        "h119.text": "أنتم مدعوون\nإلى ليلة حنائنا",
        "h1110.text": "أروى",
        "h1114.text": "سنُقيم ليلة الحناء\nعلى ضوء الشموع،\nونودّع عروسنا بكل محبة.",
        "h1115.text": "2 ديسمبر 2027",
        "h1116.bind": "{weekday} · الساعة {time}",
        "h1116.text": "الخميس · الساعة 8:00 مساءً",
        "h1117.text": "قصر زهر العسل",
        "h1118.text": "حي المنشية، الإسكندرية",
        "h1120.text": "تأكيد الحضور · 0533 670 82 14"
      },
      "de": {
        "h119.text": "SIE SIND ZU UNSEREM\nHENNA-ABEND EINGELADEN",
        "h1110.text": "Elsa",
        "h1114.text": "Bei Kerzenschein tragen wir das Henna auf\nund verabschieden unsere Braut\nmit Liebe.",
        "h1115.bind": "{day}. {month} {year}",
        "h1115.text": "2. Dezember 2027",
        "h1116.bind": "{weekday} · {time} UHR",
        "h1116.text": "DONNERSTAG · 20:00 UHR",
        "h1117.text": "Villa Geißblatt",
        "h1118.text": "NEUSTADT, BREMEN",
        "h1120.text": "RSVP · 0533 670 82 14"
      },
      "el": {
        "h119.text": "ΣΑΣ ΠΡΟΣΚΑΛΟΥΜΕ\nΣΤΗ ΒΡΑΔΙΑ ΧΕΝΝΑΣ ΜΑΣ",
        "h1110.text": "Έλσα",
        "h1114.text": "Στο φως των κεριών θα βάψουμε τη χέννα\nκαι θα ξεπροβοδίσουμε τη νύφη μας\nμε αγάπη.",
        "h1115.text": "2 Δεκεμβρίου 2027",
        "h1116.bind": "{weekday} · ΩΡΑ {time}",
        "h1116.text": "ΠΕΜΠΤΗ · ΩΡΑ 20:00",
        "h1117.text": "Αρχοντικό Αγιόκλημα",
        "h1118.text": "ΑΝΩ ΠΟΛΗ, ΠΑΤΡΑ",
        "h1120.text": "RSVP · 0533 670 82 14"
      },
      "en": {
        "h119.text": "YOU'RE INVITED\nTO OUR HENNA NIGHT",
        "h1110.text": "Emily",
        "h1114.text": "By candlelight we will\napply the henna and\nsend our bride off with love.",
        "h1115.text": "December 2, 2027",
        "h1116.bind": "{weekday} · {time}",
        "h1116.text": "THURSDAY · 8:00 PM",
        "h1117.text": "Honeysuckle Manor",
        "h1118.text": "OLD TOWN, SAN DIEGO",
        "h1120.text": "RSVP · 0533 670 82 14"
      },
      "es": {
        "h119.text": "TE INVITAMOS A\nNUESTRA NOCHE DE HENNA",
        "h1110.text": "Elisa",
        "h1114.text": "A la luz de las velas aplicaremos la henna\ny despediremos a nuestra novia\ncon todo nuestro cariño.",
        "h1115.bind": "{day} de {month} de {year}",
        "h1115.text": "2 de diciembre de 2027",
        "h1116.bind": "{weekday} · A LAS {time}",
        "h1116.text": "JUEVES · A LAS 20:00",
        "h1117.text": "Casona Madreselva",
        "h1118.text": "EL CARMEN, VALENCIA",
        "h1120.text": "RSVP · 0533 670 82 14"
      },
      "fr": {
        "h119.text": "VOUS ÊTES INVITÉS\nÀ NOTRE SOIRÉE DU HENNÉ",
        "h1110.text": "Cléo",
        "h1114.text": "À la lueur des bougies, nous poserons le henné\net accompagnerons notre mariée\navec tout notre amour.",
        "h1115.text": "2 décembre 2027",
        "h1116.bind": "{weekday} · À {time}",
        "h1116.text": "JEUDI · À 20 H 00",
        "h1117.text": "Le Chèvrefeuille",
        "h1118.text": "VIEUX-NICE",
        "h1120.text": "RSVP · 0533 670 82 14"
      },
      "it": {
        "h119.text": "TI INVITIAMO ALLA\nNOSTRA NOTTE DELL'HENNÉ",
        "h1110.text": "Erika",
        "h1114.text": "Alla luce delle candele celebreremo l'henné\ne accompagneremo la nostra sposa\ncon tanto affetto.",
        "h1115.text": "2 dicembre 2027",
        "h1116.bind": "{weekday} · ORE {time}",
        "h1116.text": "GIOVEDÌ · ORE 20.00",
        "h1117.text": "Villa Caprifoglio",
        "h1118.text": "SESTRI, GENOVA",
        "h1120.text": "RSVP · 0533 670 82 14"
      },
      "pt": {
        "h119.text": "ESTÃO CONVIDADOS PARA\nA NOSSA NOITE DA HENA",
        "h1110.text": "Elsa",
        "h1114.text": "À luz das velas, aplicaremos a hena\ne despediremos a nossa noiva\ncom todo o carinho.",
        "h1115.bind": "{day} de {month} de {year}",
        "h1115.text": "2 de dezembro de 2027",
        "h1116.bind": "{weekday} · ÀS {time}",
        "h1116.text": "QUINTA-FEIRA · ÀS 20H00",
        "h1117.text": "Solar da Madressilva",
        "h1118.text": "BOAVISTA, PORTO",
        "h1120.text": "RSVP · 0533 670 82 14"
      },
      "ru": {
        "h119.text": "ПРИГЛАШАЕМ ВАС НА\nНАШ ВЕЧЕР ХНЫ",
        "h1110.text": "Татьяна",
        "h1114.text": "При свете свечей мы нанесём хну\nи с любовью проводим\nнашу невесту.",
        "h1115.text": "2 декабря 2027",
        "h1116.bind": "{weekday} · В {time}",
        "h1116.text": "ЧЕТВЕРГ · 20:00",
        "h1117.text": "Усадьба «Жимолость»",
        "h1118.text": "ЦЕНТР, СОЧИ",
        "h1120.text": "RSVP · 0533 670 82 14"
      }
    },

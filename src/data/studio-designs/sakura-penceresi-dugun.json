        "k094.text": "Dana & Eddie",
        "k098.text": "On this summer evening when the cherry blossoms are in bloom,\nwe are joining our lives; we would be\ndelighted to have you with us.",
        "k099.text": "AUGUST 21, 2027",
        "k0910.bind": "{weekday} · {time}",
        "k0910.text": "SATURDAY · 7:00 PM",

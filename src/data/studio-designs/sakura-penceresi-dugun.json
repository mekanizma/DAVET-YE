    "translations": {
      "ar": {
        "k093.text": "أنتم مدعوون إلى زفافنا",
        "k094.text": "صفاء & إياد",
        "k098.text": "في مساء الصيف هذا الذي تتفتح فيه أزهار الكرز\nنجمع حياتنا؛ ويسعدنا\nأن نراكم بيننا.",
        "k099.text": "21 أغسطس 2027",
        "k0910.bind": "{weekday} · الساعة {time}",
        "k0910.text": "السبت · الساعة 7:00 مساءً",
        "k0912.text": "منتجع الهدوء",
        "k0913.text": "الحمامات، تونس",
        "k0914.text": "تأكيد الحضور · 0532 448 63 07"
      },
      "de": {
        "k093.text": "SIE SIND ZU UNSERER HOCHZEIT EINGELADEN",
        "k094.text": "Daria & Eike",
        "k098.text": "An diesem Sommerabend, an dem die Kirschblüten blühen,\nvereinen wir unsere Leben; wir würden uns freuen,\nSie in unserer Mitte zu begrüßen.",
        "k099.bind": "{day}. {month} {year}",
        "k099.text": "21. AUGUST 2027",
        "k0910.bind": "{weekday} · {time} UHR",
        "k0910.text": "SAMSTAG · 19:00 UHR",
        "k0912.text": "Wellnesshotel Birkenhof",
        "k0913.text": "Tegernsee, Bayern",
        "k0914.text": "RSVP · 0532 448 63 07"
      },
      "el": {
        "k093.text": "ΣΑΣ ΠΡΟΣΚΑΛΟΥΜΕ ΣΤΟΝ ΓΑΜΟ ΜΑΣ",
        "k094.text": "Δώρα & Έκτωρ",
        "k098.text": "Αυτό το καλοκαιρινό βράδυ που ανθίζουν οι κερασιές\nενώνουμε τις ζωές μας· θα χαρούμε πολύ\nνα σας δούμε ανάμεσά μας.",
        "k099.text": "21 ΑΥΓΟΥΣΤΟΥ 2027",
        "k0910.bind": "{weekday} · ΩΡΑ {time}",
        "k0910.text": "ΣΑΒΒΑΤΟ · ΩΡΑ 19:00",
        "k0912.text": "Γαλήνη Wellness",
        "k0913.text": "Νησί, Ιωάννινα",
        "k0914.text": "RSVP · 0532 448 63 07"
      },
      "en": {

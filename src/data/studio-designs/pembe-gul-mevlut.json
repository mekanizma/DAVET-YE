    "translations": {
      "ar": {
        "f191.text": "ابنتنا",
        "f193.text": "آسيا",
        "f194.text": "دعوة إلى المولد",
        "f198.text": "شكراً لله على ابنتنا آسيا التي منّ بها علينا،\nنقيم مجلس المولد الشريف\nوننتظر تشريفكم.",
        "f1911.text": "14 نوفمبر 2027 · الأحد",
        "f1912.text": "بعد صلاة العصر",
        "f1914.text": "جامع السلام",
        "f1915.text": "الخبر، المنطقة الشرقية",
        "f1916.text": "الوالدان: هلا & سامر المطيع",
        "f1917.text": "تأكيد الحضور · 0532 330 18 92"
      },
      "de": {
        "f191.text": "UNSERE TOCHTER",
        "f193.text": "Anna",
        "f194.text": "Mevlid-Einladung",
        "f198.text": "Aus Dankbarkeit für die Geburt unserer Tochter Asya,\ndie Gott uns geschenkt hat, lassen wir das Mevlid\nrezitieren; wir erwarten Ihr Kommen.",
        "f1911.bind": "{day}. {month} {year} · {weekday}",
        "f1911.text": "14. November 2027 · Sonntag",
        "f1912.text": "NACH DEM NACHMITTAGSGEBET",
        "f1914.text": "Merkez-Moschee",
        "f1915.text": "STADTMITTE, DORTMUND",
        "f1916.text": "Eltern: Hilal & Serkan Uysal",
        "f1917.text": "RSVP · 0532 330 18 92"
      },
      "el": {
        "f191.text": "Η ΚΟΡΗ ΜΑΣ",
        "f193.text": "Ανθή",
        "f194.text": "Πρόσκληση μεβλίτ",
        "f198.text": "Περιμένουμε την παρουσία σας στο Μεβλίτ\nπου θα διαβαστεί ως ευχαριστία για τον ερχομό στον κόσμο\nτης κόρης μας Ανθής, δώρου του Θεού.",
        "f1911.text": "14 Νοεμβρίου 2027 · Κυριακή",
        "f1912.text": "ΜΕΤΑ ΤΗΝ ΑΠΟΓΕΥΜΑΤΙΝΗ ΠΡΟΣΕΥΧΗ",
        "f1914.text": "Τζαμί Περτέβ Πασά",
        "f1915.text": "ΣΑΠΕΣ, ΡΟΔΟΠΗ",
        "f1916.text": "Γονείς: Ηρώ & Σπύρος Πράου",
        "f1917.text": "RSVP · 0532 330 18 92"
      },
      "en": {
        "f191.text": "OUR DAUGHTER",
        "f193.text": "Ava",
        "f194.text": "Mawlid Invitation",
        "f198.text": "We look forward to your presence at the\nMawlid recitation we are holding in gratitude for\nthe arrival of Asya, the daughter our Lord granted us.",
        "f1911.text": "November 14, 2027 · Sunday",
        "f1912.text": "AFTER THE AFTERNOON PRAYER",
        "f1914.text": "Riverbend Mosque",
        "f1915.text": "YONKERS, NEW YORK",
        "f1916.text": "Parents: Hilal & Serkan Uysal",
        "f1917.text": "RSVP · 0532 330 18 92"
      },
      "es": {
        "f191.text": "NUESTRA HIJA",
        "f193.text": "Alba",
        "f194.text": "Invitación al Mevlid",
        "f198.text": "En acción de gracias por la llegada de Asya,\nla hija que Dios nos concedió, recitaremos\nel mevlid y esperamos contar contigo.",
        "f1911.bind": "{day} de {month} de {year} · {weekday}",
        "f1911.text": "14 de noviembre de 2027 · domingo",
        "f1912.text": "DESPUÉS DE LA ORACIÓN DE LA TARDE",
        "f1914.text": "Mezquita de la Misericordia",
        "f1915.text": "REUS, TARRAGONA",
        "f1916.text": "Sus padres: Hilal & Serkan Uysal",
        "f1917.text": "RSVP · 0532 330 18 92"
      },
      "fr": {
        "f191.text": "NOTRE FILLE",
        "f193.text": "Emma",
        "f194.text": "Invitation au Mevlid",
        "f198.text": "En gratitude pour la venue au monde de notre fille Asya,\nofferte par Dieu, nous ferons lire le Mevlid ;\nnous attendons l’honneur de votre présence.",
        "f1911.text": "14 novembre 2027 · dimanche",
        "f1912.text": "APRÈS LA PRIÈRE DE L’APRÈS-MIDI",
        "f1914.text": "Mosquée Ar-Rahma",
        "f1915.text": "CAEN, CALVADOS",
        "f1916.text": "Ses parents : Hilal & Serkan Uysal",
        "f1917.text": "RSVP · 0532 330 18 92"
      },
      "it": {
        "f191.text": "NOSTRA FIGLIA",
        "f193.text": "Asia",
        "f194.text": "Invito al Mawlid",
        "f198.text": "Ringraziando il Signore per il dono di nostra figlia Asya,\nti aspettiamo al Mawlid\nche faremo recitare per la sua nascita.",
        "f1911.text": "14 novembre 2027 · domenica",
        "f1912.text": "DOPO LA PREGHIERA DEL POMERIGGIO",
        "f1914.text": "Moschea della Speranza",
        "f1915.text": "MONZA, LOMBARDIA",
        "f1916.text": "Genitori: Hilal & Serkan Uysal",
        "f1917.text": "RSVP · 0532 330 18 92"
      },
      "pt": {
        "f191.text": "A NOSSA FILHA",
        "f193.text": "Alice",
        "f194.text": "Convite para o Mevlid",
        "f198.text": "Em ação de graças pelo nascimento de Alice,\na filha que Deus nos concedeu, mandaremos recitar\no mevlid e contamos com a vossa presença.",
        "f1911.bind": "{day} de {month} de {year} · {weekday}",
        "f1911.text": "14 de novembro de 2027 · domingo",
        "f1912.text": "DEPOIS DA ORAÇÃO DA TARDE",
        "f1914.text": "Mesquita do Rio",
        "f1915.text": "CASCAIS, LISBOA",
        "f1916.text": "Pais: Luana & Sérgio Dias",
        "f1917.text": "RSVP · 0532 330 18 92"
      },
      "ru": {
        "f191.text": "НАША ДОЧЬ",
        "f193.text": "Ася",
        "f194.text": "Приглашение на мевлид",
        "f198.text": "Мы ждём вас на мевлид-и шериф, который мы прочтём в\nблагодарность за появление на свет нашей дочери Асии,\nдарованной нам Господом.",
        "f1911.text": "14 ноября 2027 · воскресенье",
        "f1912.text": "ПОСЛЕ МОЛИТВЫ АСР",
        "f1914.text": "Мечеть «Рахмат»",
        "f1915.text": "ЦЕНТР, ТУЛА",
        "f1916.text": "Родители: Хилал & Серкан Уйсал",
        "f1917.text": "RSVP · 0532 330 18 92"
      }

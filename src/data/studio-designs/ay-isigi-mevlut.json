    "translations": {
      "ar": {
        "f121.text": "أنتم مدعوون إلى مجلس مولدنا",
        "f122.text": "ابنتنا",
        "f123.text": "ميرا",
        "f124.text": "شكراً لله على قدوم مولودنا إلى الدنيا،\nننتظركم في مجلس\nالمولد الشريف.",
        "f128.text": "3 أكتوبر 2027 · الأحد",
        "f129.text": "بعد صلاة العصر",
        "f1210.text": "جامع النور · فاس",
        "f1211.text": "الوالدان: غادة & تامر الجندي"
      },
      "de": {
        "f121.text": "SIE SIND ZU UNSEREM MEVLID EINGELADEN",
        "f122.text": "Unsere Tochter",
        "f123.text": "Mira",
        "f124.text": "Aus Dankbarkeit für seine Geburt\nlassen wir das Mevlid rezitieren;\nwir erwarten Sie.",
        "f128.bind": "{day}. {month} {year} · {weekday}",
        "f128.text": "3. Oktober 2027 · Sonntag",
        "f129.text": "NACH DEM NACHMITTAGSGEBET",
        "f1210.text": "Stadtmoschee · Augsburg",
        "f1211.text": "Eltern: Gizem & Tolga Er"
      },
      "el": {
        "f121.text": "ΣΑΣ ΠΡΟΣΚΑΛΟΥΜΕ ΣΤΟ ΜΕΒΛΙΤ ΜΑΣ",
        "f122.text": "Η κόρη μας",
        "f123.text": "Μίνα",
        "f124.text": "Σας περιμένουμε στο Μεβλίτ\nπου θα διαβαστεί\nσε ευχαριστία για τον ερχομό του στον κόσμο.",
        "f128.text": "3 Οκτωβρίου 2027 · Κυριακή",

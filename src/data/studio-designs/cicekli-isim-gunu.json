        "f1418.text": "Lemon Tree Garden Hall",
        "f1419.text": "Clearwater, Florida",
        "f1420.text": "Parents: Bailey & Evan Kane",
        "f1421.text": "RSVP · 0532 693 50 84"
      },
      "es": {
        "f142.text": "DÍA DEL NOMBRE",
        "f144.text": "Nuestra hija",
        "f145.text": "Ada",
        "f147.text": "Ada Nehir Kaya",
        "f1411.text": "En este hermoso día en que le susurraremos el azán al oído\ny le daremos su nombre,\nnos encantaría que compartieras nuestra alegría.",
        "f1413.text": "FECHA",
        "f1414.bind": "{day} de {month} de {year}, {weekday}",

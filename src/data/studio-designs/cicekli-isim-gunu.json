        "f1418.text": "Orangerie Gartensaal",
        "f1419.text": "Mitte, Wiesbaden",
        "f1420.text": "Eltern: Büsra & Emre Kaya",
        "f1421.text": "RSVP · 0532 693 50 84"
      },
      "el": {
        "f142.text": "ΟΝΟΜΑΤΟΔΟΣΙΑ",
        "f144.text": "Η κόρη μας",
        "f145.text": "Άντα",
        "f147.text": "Άντα Νεφέλη Πέτρου",
        "f1411.text": "Ευχόμαστε να μοιραστείτε τη χαρά μας\nαυτή την όμορφη μέρα που θα διαβάσουμε τον εζάν στο αυτί του\nκαι θα του δώσουμε το όνομά του.",
        "f1413.text": "ΗΜΕΡΟΜΗΝΙΑ",
        "f1414.text": "24 Απριλίου 2027, Σάββατο",
        "f1415.text": "ΩΡΑ",
        "f1416.text": "13:00 · με μεσημεριανό γεύμα",
        "f1417.text": "ΧΩΡΟΣ",
        "f1418.text": "Αίθουσα Κήπος Λεμονιάς",
        "f1419.text": "Γούβες, Ηράκλειο",
        "f1420.text": "Γονείς: Βάνια & Ερμής Πέτρου",
        "f1421.text": "RSVP · 0532 693 50 84"
      },
      "en": {
        "f142.text": "NAMING DAY",
        "f144.text": "Our daughter",
        "f145.text": "Abby",
        "f147.text": "Ada Nehir Kaya",
        "f1411.text": "On this beautiful day when the call to prayer\nis whispered in her ear and she is named,\nwe hope you will share our joy.",
        "f1413.text": "DATE",
        "f1414.text": "April 24, 2027, Saturday",
        "f1415.text": "TIME",
        "f1416.text": "1:00 PM · lunch included",

        "f1417.text": "المكان",
        "f1418.text": "قاعة حديقة شجرة الليمون",
        "f1419.text": "حي السيف، المنامة",
        "f1420.text": "الوالدان: بشرى & عاصم الجبوري",
        "f1421.text": "تأكيد الحضور · 0532 693 50 84"
      },
      "de": {
        "f142.text": "NAMENSFEIER",
        "f144.text": "Unsere Tochter",
        "f145.text": "Ada",
        "f147.text": "Ada Nehir Kaya",
        "f1411.text": "An diesem schönen Tag, an dem wir ihm den\nGebetsruf ins Ohr sprechen lassen und seinen Namen geben,\nwünschen wir uns, dass Sie unsere Freude teilen.",
        "f1413.text": "DATUM",
        "f1414.bind": "{day}. {month} {year}, {weekday}",
        "f1414.text": "24. April 2027, Samstag",
        "f1415.text": "UHRZEIT",
        "f1416.text": "13:00 · mit Mittagessen",

    "translations": {
      "ar": {
        "m185.text": "نحن نتزوج",
        "m186.text": "لارا",
        "m187.text": "+ نادر",
        "m188.text": "بين الكروم عند الغروب\nنجمع حياتنا.\nنتمنى أن نراكم بيننا.",
        "m1810.text": "يوليو",
        "m1812.text": "السبت",
        "m1813.text": "بيت الكروم · 7:00 مساءً",
        "m1814.text": "برج العرب، الإسكندرية",
        "m1816.text": "تأكيد الحضور · لارا 0533 902 46 18"
      },
      "de": {
        "m185.text": "WIR HEIRATEN",
        "m186.text": "LARA",
        "m187.text": "+ DANIEL",
        "m188.text": "Zwischen den Weinbergen, bei Sonnenuntergang,\nvereinen wir unsere Leben.\nWir möchten Sie in unserer Mitte sehen.",
        "m1810.text": "JULI",
        "m1812.text": "SAMSTAG",
        "m1813.text": "Weingut Rebenhof · 19:00 Uhr",
        "m1814.text": "Rheingau, Hessen",
        "m1816.text": "RSVP · LARA 0533 902 46 18"
      },
      "el": {
        "m185.text": "ΠΑΝΤΡΕΥΟΜΑΣΤΕ",
        "m186.text": "ΛΑΡΑ",
        "m187.text": "+ ΔΗΜΟΣ",
        "m188.text": "Ανάμεσα στους αμπελώνες, στο ηλιοβασίλεμα,\nενώνουμε τις ζωές μας.\nΘα θέλαμε να σας δούμε ανάμεσά μας.",
        "m1810.text": "ΙΟΥΛΙΟΣ",
        "m1812.text": "ΣΑΒΒΑΤΟ",
        "m1813.text": "Κτήμα Αμπέλι · 19:00",
        "m1814.text": "Ρίο, Πάτρα",
        "m1816.text": "RSVP · ΛΑΡΑ 0533 902 46 18"
      },
      "en": {
        "m185.text": "WE'RE GETTING MARRIED",
        "m186.text": "LAURA",
        "m187.text": "+ JORDAN",
        "m188.text": "Among the vineyards, at sunset,\nwe are joining our lives.\nWe'd love to have you with us.",
        "m1810.text": "JULY",
        "m1812.text": "SATURDAY",
        "m1813.text": "Napa Vineyard House · 7:00 PM",
        "m1814.text": "Napa, California",
        "m1816.text": "RSVP · LARA 0533 902 46 18"
      },
      "es": {
        "m185.text": "NOS CASAMOS",
        "m186.text": "LARA",
        "m187.text": "+ DIEGO",
        "m188.text": "Entre viñedos, al atardecer,\nunimos nuestras vidas.\nQueremos contar contigo.",
        "m1810.text": "JULIO",
        "m1812.text": "SÁBADO",
        "m1813.text": "Casa del Viñedo · 19:00",
        "m1814.text": "Requena, Valencia",
        "m1816.text": "RSVP · LARA 0533 902 46 18"
      },
      "fr": {
        "m185.text": "NOUS NOUS MARIONS",
        "m186.text": "ANOUK",
        "m187.text": "+ MAËL",
        "m188.text": "Au milieu des vignes, au coucher du soleil,\nnous unissons nos vies.\nNous aimerions vous compter parmi nous.",
        "m1810.text": "JUILLET",
        "m1812.text": "SAMEDI",
        "m1813.text": "Mas des Vignes · 19 h 00",
        "m1814.text": "Bellet, Nice",
        "m1816.text": "RSVP · LARA 0533 902 46 18"
      },
      "it": {
        "m185.text": "CI SPOSIAMO",
        "m186.text": "LARA",
        "m187.text": "+ DANTE",
        "m188.text": "Tra i vigneti, al tramonto,\nuniamo le nostre vite.\nVorremmo averti con noi.",
        "m1810.text": "LUGLIO",
        "m1812.text": "SABATO",
        "m1813.text": "Casale delle Vigne · 19.00",
        "m1814.text": "Sori, Genova",
        "m1816.text": "RSVP · LARA 0533 902 46 18"
      },
      "pt": {
        "m185.text": "VAMOS CASAR",
        "m186.text": "LARA",
        "m187.text": "+ DIOGO",
        "m188.text": "Entre as vinhas, ao pôr do sol,\nunimos as nossas vidas.\nGostaríamos de ter-vos connosco.",
        "m1810.text": "JULHO",
        "m1812.text": "SÁBADO",
        "m1813.text": "Casa da Vinha · 19h00",
        "m1814.text": "Peso da Régua, Vila Real",
        "m1816.text": "RSVP · LARA 0533 902 46 18"
      },
      "ru": {
        "m185.text": "МЫ ЖЕНИМСЯ",
        "m186.text": "ЛЕРА",
        "m187.text": "+ САША",
        "m188.text": "Среди виноградников, на закате\nмы соединяем наши жизни.\nМы хотим видеть вас среди нас.",
        "m1810.text": "ИЮЛЬ",
        "m1812.text": "СУББОТА",
        "m1813.text": "Усадьба «Лоза» · 19:00",
        "m1814.text": "Тамань, Кубань",
        "m1816.text": "RSVP · ЛАРА 0533 902 46 18"
      }

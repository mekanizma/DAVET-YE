    "translations": {
      "ar": {
        "m101.text": "أنتم مدعوون إلى حفل وعدنا",
        "m102.text": "غ",
        "m104.text": "س",
        "m105.text": "غادة & سامر",
        "m106.text": "برضا عائلتينا ودعائهم\nنتبادل خواتم الوعد\nفي هذا اليوم الخاص، فكونوا معنا.",
        "m1010.text": "16 مايو 2027 · الأحد",
        "m1011.bind": "الساعة {time}",
        "m1011.text": "الساعة 3:00 عصراً",
        "m1012.text": "دار الأعيان",
        "m1013.text": "جرش · الأردن",
        "m1014.text": "تأكيد الحضور · 0505 377 62 19"
      },
      "de": {
        "m101.text": "SIE SIND ZU UNSERER VERSPRECHENSFEIER EINGELADEN",
        "m102.text": "G",
        "m104.text": "S",
        "m105.text": "GRETA & STEFAN",
        "m106.text": "Mit dem Einverständnis und den Gebeten unserer Familien\nstecken wir unsere Versprechensringe an;\nseien Sie an diesem besonderen Tag bei uns.",
        "m1010.bind": "{day}. {month} {year} · {weekday}",
        "m1010.text": "16. Mai 2027 · Sonntag",
        "m1011.bind": "{time} UHR",
        "m1011.text": "15:00 UHR",
        "m1012.text": "Herrenhaus",
        "m1013.text": "GOSLAR · HARZ",
        "m1014.text": "RSVP · 0505 377 62 19"
      },
      "el": {
        "m101.text": "ΣΑΣ ΠΡΟΣΚΑΛΟΥΜΕ ΣΤΗΝ ΤΕΛΕΤΗ ΥΠΟΣΧΕΣΗΣ ΜΑΣ",
        "m102.text": "Γ",
        "m104.text": "Σ",
        "m105.text": "ΓΩΓΩ & ΣΠΥΡΟΣ",
        "m106.text": "Να είστε δίπλα μας αυτή την ξεχωριστή μέρα\nπου με τη συγκατάθεση και τις ευχές των οικογενειών μας\nθα φορέσουμε τα δαχτυλίδια της υπόσχεσης.",
        "m1010.text": "16 Μαΐου 2027 · Κυριακή",
        "m1011.bind": "ΩΡΑ {time}",
        "m1011.text": "ΩΡΑ 15:00",
        "m1012.text": "Αρχοντικό",
        "m1013.text": "ΜΟΝΕΜΒΑΣΙΑ · ΛΑΚΩΝΙΑ",
        "m1014.text": "RSVP · 0505 377 62 19"
      },
      "en": {
        "m101.text": "YOU'RE INVITED TO OUR PROMISE CEREMONY",
        "m105.text": "GRACE & SEAN",
        "m106.text": "With our families' consent and prayers,\non this special day when we exchange\nour promise rings, be with us.",
        "m1010.text": "May 16, 2027 · Sunday",
        "m1011.bind": "AT {time}",
        "m1011.text": "AT 3:00 PM",
        "m1012.text": "Colonel's Manor",
        "m1013.text": "WILLIAMSBURG · VIRGINIA",
        "m1014.text": "RSVP · 0505 377 62 19"
      },
      "es": {
        "m101.text": "TE INVITAMOS A NUESTRA CEREMONIA DE PROMESA",
        "m105.text": "GEMA & SERGIO",
        "m106.text": "Con el consentimiento y las oraciones de nuestras familias\nnos pondremos los anillos de promesa;\nacompáñanos en este día especial.",
        "m1010.bind": "{day} de {month} de {year} · {weekday}",
        "m1010.text": "16 de mayo de 2027 · domingo",
        "m1011.bind": "A LAS {time}",
        "m1011.text": "A LAS 15:00",
        "m1012.text": "Casa Solariega",
        "m1013.text": "ALBARRACÍN · TERUEL",
        "m1014.text": "RSVP · 0505 377 62 19"
      },
      "fr": {
        "m101.text": "VOUS ÊTES INVITÉS À NOTRE CÉRÉMONIE DE PROMESSE",
        "m102.text": "G",
        "m104.text": "S",
        "m105.text": "CARLA & SAMUEL",
        "m106.text": "Avec le consentement et les prières de nos familles,\nnous échangerons nos bagues de promesse :\nsoyez à nos côtés en ce jour spécial.",
        "m1010.text": "16 mai 2027 · dimanche",
        "m1011.bind": "À {time}",
        "m1011.text": "À 15 H 00",
        "m1012.text": "Logis du Bailli",
        "m1013.text": "SARLAT · DORDOGNE",
        "m1014.text": "RSVP · 0505 377 62 19"
      },
      "it": {
        "m101.text": "TI INVITIAMO ALLA NOSTRA CERIMONIA DELLA PROMESSA",
        "m102.text": "G",
        "m104.text": "S",
        "m105.text": "GIULIA & SERGIO",
        "m106.text": "Con il consenso e la benedizione delle nostre famiglie,\nin questo giorno speciale in cui indosseremo\ngli anelli della promessa, sii al nostro fianco.",
        "m1010.text": "16 maggio 2027 · domenica",
        "m1011.bind": "ORE {time}",
        "m1011.text": "ORE 15.00",
        "m1012.text": "Casa del Conte",
        "m1013.text": "CITTÀ ALTA · BERGAMO",
        "m1014.text": "RSVP · 0505 377 62 19"
      },
      "pt": {
        "m101.text": "ESTÃO CONVIDADOS PARA A NOSSA CERIMÓNIA DO PEDIDO",
        "m102.text": "G",
        "m104.text": "S",
        "m105.text": "GRAÇA & SÉRGIO",
        "m106.text": "Com o consentimento e as orações das nossas famílias,\nneste dia especial em que trocaremos\nos anéis de compromisso, estejam connosco.",
        "m1010.bind": "{day} de {month} de {year} · {weekday}",
        "m1010.text": "16 de maio de 2027 · domingo",
        "m1011.bind": "ÀS {time}",
        "m1011.text": "ÀS 15H00",
        "m1012.text": "Solar do Visconde",
        "m1013.text": "MONSANTO · CASTELO BRANCO",
        "m1014.text": "RSVP · 0505 377 62 19"
      },
      "ru": {
        "m101.text": "ПРИГЛАШАЕМ ВАС НА НАШУ ЦЕРЕМОНИЮ СГОВОРА",
        "m102.text": "Г",
        "m104.text": "С",
        "m105.text": "ГАЛИНА & СЕРГЕЙ",
        "m106.text": "С согласия и молитвами наших семей\nв этот особенный день мы обменяемся\nкольцами обещания — будьте с нами.",
        "m1010.text": "16 мая 2027 · воскресенье",
        "m1011.bind": "В {time}",
        "m1011.text": "В 15:00",
        "m1012.text": "Барская усадьба",

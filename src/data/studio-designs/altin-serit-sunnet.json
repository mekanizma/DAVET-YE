    "translations": {
      "ar": {
        "f054.text": "أيمن",
        "f055.text": "أنتم مدعوون إلى حفل الختان",
        "f056.text": "في هذا اليوم السعيد الذي يخطو فيه ابننا خطوته الأولى نحو الرجولة،\nيسعدنا أن نراكم بيننا.",
        "f057.text": "24 يوليو 2027",
        "f058.bind": "{weekday} · الساعة {time}",
        "f058.text": "السبت · الساعة 7:00 مساءً",
        "f0510.text": "نوفوتيل صلالة",
        "f0511.text": "حي السعادة، صلالة",
        "f0512.text": "الأسرة: فاطمة & سليم الأبيض  ·  تأكيد الحضور · 0532 451 09 62"
      },
      "de": {
        "f054.text": "Ethan",
        "f055.text": "SIE SIND ZUR BESCHNEIDUNGSFEIER EINGELADEN",
        "f056.text": "Am glücklichen Tag, an dem unser Sohn den ersten Schritt ins Mannesalter tut,\nwürden wir uns freuen, Sie in unserer Mitte zu begrüßen.",
        "f057.bind": "{day}. {month} {year}",
        "f057.text": "24. Juli 2027",
        "f058.bind": "{weekday} · {time} Uhr",
        "f058.text": "Samstag · 19:00 Uhr",
        "f0510.text": "Novotel München",
        "f0511.text": "Altstadt, Konstanz",
        "f0512.text": "Familie: Fatma & Selim Aksoy  ·  RSVP · 0532 451 09 62"
      },
      "el": {
        "f054.text": "Ευθύμης",
        "f055.text": "ΣΑΣ ΠΡΟΣΚΑΛΟΥΜΕ ΣΤΗ ΓΙΟΡΤΗ ΠΕΡΙΤΟΜΗΣ",
        "f056.text": "Θα χαρούμε πολύ να σας δούμε ανάμεσά μας\nαυτή την ευτυχισμένη μέρα που ο γιος μας κάνει το πρώτο βήμα προς την ανδρική ηλικία.",
        "f057.text": "24 Ιουλίου 2027",
        "f058.bind": "{weekday} · Ώρα {time}",
        "f058.text": "Σάββατο · Ώρα 19:00",
        "f0510.text": "Νοβοτέλ Καβάλα",
        "f0511.text": "Παναγία, Καβάλα",
        "f0512.text": "Οικογένεια: Φανή & Σάββας Λευκού  ·  RSVP · 0532 451 09 62"
      },
      "en": {
        "f054.text": "Elliot",
        "f055.text": "YOU'RE INVITED TO THE CIRCUMCISION CELEBRATION",
        "f056.text": "On this happy day of our son's first step into manhood,\nwe would be delighted to have you with us.",
        "f057.text": "July 24, 2027",
        "f058.bind": "{weekday} · {time}",
        "f058.text": "Saturday · 7:00 PM",
        "f0510.text": "Novotel Waterfront",
        "f0511.text": "Capitol Hill, Seattle",
        "f0512.text": "Family: Fatma & Selim Aksoy  ·  RSVP · 0532 451 09 62"
      },
      "es": {
        "f054.text": "Elías",
        "f055.text": "TE INVITAMOS A LA FIESTA DE CIRCUNCISIÓN",
        "f056.text": "En este feliz día en que nuestro hijo da su primer paso hacia la hombría,\nnos hará muy felices contar contigo.",
        "f057.bind": "{day} de {month} de {year}",
        "f057.text": "24 de julio de 2027",
        "f058.bind": "{weekday} · A las {time}",
        "f058.text": "Sábado · A las 19:00",
        "f0510.text": "Novotel Gijón",

      },
      "fr": {
        "f054.text": "Ethan",
        "f055.text": "VOUS ÊTES INVITÉS À LA FÊTE DE CIRCONCISION",
        "f056.text": "En ce jour heureux où notre fils fait son premier pas vers l’âge d’homme,\nnous serions heureux de vous compter parmi nous.",
        "f057.text": "24 juillet 2027",
        "f058.bind": "{weekday} · À {time}",

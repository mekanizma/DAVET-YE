    "translations": {
      "ar": {
        "h031.text": "أنتم مدعوون إلى ليلة حنائنا",
        "h032.text": "يار\nيار",
        "h036.text": "عروسنا",
        "h037.text": "دانية",
        "h038.text": "لتعلُ أغانينا الشعبية ونحن نزيّن يديها بالحناء؛\nفهذه الليلة أجمل بكم.",
        "h0310.bind": "{weekday} · الساعة {time}",
        "h0310.text": "الخميس · الساعة 8:00 مساءً",
        "h0311.text": "قصر زينب",
        "h0312.text": "المدينة القديمة، مراكش",
        "h0313.text": "تأكيد الحضور · 0542 905 63 18"
      },
      "de": {
        "h031.text": "SIE SIND ZU UNSEREM HENNA-ABEND EINGELADEN",
        "h032.text": "Yâr\nYâr",
        "h036.text": "Unsere Braut",
        "h037.text": "Diana",
        "h038.text": "Während das Henna aufgetragen wird, sollen unsere Lieder erklingen;\nmit Ihnen wird dieser Abend noch schöner.",
        "h0310.bind": "{weekday} · {time} UHR",
        "h0310.text": "DONNERSTAG · 20:00 UHR",

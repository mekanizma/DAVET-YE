        "k1518.text": "Dimore dei Sassi",
        "k1519.text": "Sassi, Matera",
        "k1520.text": "RSVP · 0555 238 70 41"
      },
      "pt": {
        "k158.text": "ESTÃO CONVIDADOS PARA O NOSSO CASAMENTO",
        "k1512.text": "Alda",
        "k1514.text": "Bento",
        "k1515.text": "Neste dia tão especial em que\ncoroamos a nossa felicidade,\nserá uma honra ter-vos connosco.",
        "k1516.bind": "{day} de {month} de {year}",
        "k1516.text": "4 DE SETEMBRO DE 2027",

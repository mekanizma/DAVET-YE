        "k1518.text": "Solares do Olival",
        "k1519.text": "Centro Histórico, Évora",
        "k1520.text": "RSVP · 0555 238 70 41"
      },
      "ru": {
        "k158.text": "ПРИГЛАШАЕМ ВАС НА НАШУ СВАДЬБУ",

    "translations": {
      "ar": {
        "k158.text": "أنتم مدعوون إلى زفافنا",
        "k1512.text": "أسماء",
        "k1514.text": "بدر",
        "k1515.text": "في هذا اليوم المميز\nالذي نتوّج فيه سعادتنا،\nيشرّفنا أن نراكم بيننا.",
        "k1516.text": "4 سبتمبر 2027",
        "k1517.bind": "{weekday} · الساعة {time}",
        "k1517.text": "السبت · الساعة 8:00 مساءً",
        "k1518.text": "قصور الدار",
        "k1519.text": "المدينة القديمة، مراكش",
        "k1520.text": "تأكيد الحضور · 0555 238 70 41"
      },
      "de": {
        "k158.text": "SIE SIND ZU UNSERER HOCHZEIT EINGELADEN",
        "k1512.text": "Alina",
        "k1514.text": "Ben",
        "k1515.text": "An diesem bedeutungsvollen Tag, an dem wir\nunser Glück krönen, ist es uns\neine Ehre, Sie in unserer Mitte zu begrüßen.",
        "k1516.bind": "{day}. {month} {year}",
        "k1516.text": "4. SEPTEMBER 2027",
        "k1517.bind": "{weekday} · {time} UHR",
        "k1517.text": "SAMSTAG · 20:00 UHR",
        "k1518.text": "Altstadt-Palais",
        "k1519.text": "Altstadt, Quedlinburg",
        "k1520.text": "RSVP · 0555 238 70 41"
      },
      "el": {
        "k158.text": "ΣΑΣ ΠΡΟΣΚΑΛΟΥΜΕ ΣΤΟΝ ΓΑΜΟ ΜΑΣ",
        "k1512.text": "Αλίκη",
        "k1514.text": "Βάσος",
        "k1515.text": "Θα νιώσουμε μεγάλη τιμή να σας δούμε\nανάμεσά μας αυτή τη σημαντική μέρα\nπου στεφανώνουμε την ευτυχία μας.",
        "k1516.text": "4 ΣΕΠΤΕΜΒΡΙΟΥ 2027",
        "k1517.bind": "{weekday} · ΩΡΑ {time}",
        "k1517.text": "ΣΑΒΒΑΤΟ · ΩΡΑ 20:00",
        "k1518.text": "Αρχοντικά Ναυπλίου",
        "k1519.text": "Πρόνοια, Ναύπλιο",
        "k1520.text": "RSVP · 0555 238 70 41"
      },
      "en": {
        "k158.text": "YOU'RE INVITED TO OUR WEDDING",
        "k1512.text": "Alice",
        "k1514.text": "Blake",
        "k1515.text": "On this meaningful day when we\ncrown our happiness, we would be\nhonored to have you with us.",
        "k1516.text": "SEPTEMBER 4, 2027",
        "k1517.bind": "{weekday} · {time}",
        "k1517.text": "SATURDAY · 8:00 PM",
        "k1518.text": "Adobe Courtyard Inn",
        "k1519.text": "Santa Fe, New Mexico",
        "k1520.text": "RSVP · 0555 238 70 41"
      },
      "es": {
        "k158.text": "TE INVITAMOS A NUESTRA BODA",
        "k1512.text": "Alma",
        "k1514.text": "Borja",
        "k1515.text": "Será un honor contar contigo\nen este día tan significativo\nen que coronaremos nuestra felicidad.",
        "k1516.bind": "{day} de {month} de {year}",
        "k1516.text": "4 DE SEPTIEMBRE DE 2027",
        "k1517.bind": "{weekday} · A LAS {time}",
        "k1517.text": "SÁBADO · A LAS 20:00",
        "k1518.text": "Casonas del Olivar",
        "k1519.text": "Ciudad Monumental, Cáceres",
        "k1520.text": "RSVP · 0555 238 70 41"
      },
      "fr": {
        "k158.text": "VOUS ÊTES INVITÉS À NOTRE MARIAGE",
        "k1512.text": "Aude",
        "k1514.text": "Marc",
        "k1515.text": "En ce jour si symbolique où notre bonheur sera couronné,\nnous serions honorés\nde vous compter parmi nous.",
        "k1516.text": "4 SEPTEMBRE 2027",
        "k1517.bind": "{weekday} · À {time}",
        "k1517.text": "SAMEDI · À 20 H 00",
        "k1518.text": "Les Demeures Rouges",
        "k1519.text": "Sainte-Cécile, Albi",
        "k1520.text": "RSVP · 0555 238 70 41"
      },
      "it": {
        "k158.text": "TI INVITIAMO AL NOSTRO MATRIMONIO",
        "k1512.text": "Alba",
        "k1514.text": "Rocco",
        "k1515.text": "In questo giorno importante\nin cui coroneremo la nostra felicità\nsarà un onore averti con noi.",

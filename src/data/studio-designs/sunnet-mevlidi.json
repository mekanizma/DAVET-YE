    "translations": {
      "ar": {
        "f042.text": "بسم الله الرحمن الرحيم",
        "f043.text": "مولد الختان",
        "f047.text": "ابننا",
        "f048.text": "محمد أمير",
        "f049.text": "شكراً لله على ختان ابننا نقيم\nمجلس المولد الشريف وننتظر تشريفكم.\nوسيُقدَّم الغداء بعد المولد.",
        "f0410.text": "13 يونيو 2027 · الأحد",
        "f0411.text": "بعد صلاة الظهر",
        "f0413.text": "جامع الفرقان",
        "f0414.text": "حي الوكرة، الدوحة",
        "f0415.text": "الأسرة: خديجة & إبراهيم الخطيب",
        "f0416.text": "تأكيد الحضور · 0532 604 33 18"
      },
      "de": {
        "f042.text": "Bismillâhirrahmânirrahîm",
        "f043.text": "MEVLID ZUR BESCHNEIDUNG",
        "f047.text": "Unser Sohn",
        "f048.text": "Markus Erik",
        "f049.text": "Aus Dankbarkeit für seine Beschneidung lassen wir das Mevlid rezitieren;\nwir erwarten Ihr Kommen.\nNach dem Mevlid wird ein Mittagessen gereicht.",
        "f0410.bind": "{day}. {month} {year} · {weekday}",
        "f0410.text": "13. JUNI 2027 · SONNTAG",
        "f0411.text": "NACH DEM MITTAGSGEBET",
        "f0413.text": "Sultan-Moschee",
        "f0414.text": "NORDSTADT, HANNOVER",
        "f0415.text": "Familie: Hatice & Ibrahim Koç",
        "f0416.text": "RSVP · 0532 604 33 18"
      },
      "el": {
        "f042.text": "Μπισμιλλαχιρραχμανιρραχίμ",
        "f043.text": "ΜΕΒΛΙΤ ΠΕΡΙΤΟΜΗΣ",
        "f047.text": "Ο γιος μας",
        "f048.text": "Μάρκος Έμιλ",
        "f049.text": "Περιμένουμε την παρουσία σας στο Μεβλίτ\nπου θα διαβαστεί ως ευχαριστία για την περιτομή του.\nΜετά το Μεβλίτ θα προσφερθεί γεύμα.",
        "f0410.text": "13 ΙΟΥΝΙΟΥ 2027 · ΚΥΡΙΑΚΗ",
        "f0411.text": "ΜΕΤΑ ΤΗ ΜΕΣΗΜΕΡΙΑΝΗ ΠΡΟΣΕΥΧΗ",
        "f0413.text": "Τζαμί Εμίρ Σουλτάν",
        "f0414.text": "ΙΑΣΜΟΣ, ΡΟΔΟΠΗ",
        "f0415.text": "Οικογένεια: Χρύσα & Ιάκωβος Κόκκα",
        "f0416.text": "RSVP · 0532 604 33 18"
      },
      "en": {
        "f042.text": "Bismillâhirrahmânirrahîm",
        "f043.text": "CIRCUMCISION MAWLID",
        "f047.text": "Our son",
        "f048.text": "James Ethan",
        "f049.text": "We look forward to your presence at the Mawlid\nrecitation we are holding in thanks for his circumcision.\nLunch will be served after the Mawlid.",
        "f0410.text": "JUNE 13, 2027 · SUNDAY",
        "f0411.text": "AFTER THE MIDDAY PRAYER",
        "f0413.text": "Olive Grove Mosque",
        "f0414.text": "SAVANNAH, GEORGIA",
        "f0415.text": "Family: Helen & Isaac Cole",
        "f0416.text": "RSVP · 0532 604 33 18"
      },
      "es": {
        "f042.text": "Bismillâhirrahmânirrahîm",
        "f043.text": "MEVLID DE LA CIRCUNCISIÓN",
        "f047.text": "Nuestro hijo",
        "f048.text": "Miguel Eloy",
        "f049.text": "En acción de gracias por su circuncisión recitaremos el mevlid;\nesperamos tu presencia.\nTras el mevlid se servirá el almuerzo.",
        "f0410.bind": "{day} de {month} de {year} · {weekday}",
        "f0410.text": "13 DE JUNIO DE 2027 · DOMINGO",
        "f0411.text": "DESPUÉS DE LA ORACIÓN DEL MEDIODÍA",
        "f0413.text": "Mezquita del Emir",
        "f0414.text": "LA RONDILLA, VALLADOLID",
        "f0415.text": "Su familia: Hatice & Ibrahim Koç",
        "f0416.text": "RSVP · 0532 604 33 18"
      },
      "fr": {
        "f042.text": "Bismillah ar-Rahman ar-Rahim",
        "f043.text": "MEVLID DE CIRCONCISION",
        "f047.text": "Notre fils",
        "f048.text": "Martin Adam",
        "f049.text": "En gratitude pour sa circoncision, nous ferons lire\nle Mevlid ; nous attendons l’honneur de votre présence.\nUn déjeuner sera servi après le Mevlid.",
        "f0410.text": "13 JUIN 2027 · DIMANCHE",
        "f0411.text": "APRÈS LA PRIÈRE DU MIDI",
        "f0413.text": "Mosquée Al-Hidaya",
        "f0414.text": "LA RICHE, TOURS",
        "f0415.text": "Sa famille : Hatice & Ibrahim Koç",
        "f0416.text": "RSVP · 0532 604 33 18"
      },
      "it": {
        "f042.text": "Bismillâhirrahmânirrahîm",
        "f043.text": "MAWLID PER LA CIRCONCISIONE",
        "f047.text": "Nostro figlio",
        "f048.text": "Pierluigi",
        "f049.text": "Ti aspettiamo al Mawlid che faremo recitare\nin ringraziamento per la sua circoncisione.\nDopo il Mawlid sarà servito il pranzo.",
        "f0410.text": "13 GIUGNO 2027 · DOMENICA",
        "f0411.text": "DOPO LA PREGHIERA DI MEZZOGIORNO",
        "f0413.text": "Moschea dell'Unità",
        "f0414.text": "MIRAFIORI, TORINO",
        "f0415.text": "Famiglia: Hatice & Ibrahim Koç",
        "f0416.text": "RSVP · 0532 604 33 18"
      },
      "pt": {
        "f042.text": "Bismillah ar-Rahman ar-Rahim",
        "f043.text": "MEVLID DA CIRCUNCISÃO",
        "f047.text": "O nosso filho",
        "f048.text": "Martim Eduardo",
        "f049.text": "Em ação de graças pela sua circuncisão, mandaremos recitar\no mevlid e contamos com a vossa presença.\nApós o mevlid será servido o almoço.",
        "f0410.bind": "{day} de {month} de {year} · {weekday}",
        "f0410.text": "13 DE JUNHO DE 2027 · DOMINGO",
        "f0411.text": "DEPOIS DA ORAÇÃO DO MEIO-DIA",
        "f0413.text": "Mesquita do Olival",
        "f0414.text": "BOAVISTA, PORTO",
        "f0415.text": "Família: Helena & Abel Costa",
        "f0416.text": "RSVP · 0532 604 33 18"
      },
      "ru": {
        "f042.text": "Бисмиллахир-рахманир-рахим",
        "f043.text": "МЕВЛИД ОБРЕЗАНИЯ",
        "f047.text": "Наш сын",
        "f048.text": "Михаил",
        "f049.text": "Мы ждём вас на мевлид-и шериф, который мы прочтём\nв благодарность за обрезание.\nПосле мевлида будет подан обед.",
        "f0410.text": "13 ИЮНЯ 2027 · ВОСКРЕСЕНЬЕ",
        "f0411.text": "ПОСЛЕ ПОЛУДЕННОЙ МОЛИТВЫ",
        "f0413.text": "Мечеть «Салям»",
        "f0414.text": "НИЖНИЙ НОВГОРОД",
        "f0415.text": "Семья: Хатидже & Ибрахим Коч",
        "f0416.text": "RSVP · 0532 604 33 18"
      }
    },

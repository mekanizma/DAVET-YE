    "translations": {
      "ar": {
        "f182.text": "حفل استقبال المولود",
        "f183.text": "الأم المنتظرة",
        "f184.text": "نهال",
        "f185.text": "قبل أن تحتضن عزيزتنا نهال\nصغيرتها، ننتظركم في الحفل\nالذي أعددناه لها.",
        "f189.text": "8 مايو 2027 · السبت · 3:00 عصراً",
        "f1810.text": "قصر الخزامى · حومة السوق، جربة",
        "f1811.text": "تأكيد الحضور · بيسان · 0532 917 40 63"
      },
      "de": {
        "f182.text": "BABYPARTY",
        "f183.text": "Unsere werdende Mama",
        "f184.text": "Nadine",
        "f185.text": "Bevor sie ihre kleine Tochter in die Arme schließt,\nerwarten wir Sie zu der Party,\ndie wir für unsere liebe Nehir vorbereitet haben.",
        "f189.bind": "{day}. {month} {year} · {weekday} · {time}",
        "f189.text": "8. Mai 2027 · Samstag · 15:00",
        "f1810.text": "Lavendelhof · Heringsdorf, Usedom",
        "f1811.text": "RSVP · BUSE · 0532 917 40 63"
      },
      "el": {
        "f182.text": "BABY SHOWER",
        "f183.text": "Η μέλλουσα μαμά μας",
        "f184.text": "Νεφέλη",
        "f185.text": "Σας περιμένουμε στο πάρτι που ετοιμάσαμε\nγια την αγαπημένη μας Νεφέλη\nπριν πάρει στην αγκαλιά της την κορούλα της.",
        "f189.text": "8 Μαΐου 2027 · Σάββατο · 15:00",
        "f1810.text": "Αρχοντικό Λεβάντα · Τολό, Αργολίδα",
        "f1811.text": "RSVP · ΒΕΡΑ · 0532 917 40 63"
      },
      "en": {
        "f182.text": "BABY SHOWER",
        "f183.text": "Our mom-to-be",
        "f184.text": "Naomi",
        "f185.text": "Before she holds her little girl in her arms,\nwe're waiting for you at the party\nwe've prepared for our dear Nehir.",
        "f189.text": "May 8, 2027 · Saturday · 3:00 PM",
        "f1810.text": "Lavender Manor · Santa Barbara, California",
        "f1811.text": "RSVP · BUSE · 0532 917 40 63"
      },
      "es": {
        "f182.text": "BABY SHOWER",
        "f183.text": "Nuestra futura mamá",
        "f184.text": "Noemí",

    "translations": {
      "ar": {
        "m141.text": "أنتم مدعوون\nإلى عقد قراننا",
        "m142.text": "منى",
        "m144.text": "غازي",
        "m145.text": "نتمنى أن تكونوا شهوداً\nعلى اجتماع حياتنا\nفي هذا اليوم الجميل.",
        "m146.text": "8 أكتوبر 2027",
        "m147.bind": "{weekday} · الساعة {time}",
        "m147.text": "الجمعة · الساعة 2:30 ظهراً",
        "m148.text": "قصر عقد القران",
        "m149.text": "حي السعادة، صلالة",
        "m1410.text": "تأكيد الحضور · 0532 904 33 18"
      },
      "de": {
        "m141.text": "SIE SIND ZU UNSERER\nTRAUUNG EINGELADEN",
        "m142.text": "Paula",
        "m144.text": "Oskar",
        "m145.text": "Wir wünschen uns, dass Sie\nan diesem schönen Tag, an dem wir\nunsere Leben vereinen, unsere Zeugen sind.",
        "m146.bind": "{day}. {month} {year}",
        "m146.text": "8. Oktober 2027",
        "m147.bind": "{weekday} · {time} UHR",
        "m147.text": "FREITAG · 14:30 UHR",
        "m148.text": "Standesamt im Schloss",
        "m149.text": "ALTSTADT, KONSTANZ",
        "m1410.text": "RSVP · 0532 904 33 18"
      },
      "el": {
        "m141.text": "ΣΑΣ ΠΡΟΣΚΑΛΟΥΜΕ\nΣΤΟΝ ΠΟΛΙΤΙΚΟ ΓΑΜΟ ΜΑΣ",
        "m142.text": "Πόπη",
        "m144.text": "Όσκαρ",
        "m145.text": "Ευχόμαστε να είστε μάρτυρές μας\nαυτή την όμορφη μέρα\nπου ενώνουμε τις ζωές μας.",
        "m146.text": "8 Οκτωβρίου 2027",
        "m147.bind": "{weekday} · ΩΡΑ {time}",
        "m147.text": "ΠΑΡΑΣΚΕΥΗ · 14:30",
        "m148.text": "Δημαρχείο Καβάλας",
        "m149.text": "ΠΑΝΑΓΙΑ, ΚΑΒΑΛΑ",
        "m1410.text": "RSVP · 0532 904 33 18"
      },
      "en": {
        "m141.text": "YOU'RE INVITED\nTO OUR CIVIL CEREMONY",
        "m142.text": "Penny",
        "m144.text": "Oscar",
        "m145.text": "On this beautiful day\nwhen we join our lives,\nwe hope you will be our witnesses.",
        "m146.text": "October 8, 2027",
        "m147.bind": "{weekday} · {time}",
        "m147.text": "FRIDAY · 2:30 PM",
        "m148.text": "Emerald City Wedding Chapel",
        "m149.text": "CAPITOL HILL, SEATTLE",
        "m1410.text": "RSVP · 0532 904 33 18"
      },
      "es": {
        "m141.text": "TE INVITAMOS A\nNUESTRA CEREMONIA CIVIL",
        "m142.text": "Pilar",
        "m144.text": "Oliver",

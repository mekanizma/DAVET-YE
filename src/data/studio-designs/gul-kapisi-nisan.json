        "k1417.text": "تأكيد الحضور · 0542 503 17 64"
      },
      "de": {
        "k144.text": "Verlobungsfeier",
        "k145.text": "WIR LADEN SIE HERZLICH EIN",
        "k146.text": "Rosa",
        "k148.text": "Benedikt",
        "k149.text": "Am glücklichen Tag, an dem wir im Beisein unserer Familien unsere Ringe anstecken,\nmöchten wir Sie in unserer Mitte sehen.",

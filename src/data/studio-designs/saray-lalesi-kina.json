        "h104.text": "Beth",
        "h108.text": "DATE",
        "h109.text": "October 22, 2027",
        "h1010.text": "Friday · 8:00 PM",
        "h1011.text": "VENUE",
        "h1012.text": "Linden Pavilion",
        "h1013.text": "Manhattan, New York",
        "h1014.text": "On this night we adorn the loveliest of tulips with henna,\nwe'd love to have you with us.",
        "h1015.text": "RSVP · 0505 913 25 47"
      },
      "es": {
        "h102.text": "NOCHE DE HENNA",
        "h103.text": "NUESTRA HIJA",

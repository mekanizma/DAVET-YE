      "ar": {
        "h102.text": "ليلة الحناء",
        "h103.text": "ابنتنا",
        "h104.text": "بتول",
        "h108.text": "التاريخ",
        "h109.text": "22 أكتوبر 2027",
        "h1010.text": "الجمعة · 8:00 مساءً",
        "h1011.text": "المكان",
        "h1012.text": "قصر الزيزفون",
        "h1013.text": "حي الشاطئ، جدة",
        "h1014.text": "في هذه الليلة التي نزيّن فيها أجمل زهرات التوليب بالحناء،\nنتمنى أن نراكم بيننا.",
        "h1015.text": "تأكيد الحضور · 0505 913 25 47"

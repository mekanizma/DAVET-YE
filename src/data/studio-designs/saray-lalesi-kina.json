        "h102.text": "HENNA-ABEND",
        "h103.text": "UNSERE TOCHTER",
        "h104.text": "Bettina",
        "h108.text": "DATUM",
        "h109.bind": "{day}. {month} {year}",
        "h109.text": "22. Oktober 2027",
        "h1010.text": "Freitag · 20:00",
        "h1011.text": "ORT",
        "h1012.text": "Lindenpavillon",
        "h1013.text": "Charlottenburg, Berlin",
        "h1014.text": "An diesem Abend, an dem wir die schönste aller Tulpen mit Henna schmücken,\nmöchten wir Sie in unserer Mitte sehen.",
        "h1015.text": "RSVP · 0505 913 25 47"
      },
      "el": {
        "h102.text": "ΒΡΑΔΙΑ ΧΕΝΝΑΣ",

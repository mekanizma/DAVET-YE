        "h1011.text": "ΧΩΡΟΣ",
        "h1012.text": "Φλαμουριά",
        "h1013.text": "Μαρούσι, Αθήνα",
        "h1014.text": "Θα θέλαμε να σας δούμε ανάμεσά μας αυτή τη βραδιά\nπου θα στολίσουμε με χέννα την πιο όμορφη από τις τουλίπες.",
        "h1015.text": "RSVP · 0505 913 25 47"
      },
      "en": {
        "h102.text": "HENNA NIGHT",

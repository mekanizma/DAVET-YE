        "h1520.text": "Kadikoy, Istanbul",
        "h1521.text": "RSVP · 0505 274 61 38"
      },
      "it": {
        "h151.text": "PROMESSA E FIDANZAMENTO",
        "h152.text": "Ines",
        "h154.text": "Bruno",
        "h155.text": "Con il consenso e la benedizione delle nostre famiglie,\nin questo cammino che inizia con due bei giorni,\nvorremmo averti con noi.",
        "h158.text": "PROMESSA",
        "h159.text": "18 aprile 2027",

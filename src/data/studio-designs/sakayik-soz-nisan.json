    "translations": {
      "ar": {
        "h151.text": "الوعد والخطوبة",
        "h152.text": "سندس",
        "h154.text": "سالم",
        "h155.text": "برضا عائلتينا ودعائهم\nنسير في هذا الدرب، وفي يومين جميلين\nنتمنى أن نراكم بيننا.",
        "h158.text": "الوعد",
        "h159.text": "18 أبريل 2027",
        "h1510.text": "الأحد · 3:00 عصراً",
        "h1512.text": "بيت العروس",
        "h1513.text": "حي الصفوة، جدة",
        "h1515.text": "الخطوبة",
        "h1516.text": "22 مايو 2027",
        "h1517.text": "السبت · 19.00",
        "h1519.text": "قاعة الياقوت للمناسبات",
        "h1520.text": "حي الحمراء، جدة",
        "h1521.text": "تأكيد الحضور · 0505 274 61 38"
      },
      "de": {
        "h151.text": "VERSPRECHEN & VERLOBUNG",
        "h152.text": "Ida",
        "h154.text": "Bastian",
        "h155.text": "Auf dem Weg, den wir mit dem Einverständnis und den Gebeten unserer Familien\nbeschreiten, möchten wir Sie an diesen zwei schönen\nTagen in unserer Mitte sehen.",
        "h158.text": "VERSPRECHEN",
        "h159.bind": "{day}. {month} {year}",
        "h159.text": "18. April 2027",
        "h1510.text": "Sonntag · 15:00",
        "h1512.text": "Haus der Braut",
        "h1513.text": "Dahlem, Berlin",
        "h1515.text": "VERLOBUNG",
        "h1516.text": "22. Mai 2027",
        "h1517.text": "Samstag · 19:00",
        "h1519.text": "Kalamis Park Event",
        "h1520.text": "Kadikoy, Istanbul",
        "h1521.text": "RSVP · 0505 274 61 38"
      },
      "el": {
        "h151.text": "ΥΠΟΣΧΕΣΗ ΚΑΙ ΑΡΡΑΒΩΝΑΣ",
        "h152.text": "Ιόλη",
        "h154.text": "Βλάσης",
        "h155.text": "Θα θέλαμε να σας δούμε ανάμεσά μας\nστις δύο όμορφες μέρες αυτού του δρόμου\nπου διαλέξαμε με τη συγκατάθεση και τις ευχές των οικογενειών μας.",
        "h158.text": "ΥΠΟΣΧΕΣΗ",
        "h159.text": "18 Απριλίου 2027",
        "h1510.text": "Κυριακή · 15:00",
        "h1512.text": "Σπίτι της νύφης",
        "h1513.text": "Άλιμος, Αθήνα",
        "h1515.text": "ΑΡΡΑΒΩΝΑΣ",
        "h1516.text": "22 Μαΐου 2027",
        "h1517.text": "Σάββατο · 19:00",
        "h1519.text": "Αίθουσα Άλσος",
        "h1520.text": "Γλυφάδα, Αθήνα",
        "h1521.text": "RSVP · 0505 274 61 38"
      },
      "en": {
        "h151.text": "PROMISE & ENGAGEMENT",
        "h152.text": "Ivy",
        "h154.text": "Ben",
        "h155.text": "On the path we've begun with our\nfamilies' consent and prayers, we'd love\nto have you with us on two beautiful days.",
        "h158.text": "PROMISE",
        "h159.text": "April 18, 2027",
        "h1510.text": "Sunday · 3:00 PM",
        "h1512.text": "Bride's house",
        "h1513.text": "Forest Hills, New York",
        "h1515.text": "ENGAGEMENT",
        "h1516.text": "May 22, 2027",
        "h1517.text": "Saturday · 7:00 PM",
        "h1519.text": "Marina Park Reception",
        "h1520.text": "Brooklyn, New York",
        "h1521.text": "RSVP · 0505 274 61 38"
      },
      "es": {
        "h151.text": "PROMESA Y COMPROMISO",
        "h152.text": "Iris",
        "h154.text": "Rodrigo",
        "h155.text": "Con el consentimiento y las oraciones de nuestras familias,\nen estos dos hermosos días de un nuevo camino,\nqueremos contar contigo.",
        "h158.text": "PROMESA",
        "h159.bind": "{day} de {month} de {year}",
        "h159.text": "18 de abril de 2027",
        "h1510.text": "Domingo · 15:00",
        "h1512.text": "Casa de la novia",
        "h1513.text": "Horta, Barcelona",
        "h1515.text": "COMPROMISO",
        "h1516.text": "22 de mayo de 2027",
        "h1517.text": "Sábado · 19:00",
        "h1519.text": "Kalamis Park Eventos",
        "h1520.text": "Kadiköy, Istanbul",
        "h1521.text": "RSVP · 0505 274 61 38"
      },
      "fr": {
        "h151.text": "PROMESSE ET FIANÇAILLES",
        "h152.text": "Ève",
        "h154.text": "Rémi",
        "h155.text": "Avec le consentement et les prières de nos familles,\nnous nous engageons sur ce chemin ; durant deux beaux jours,\nnous aimerions vous compter parmi nous.",
        "h158.text": "PROMESSE",
        "h159.text": "18 avril 2027",

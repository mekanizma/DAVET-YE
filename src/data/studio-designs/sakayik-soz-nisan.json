      "ru": {
        "h151.text": "СГОВОР И ПОМОЛВКА",
        "h152.text": "Ева",
        "h154.text": "Богдан",
        "h155.text": "С согласия и молитвами наших семей\nмы вступаем на этот путь; в два прекрасных дня\nмы хотим видеть вас среди нас.",
        "h158.text": "СГОВОР",
